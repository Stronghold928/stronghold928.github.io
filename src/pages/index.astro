---
import Layout from '../layouts/Layout.astro';
import BlueprintCanvas from '../components/BlueprintCanvas.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featured = allProjects
  .filter(p => p.data.featured)
  .sort((a, b) => b.data.completedDate.localeCompare(a.data.completedDate))
  .slice(0, 3);

const typeLabels: Record<string, string> = {
  remodeling: 'Remodeling',
  restoration: 'Restoration',
  'new-build': 'New Build',
  repair: 'Repair',
};
---

<Layout title="Home" description="Stronghold — General contractor in Flagstaff, AZ. Remodeling, restoration, new builds, and repairs across northern Arizona.">
  <section class="hero">
    <BlueprintCanvas />
    <div class="hero-inner">
      <p class="hero-eyebrow">Northern Arizona &bull; Flagstaff, AZ</p>
      <h1 class="hero-headline">
        Built with<br />
        <span class="hero-accent">integrity.</span><br />
        Finished with care.
      </h1>
      <p class="hero-sub">
        Based in Flagstaff, we handle remodeling, restoration, new builds, and repairs for families all across northern Arizona.
      </p>
      <div class="hero-actions">
        <a href="/quote" class="btn-primary">Get a Quote</a>
        <a href="/projects" class="btn-secondary">See Our Work</a>
      </div>
    </div>
  </section>

  <section class="services-strip">
    <div class="services-inner">
      {[
        { title: 'Remodeling', desc: 'A good remodel changes how your whole family lives. We make the process clear and the result worth it.', href: '/services#remodeling' },
        { title: 'Restoration', desc: "Northern Arizona's older homes have real character. We help preserve it while fixing what needs fixing.", href: '/services#restoration' },
        { title: 'New Construction', desc: 'Building something new? We take it from foundation to front door, with no surprises along the way.', href: '/services#new-builds' },
        { title: 'Repairs', desc: 'When something is broken, we figure out why and fix it right the first time.', href: '/services#repairs' },
      ].map(s => (
        <a href={s.href} class="service-tile">
          <h3 class="service-title">{s.title}</h3>
          <p class="service-desc">{s.desc}</p>
          <span class="service-arrow">&rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <section class="values-section">
    <div class="values-inner">
      <div class="values-text">
        <p class="section-eyebrow">Our Approach</p>
        <h2>Think of us as the friend who happens to know construction.</h2>
        <p>
          You get straight answers, real numbers, and a crew that shows up. If a project isn't worth doing, we'll say so. If another contractor's approach makes more sense for your situation, we'll say that too.
        </p>
        <p>
          And you'll always know where things stand.
        </p>
        <a href="/about" class="btn-outline-dark">Our Story &rarr;</a>
      </div>
      <div class="values-pillars">
        {[
          { word: 'Integrity', sub: "Scope changes get communicated before they show up on an invoice. That's the minimum we hold ourselves to." },
          { word: 'Honesty', sub: "You get our real read, not the one optimized to win the job." },
          { word: 'Community', sub: "We live and work here. The homes we build are in neighborhoods we drive through every day." },
        ].map(v => (
          <div class="pillar">
            <h3 class="pillar-word">{v.word}</h3>
            <p class="pillar-sub">{v.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="design-callout">
    <div class="design-callout-inner">
      <div class="design-callout-label">Free Tool</div>
      <h2>Haven't figured out the look yet?</h2>
      <p>
        Most people haven't. Answer five questions about how you want your home to feel and we'll put together a style profile that gives every design conversation a real starting point.
      </p>
      <a href="/design" class="btn-dark">Find Your Design Style &rarr;</a>
    </div>
  </section>

  <section class="projects-teaser">
    <div class="projects-teaser-inner">
      <div class="projects-teaser-header">
        <div>
          <p class="section-eyebrow">Our Work</p>
          <h2>Projects built to last.</h2>
        </div>
        <a href="/projects" class="btn-outline-dark">View All Projects &rarr;</a>
      </div>
      <div class="projects-grid">
        {featured.map(project => (
          <a href={`/projects/${project.id}`} class="project-card">
            <div class="project-img-wrap">
              <img src={project.data.afterImage} alt={project.data.title} loading="lazy" />
            </div>
            <div class="project-card-body">
              <p class="project-type">{typeLabels[project.data.type]}</p>
              <h3 class="project-title">{project.data.title}</h3>
              <p class="project-location">{project.data.location}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 82vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5rem 2.5rem;
    border-bottom: 2px solid var(--color-border);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    background: #ffffff;
    border: 2px solid var(--color-border);
    box-shadow: 8px 8px 0 rgba(0, 0, 0, 0.06);
    padding: 3rem 3.5rem 3.5rem;
    max-width: 660px;
  }

  .hero-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 1.5rem;
  }

  .hero-headline {
    font-size: var(--font-size-display);
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.0;
    margin-bottom: 1.5rem;
    max-width: 700px;
    color: var(--color-text);
  }

  .hero-accent {
    color: var(--color-brand-red);
    display: inline-block;
    border-bottom: 4px solid var(--color-brand-red);
  }

  .hero-sub {
    font-size: 1.125rem;
    color: var(--color-text);
    opacity: 0.65;
    max-width: 500px;
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ---- Buttons ---- */
  .btn-primary {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: var(--color-brand-red);
    color: #fff;
    border: 2px solid var(--color-brand-red);
    box-shadow: 4px 4px 0 var(--color-brand-black);
    transition: box-shadow 0.1s, transform 0.1s;
  }
  .btn-primary:hover {
    box-shadow: 2px 2px 0 var(--color-brand-black);
    transform: translate(2px, 2px);
  }

  .btn-secondary {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: transparent;
    color: var(--color-text);
    border: 2px solid var(--color-text);
    box-shadow: 4px 4px 0 var(--color-border);
    transition: box-shadow 0.1s, transform 0.1s;
  }
  .btn-secondary:hover {
    box-shadow: 2px 2px 0 var(--color-border);
    transform: translate(2px, 2px);
  }

  .btn-outline-dark {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.75rem 1.5rem;
    background-color: transparent;
    color: var(--color-text);
    border: 2px solid var(--color-text);
    transition: background-color 0.15s, color 0.15s;
  }
  .btn-outline-dark:hover {
    background-color: var(--color-text);
    color: #fff;
  }

  .btn-dark {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: var(--color-dark);
    color: #fff;
    border: 2px solid var(--color-dark);
    box-shadow: 4px 4px 0 rgba(255,255,255,0.5);
    transition: box-shadow 0.1s, transform 0.1s;
  }
  .btn-dark:hover {
    box-shadow: 2px 2px 0 rgba(255,255,255,0.5);
    transform: translate(2px, 2px);
  }

  /* ---- Services strip ---- */
  .services-strip {
    background-color: var(--color-surface);
    border-bottom: 2px solid var(--color-border);
  }

  .services-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .service-tile {
    padding: 2.5rem 2rem;
    border-right: 2px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: background-color 0.15s;
    color: var(--color-text);
  }
  .service-tile:last-child { border-right: none; }
  .service-tile:hover { background-color: var(--color-surface-2); }
  .service-tile:hover .service-arrow {
    color: var(--color-brand-red);
    transform: translateX(4px);
  }

  .service-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    border-bottom: 2px solid var(--color-brand-red);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .service-desc {
    font-size: 0.875rem;
    opacity: 0.65;
    line-height: 1.5;
    flex: 1;
  }

  .service-arrow {
    font-size: 1.25rem;
    color: var(--color-text);
    opacity: 0.5;
    transition: color 0.15s, transform 0.15s, opacity 0.15s;
    align-self: flex-start;
  }

  /* ---- Values ---- */
  .values-section { padding: 6rem 1.5rem; }

  .values-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .section-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 1rem;
  }

  .values-text h2 {
    font-size: var(--font-size-h2);
    margin-bottom: 1.5rem;
    color: var(--color-text);
  }

  .values-text p {
    color: var(--color-text);
    opacity: 0.7;
    margin-bottom: 1rem;
    font-size: 1rem;
    line-height: 1.7;
  }

  .values-text .btn-outline-dark { margin-top: 1rem; }

  .values-pillars {
    display: flex;
    flex-direction: column;
  }

  .pillar {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .pillar:first-child { border-top: 1px solid var(--color-border); }

  .pillar-word {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .pillar-sub {
    font-size: 0.9rem;
    color: var(--color-text);
    opacity: 0.55;
  }

  /* ---- Design callout ---- */
  .design-callout {
    background-color: var(--color-brand-red);
    border-top: 3px solid var(--color-brand-black);
    border-bottom: 3px solid var(--color-brand-black);
  }

  .design-callout-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
  }

  .design-callout-label {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    margin-bottom: 1rem;
  }

  .design-callout h2 {
    font-size: var(--font-size-h1);
    margin-bottom: 1.25rem;
    max-width: 600px;
    color: #fff;
  }

  .design-callout p {
    color: rgba(255,255,255,0.85);
    max-width: 480px;
    margin-bottom: 2rem;
    font-size: 1rem;
    line-height: 1.6;
  }

  /* ---- Projects teaser ---- */
  .projects-teaser { padding: 6rem 1.5rem; }

  .projects-teaser-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .projects-teaser-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .projects-teaser-header h2 {
    font-size: var(--font-size-h2);
    color: var(--color-text);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    border: 2px solid var(--color-border);
  }

  .project-card {
    background-color: var(--color-surface);
    border: 2px solid var(--color-border);
    overflow: hidden;
    transition: border-color 0.15s, box-shadow 0.15s;
    text-decoration: none;
    color: var(--color-text);
    display: block;
  }

  .project-card:hover {
    border-color: var(--color-brand-red);
    box-shadow: 4px 4px 0 var(--color-brand-red);
  }

  .project-img-wrap {
    aspect-ratio: 4/3;
    overflow: hidden;
  }
  .project-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .project-card:hover .project-img-wrap img { transform: scale(1.05); }

  .project-card-body { padding: 1.25rem; }

  .project-type {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 0.5rem;
  }

  .project-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
    color: var(--color-text);
  }

  .project-location {
    font-size: 0.8rem;
    color: var(--color-text);
    opacity: 0.45;
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .services-inner { grid-template-columns: repeat(2, 1fr); }
    .service-tile:nth-child(2) { border-right: none; }
    .service-tile:nth-child(1),
    .service-tile:nth-child(2) { border-bottom: 2px solid var(--color-border); }
    .values-inner { grid-template-columns: 1fr; gap: 3rem; }
    .projects-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 600px) {
    .hero { min-height: 80vh; padding: 4rem 1.5rem 3rem; }
    .services-inner { grid-template-columns: 1fr; }
    .service-tile { border-right: none; border-bottom: 2px solid var(--color-border); }
    .service-tile:last-child { border-bottom: none; }
    .projects-teaser-header { flex-direction: column; align-items: flex-start; }
    .projects-grid { grid-template-columns: 1fr; }
  }
</style>
