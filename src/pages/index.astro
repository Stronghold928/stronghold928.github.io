---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" description="Stronghold928 — General contractor in Flagstaff, AZ. Remodeling, restoration, new builds, and repairs across northern Arizona.">
  <section class="hero">
    <div class="hero-inner">
      <p class="hero-eyebrow">Northern Arizona &bull; Flagstaff, AZ</p>
      <h1 class="hero-headline">
        Built with<br />
        <span class="hero-accent">integrity.</span><br />
        Finished with care.
      </h1>
      <p class="hero-sub">
        Stronghold928 is your trusted general contractor for remodeling, restoration, new construction, and repair work across northern Arizona.
      </p>
      <div class="hero-actions">
        <a href="/contact" class="btn-primary">Get a Quote</a>
        <a href="/projects" class="btn-secondary">See Our Work</a>
      </div>
    </div>
    <div class="hero-badge">
      <span>Flagstaff</span>
      <span class="badge-divider">&bull;</span>
      <span>Northern AZ</span>
    </div>
  </section>

  <section class="services-strip">
    <div class="services-inner">
      {[
        { icon: '⬛', title: 'Remodeling', desc: 'Transform your space with our guided design process and expert execution.', href: '/services#remodeling' },
        { icon: '⬛', title: 'Restoration', desc: 'Bring older homes back to life while preserving their character and soul.', href: '/services#restoration' },
        { icon: '⬛', title: 'New Construction', desc: 'Single-family and multi-family builds from foundation to finish.', href: '/services#new-builds' },
        { icon: '⬛', title: 'Repairs', desc: 'Fast, honest repairs that fix the problem — not just the symptom.', href: '/services#repairs' },
      ].map(s => (
        <a href={s.href} class="service-tile">
          <h3 class="service-title">{s.title}</h3>
          <p class="service-desc">{s.desc}</p>
          <span class="service-arrow">&rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <section class="values-section">
    <div class="values-inner">
      <div class="values-text">
        <p class="section-eyebrow">Our Approach</p>
        <h2>A knowledgeable friend<br />in the trades.</h2>
        <p>
          We don't just build and remodel — we guide you through every decision with the honesty and candor you'd expect from a trusted friend who happens to know construction inside and out.
        </p>
        <p>
          From first consultation to final walkthrough, you'll always know what's happening, why it matters, and what it costs.
        </p>
        <a href="/about" class="btn-outline">Our Story &rarr;</a>
      </div>
      <div class="values-pillars">
        {[
          { word: 'Integrity', sub: 'We do what we say, and say what we do.' },
          { word: 'Honesty', sub: 'Straight talk on scope, cost, and timeline.' },
          { word: 'Community', sub: "Invested in northern Arizona's future." },
        ].map(v => (
          <div class="pillar">
            <h3 class="pillar-word">{v.word}</h3>
            <p class="pillar-sub">{v.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="design-callout">
    <div class="design-callout-inner">
      <div class="design-callout-label">Featured Tool</div>
      <h2>Don't know your style yet?<br />We'll help you find it.</h2>
      <p>
        Our guided design selector walks you through a series of questions about your lifestyle, preferences, and goals — and delivers a style profile to kickstart your remodel.
      </p>
      <a href="/style-selector" class="btn-primary">Start the Design Guide &rarr;</a>
    </div>
  </section>

  <section class="projects-teaser">
    <div class="projects-teaser-inner">
      <div class="projects-teaser-header">
        <p class="section-eyebrow">Our Work</p>
        <h2>Projects built to last.</h2>
        <a href="/projects" class="btn-outline">View All Projects &rarr;</a>
      </div>
      <div class="projects-grid">
        {[1,2,3].map(i => (
          <div class="project-card">
            <div class="project-img-placeholder">
              <span>Project Photo</span>
            </div>
            <div class="project-card-body">
              <p class="project-type">Remodeling</p>
              <h3 class="project-title">Project Name {i}</h3>
              <p class="project-location">Flagstaff, AZ</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6rem 1.5rem 4rem;
    border-bottom: 3px solid var(--color-brand-gray);
    overflow: hidden;
  }

  .hero::before {
    content: '928';
    position: absolute;
    right: -1rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-heading);
    font-size: clamp(10rem, 25vw, 22rem);
    font-weight: 700;
    color: var(--color-brand-gray);
    line-height: 1;
    pointer-events: none;
    user-select: none;
    letter-spacing: -0.05em;
  }

  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .hero-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 1.5rem;
  }

  .hero-headline {
    font-size: var(--font-size-display);
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.0;
    margin-bottom: 1.5rem;
    max-width: 700px;
  }

  .hero-accent {
    color: var(--color-brand-red);
    display: inline-block;
    border-bottom: 4px solid var(--color-brand-red);
  }

  .hero-sub {
    font-size: 1.125rem;
    opacity: 0.75;
    max-width: 520px;
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-badge {
    position: absolute;
    bottom: 2rem;
    right: 1.5rem;
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.4;
    display: flex;
    gap: 0.5rem;
  }

  .badge-divider { color: var(--color-brand-red); }

  /* Buttons */
  .btn-primary {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: var(--color-brand-red);
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-red);
    box-shadow: 4px 4px 0 var(--color-brand-white);
    transition: box-shadow 0.1s, transform 0.1s;
  }

  .btn-primary:hover {
    box-shadow: 2px 2px 0 var(--color-brand-white);
    transform: translate(2px, 2px);
  }

  .btn-secondary {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: transparent;
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-white);
    box-shadow: 4px 4px 0 var(--color-brand-gray);
    transition: box-shadow 0.1s, transform 0.1s;
  }

  .btn-secondary:hover {
    box-shadow: 2px 2px 0 var(--color-brand-gray);
    transform: translate(2px, 2px);
  }

  .btn-outline {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.75rem 1.5rem;
    background-color: transparent;
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-white);
    transition: background-color 0.15s, color 0.15s;
  }

  .btn-outline:hover {
    background-color: var(--color-brand-white);
    color: var(--color-brand-black);
  }

  /* Services strip */
  .services-strip {
    background-color: var(--color-brand-gray);
    border-bottom: 2px solid var(--color-brand-black);
  }

  .services-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .service-tile {
    padding: 2.5rem 2rem;
    border-right: 2px solid var(--color-brand-black);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: background-color 0.15s;
  }

  .service-tile:last-child {
    border-right: none;
  }

  .service-tile:hover {
    background-color: var(--color-brand-black);
  }

  .service-tile:hover .service-arrow {
    color: var(--color-brand-red);
    transform: translateX(4px);
  }

  .service-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-brand-white);
    border-bottom: 2px solid var(--color-brand-red);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .service-desc {
    font-size: 0.875rem;
    opacity: 0.7;
    line-height: 1.5;
    flex: 1;
  }

  .service-arrow {
    font-size: 1.25rem;
    color: var(--color-brand-white);
    transition: color 0.15s, transform 0.15s;
    align-self: flex-start;
  }

  /* Values */
  .values-section {
    padding: 6rem 1.5rem;
  }

  .values-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .section-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 1rem;
  }

  .values-text h2 {
    font-size: var(--font-size-h2);
    margin-bottom: 1.5rem;
  }

  .values-text p {
    opacity: 0.75;
    margin-bottom: 1rem;
    font-size: 1rem;
    line-height: 1.7;
  }

  .values-text .btn-outline {
    margin-top: 1rem;
  }

  .values-pillars {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .pillar {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-brand-gray);
  }

  .pillar:first-child {
    border-top: 1px solid var(--color-brand-gray);
  }

  .pillar-word {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-brand-white);
    margin-bottom: 0.25rem;
  }

  .pillar-sub {
    font-size: 0.9rem;
    opacity: 0.6;
  }

  /* Design callout */
  .design-callout {
    background-color: var(--color-brand-red);
    border-top: 3px solid var(--color-brand-black);
    border-bottom: 3px solid var(--color-brand-black);
  }

  .design-callout-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
  }

  .design-callout-label {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.6);
    margin-bottom: 1rem;
  }

  .design-callout h2 {
    font-size: var(--font-size-h1);
    margin-bottom: 1.25rem;
    max-width: 600px;
  }

  .design-callout p {
    opacity: 0.8;
    max-width: 480px;
    margin-bottom: 2rem;
    font-size: 1rem;
    line-height: 1.6;
  }

  .design-callout .btn-primary {
    background-color: var(--color-brand-black);
    border-color: var(--color-brand-black);
    box-shadow: 4px 4px 0 var(--color-brand-white);
  }

  .design-callout .btn-primary:hover {
    box-shadow: 2px 2px 0 var(--color-brand-white);
  }

  /* Projects teaser */
  .projects-teaser {
    padding: 6rem 1.5rem;
  }

  .projects-teaser-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .projects-teaser-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .projects-teaser-header h2 {
    font-size: var(--font-size-h2);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5px;
    border: 1.5px solid var(--color-brand-gray);
  }

  .project-card {
    background-color: var(--color-brand-gray);
    border: 1.5px solid var(--color-brand-gray);
    overflow: hidden;
    transition: border-color 0.15s;
  }

  .project-card:hover {
    border-color: var(--color-brand-red);
  }

  .project-img-placeholder {
    aspect-ratio: 4/3;
    background-color: var(--color-brand-gray-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    opacity: 0.3;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-card-body {
    padding: 1.25rem;
  }

  .project-type {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 0.5rem;
  }

  .project-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .project-location {
    font-size: 0.8rem;
    opacity: 0.5;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .services-inner {
      grid-template-columns: repeat(2, 1fr);
    }

    .service-tile:nth-child(2) {
      border-right: none;
    }

    .service-tile:nth-child(1),
    .service-tile:nth-child(2) {
      border-bottom: 2px solid var(--color-brand-black);
    }

    .values-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .hero { min-height: 80vh; padding: 4rem 1.5rem 3rem; }
    .hero::before { display: none; }

    .services-inner {
      grid-template-columns: 1fr;
    }

    .service-tile { border-right: none; border-bottom: 2px solid var(--color-brand-black); }
    .service-tile:last-child { border-bottom: none; }

    .projects-teaser-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
