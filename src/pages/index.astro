---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import heroPhoto from '../assets/hero/mountain-modern-home.webp';
import { allProfiles } from '../data/social';
import { socialIcons, evenOddIcons } from '../data/social-icons';
import { services, landingPages } from '../data/services';
import { serviceAreas } from '../data/service-areas';

const allProjects = await getCollection('projects');
const featured = allProjects
  .filter(p => p.data.featured)
  .sort((a, b) => b.data.completedDate.localeCompare(a.data.completedDate))
  .slice(0, 3);

const typeLabels: Record<string, string> = {
  remodeling: 'Remodeling',
  restoration: 'Restoration',
  'new-build': 'New Build',
  repair: 'Repair',
};
---

<Layout
  title="General Contractor in Flagstaff AZ | Stronghold Construction"
  bareTitle
  description="Licensed general contractor in Flagstaff, AZ. Remodeling, restoration, new builds, and handyman work across northern Arizona. Itemized quotes, permits handled."
>
  <section class="hero">
    <div class="hero-panel">
      <div>
        <!-- The brand stays inside the H1 (see c80719a); the tagline carries it,
             with the license, so the visible headline can stay short. -->
        <h1 class="hero-headline">
          <span class="hero-eyebrow">Stronghold&nbsp;Construction &middot; Flagstaff&nbsp;General&nbsp;Contractor &middot; AZ&nbsp;ROC&nbsp;354046 &middot; Licensed,&nbsp;Bonded,&nbsp;Insured</span>
          One call.<br /><span class="hero-box">Built</span> right.
        </h1>
        <p class="hero-sub">
          Remodels, repairs and new builds from a Flagstaff crew that answers the phone. Itemized quotes, permits handled.
        </p>
        <div class="hero-ctas">
          <a href="/quote/" class="hero-cta hero-cta--quote">
            <span class="hero-cta-label">Free &middot; itemized</span>
            <span class="hero-cta-main">Get a quote &rarr;</span>
          </a>
          <a href="tel:+19289627535" class="hero-cta hero-cta--dark">
            <span class="hero-cta-label">Call or text &middot; Mon&ndash;Fri 9&ndash;4</span>
            <span class="hero-cta-main">(928) 962-7535</span>
          </a>
        </div>
      </div>
    </div>
    <div class="hero-photo">
      <Image
        src={heroPhoto}
        alt="Modern mountain home with a steep metal roof, stone and timber siding, and tall black-framed windows"
        widths={[800, 1200, 1600]}
        sizes="(max-width: 900px) 100vw, 50vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <!-- Off-site profiles as visible proof right under the hero. Same links and
       rel="me" as the footer icons; see src/data/social.ts. -->
  <section class="profiles-strip" aria-label="Stronghold Construction reviews and profiles">
    <div class="profiles-strip-inner">
      <p class="profiles-lead">Reviewed &amp;<br /><span>found on</span></p>
      {allProfiles.map(p => (
        <a href={p.href} class="profile-tile" target="_blank" rel="noopener noreferrer me">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path d={socialIcons[p.label]} fill="currentColor" fill-rule={evenOddIcons.has(p.label) ? 'evenodd' : undefined} />
          </svg>
          {p.label.replace(' Reviews', '')}
        </a>
      ))}
    </div>
  </section>

  <section class="services-strip">
    <div class="services-inner">
      <h2 class="services-strip-title">General contracting services in Flagstaff and northern Arizona</h2>
      <div class="services-tiles">
        {[
          { title: 'Remodeling', slug: 'remodeling', desc: 'A good remodel changes how your whole family lives. We make the process clear and the result worth it.' },
          { title: 'Restoration', slug: 'restoration', desc: "Northern Arizona's older homes have real character. We help preserve it while fixing what needs fixing." },
          { title: 'New Construction', slug: 'new-construction', desc: 'Building something new? We take it from foundation to front door, with no surprises along the way.' },
          { title: 'Handyman', slug: 'handyman', desc: 'From a sticking door to a shelf that needs hanging, we handle the small jobs right the first time.' },
        ].map(s => (
          <a href={`/services/${s.slug}/`} class="service-tile">
            <h3 class="service-title">{s.title}</h3>
            <p class="service-desc">{s.desc}</p>
            <span class="service-arrow">&rarr;</span>
          </a>
        ))}
      </div>
      <div class="services-strip-popular">
        <span class="popular-lead">Most requested:</span>
        {landingPages.map(l => (
          <a href={`/services/${l.slug}/`} class="popular-pill">{l.label}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="values-section">
    <div class="values-inner">
      <div class="values-text">
        <p class="section-eyebrow">Our Approach</p>
        <h2>Think of us as the friend who happens to know construction.</h2>
        <p>
          You get straight answers, real numbers, and a crew that shows up. If a project isn't worth doing, we'll say so. If another contractor's approach makes more sense for your situation, we'll say that too.
        </p>
        <p>
          And you'll always know where things stand.
        </p>
        <a href="/about/" class="btn-outline-dark">Our Story &rarr;</a>
      </div>
      <div class="values-pillars">
        {[
          { word: 'Integrity', sub: "Scope changes get communicated before they show up on an invoice. That's the minimum we hold ourselves to." },
          { word: 'Honesty', sub: "You get our real read, not the one optimized to win the job." },
          { word: 'Community', sub: "We live and work here. The homes we build are in neighborhoods we drive through every day." },
        ].map(v => (
          <div class="pillar">
            <h3 class="pillar-word">{v.word}</h3>
            <p class="pillar-sub">{v.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="design-callout">
    <div class="design-callout-inner">
      <div class="design-callout-label">Free Tool</div>
      <h2>Haven't figured out the look yet?</h2>
      <p>
        Most people haven't. Answer seven questions and get back a real design plan: a named style, a proven palette, and the exact materials that make it work, ready for your first project conversation.
      </p>
      <a href="/design/" class="btn-dark">Get Your Design Plan &rarr;</a>
    </div>
  </section>

  <section class="commercial-band">
    <div class="commercial-band-inner">
      <div class="commercial-band-text">
        <p class="commercial-band-label">Commercial</p>
        <h2>We build for businesses too.</h2>
        <p class="commercial-band-sub">
          Tenant improvement, renovation, and design-build for offices and retail across northern Arizona. Licensed KB-1 Dual, which means commercial work at any size. No minimum job, and we work nights and weekends so you do not have to close.
        </p>
      </div>
      <div class="commercial-band-actions">
        <a href="/commercial/" class="btn-commercial">Commercial Services &rarr;</a>
        <a href="/commercial/bid-request/" class="btn-commercial-outline">Request a Bid</a>
      </div>
    </div>
  </section>

  <section class="areas-teaser">
    <div class="areas-teaser-inner">
      <p class="section-eyebrow">Where We Work</p>
      <h2>Flagstaff is home base. We cover the rest of northern Arizona.</h2>
      <ul class="areas-list">
        {serviceAreas.map(a => (
          <li>
            <a href={`/service-areas/${a.slug}/`}>
              <span class="areas-city">{a.cityName}, {a.stateAbbr}</span>
              <span class="areas-county">{a.county} Co.</span>
            </a>
          </li>
        ))}
      </ul>
      <a href="/service-areas/" class="btn-outline-dark">All Service Areas &rarr;</a>
    </div>
  </section>

  <section class="projects-teaser">
    <div class="projects-teaser-inner">
      <div class="projects-teaser-header">
        <div>
          <p class="section-eyebrow">Our Work</p>
          <h2>Projects built to last.</h2>
        </div>
        <a href="/projects/" class="btn-outline-dark">View All Projects &rarr;</a>
      </div>
      <div class="projects-grid">
        {featured.map(project => (
          <a href={`/projects/${project.id}/`} class="project-card">
            <div class="project-img-wrap">
              <Image
                src={project.data.afterImage}
                alt={project.data.title}
                widths={[400, 800, 1200]}
                sizes="(max-width: 700px) 100vw, 400px"
                loading="lazy"
              />
            </div>
            <div class="project-card-body">
              <p class="project-type">{typeLabels[project.data.type]}</p>
              <h3 class="project-title">{project.data.title}</h3>
              <p class="project-location">{project.data.location}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---- Hero ----
     Limestone panel with the pitch on the left, a full-bleed photo on the
     right. The sand picks up the stone in the photo; red is kept for the
     BUILT box and the quote button, so it marks what to act on. Both CTAs use
     the same type: a small mono label over a condensed figure, with the
     angled corner from the panel repeated on each. */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 560px;
    background: var(--color-dark);
    border-bottom: 3px solid var(--color-brand-red);
  }

  .hero-panel {
    background: var(--color-sand);
    color: var(--color-text);
    padding: 2.5rem 3rem 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 28px), calc(100% - 28px) 100%, 0 100%);
  }

  .hero-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
    /* Darker than brand red: 6.6:1 on sand at this small size. */
    color: #9E1B14;
    margin-bottom: 1rem;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 5.25rem;
    line-height: 1.12;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .hero-box {
    display: inline-block;
    line-height: 1;
    color: var(--color-brand-white);
    background: var(--color-brand-red);
    padding: 0.04em 0.15em 0;
  }

  .hero-sub {
    font-size: 1.05rem;
    line-height: 1.55;
    max-width: 44ch;
    opacity: 0.8;
    margin-bottom: 1.75rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-cta {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 230px;
    padding: 0.85rem 1.2rem 0.95rem;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%);
    transition: transform 0.1s;
  }
  .hero-cta:hover {
    transform: translateY(-2px);
  }

  .hero-cta-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.65;
    white-space: nowrap;
  }

  .hero-cta-main {
    font-family: var(--font-display);
    font-size: 1.85rem;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .hero-cta--quote {
    background: var(--color-brand-red);
    color: var(--color-brand-white);
  }
  .hero-cta--quote .hero-cta-label {
    opacity: 0.85;
  }
  .hero-cta--dark {
    background: var(--color-brand-black);
    color: var(--color-brand-white);
  }
  .hero-cta--dark .hero-cta-main {
    color: #FF3B30;
  }

  .hero-photo {
    position: relative;
    overflow: hidden;
  }
  .hero-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 50%;
  }

  /* ---- Profiles strip ---- */
  .profiles-strip {
    background: var(--color-dark);
    padding: 2.5rem 1.5rem;
  }
  .profiles-strip-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .profiles-lead {
    background: var(--color-brand-gray);
    color: var(--color-brand-black);
    padding: 0.9rem 1.1rem;
    min-width: 150px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .profiles-lead span {
    color: var(--color-brand-red);
  }
  .profile-tile {
    flex: 1 1 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem;
    background: var(--color-dark-surface);
    color: var(--color-brand-white);
    opacity: 0.8;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    transition: opacity 0.15s, color 0.15s;
  }
  .profile-tile:hover,
  .profile-tile:focus-visible {
    opacity: 1;
    color: var(--color-brand-red);
  }

  @media (max-width: 1100px) {
    .hero-headline { font-size: 4.25rem; }
  }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; }
    .hero-panel { padding: 2rem 1.25rem 2.5rem; }
    .hero-headline { font-size: 3.6rem; }
    .hero-cta { flex: 1 1 100%; min-width: 0; }
    .hero-photo { height: 320px; }
    .profiles-lead { flex: 1 1 100%; }
  }

  .btn-outline-dark {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.75rem 1.5rem;
    background-color: transparent;
    color: var(--color-text);
    border: 2px solid var(--color-text);
    transition: background-color 0.15s, color 0.15s;
  }
  .btn-outline-dark:hover {
    background-color: var(--color-text);
    color: #fff;
  }

  .btn-dark {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: var(--color-dark);
    color: #fff;
    border: 2px solid var(--color-dark);
    box-shadow: 4px 4px 0 rgba(255,255,255,0.5);
    transition: box-shadow 0.1s, transform 0.1s;
  }
  .btn-dark:hover {
    box-shadow: 2px 2px 0 rgba(255,255,255,0.5);
    transform: translate(2px, 2px);
  }

  /* ---- Services strip ---- */
  .services-strip {
    background-color: var(--color-surface);
    border-bottom: 2px solid var(--color-border);
  }

  .services-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 0;
  }

  .services-tiles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 2px solid var(--color-border);
    border-bottom: 2px solid var(--color-border);
  }

  .service-tile {
    padding: 2.5rem 2rem;
    border-right: 2px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: background-color 0.15s;
    color: var(--color-text);
  }
  .service-tile:last-child { border-right: none; }
  .service-tile:hover { background-color: var(--color-surface-2); }
  .service-tile:hover .service-arrow {
    color: var(--color-brand-red);
    transform: translateX(4px);
  }

  .service-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    border-bottom: 2px solid var(--color-brand-red);
    padding-bottom: 0.5rem;
    display: inline-block;
  }

  .service-desc {
    font-size: 0.875rem;
    opacity: 0.65;
    line-height: 1.5;
    flex: 1;
  }

  .service-arrow {
    font-size: 1.25rem;
    color: var(--color-text);
    opacity: 0.5;
    transition: color 0.15s, transform 0.15s, opacity 0.15s;
    align-self: flex-start;
  }

  /* ---- Values ---- */
  .values-section { padding: 6rem 1.5rem; }

  .values-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .section-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 1rem;
  }

  .values-text h2 {
    font-size: var(--font-size-h2);
    margin-bottom: 1.5rem;
    color: var(--color-text);
  }

  .values-text p {
    color: var(--color-text);
    opacity: 0.7;
    margin-bottom: 1rem;
    font-size: 1rem;
    line-height: 1.7;
  }

  .values-text .btn-outline-dark { margin-top: 1rem; }

  .values-pillars {
    display: flex;
    flex-direction: column;
  }

  .pillar {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .pillar:first-child { border-top: 1px solid var(--color-border); }

  .pillar-word {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .pillar-sub {
    font-size: 0.9rem;
    color: var(--color-text);
    opacity: 0.55;
  }

  /* ---- Design callout ---- */
  .design-callout {
    background-color: var(--color-brand-red);
    border-top: 3px solid var(--color-brand-black);
    border-bottom: 3px solid var(--color-brand-black);
  }

  .design-callout-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
  }

  .design-callout-label {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    margin-bottom: 1rem;
  }

  .design-callout h2 {
    font-size: var(--font-size-h1);
    margin-bottom: 1.25rem;
    max-width: 600px;
    color: #fff;
  }

  .design-callout p {
    color: rgba(255,255,255,0.85);
    max-width: 480px;
    margin-bottom: 2rem;
    font-size: 1rem;
    line-height: 1.6;
  }

  /* ---- Projects teaser ---- */
  .projects-teaser { padding: 6rem 1.5rem; }

  .projects-teaser-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .projects-teaser-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .projects-teaser-header h2 {
    font-size: var(--font-size-h2);
    color: var(--color-text);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    border: 2px solid var(--color-border);
  }

  .project-card {
    background-color: var(--color-surface);
    border: 2px solid var(--color-border);
    overflow: hidden;
    transition: border-color 0.15s, box-shadow 0.15s;
    text-decoration: none;
    color: var(--color-text);
    display: block;
  }

  .project-card:hover {
    border-color: var(--color-brand-red);
    box-shadow: 4px 4px 0 var(--color-brand-red);
  }

  .project-img-wrap {
    aspect-ratio: 4/3;
    overflow: hidden;
  }
  .project-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .project-card:hover .project-img-wrap img { transform: scale(1.05); }

  .project-card-body { padding: 1.25rem; }

  .project-type {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 0.5rem;
  }

  .project-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
    color: var(--color-text);
  }

  .project-location {
    font-size: 0.8rem;
    color: var(--color-text);
    opacity: 0.45;
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .services-tiles { grid-template-columns: repeat(2, 1fr); }
    .service-tile:nth-child(2) { border-right: none; }
    .service-tile:nth-child(1),
    .service-tile:nth-child(2) { border-bottom: 2px solid var(--color-border); }
    .values-inner { grid-template-columns: 1fr; gap: 3rem; }
    .projects-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 600px) {
    .services-tiles { grid-template-columns: 1fr; }
    .service-tile { border-right: none; border-bottom: 2px solid var(--color-border); }
    .service-tile:last-child { border-bottom: none; }
    .projects-teaser-header { flex-direction: column; align-items: flex-start; }
    .projects-grid { grid-template-columns: 1fr; }
  }

  /* ---- Services strip additions ---- */
  .services-strip-title {
    font-size: var(--font-size-h3);
    max-width: 30ch;
    padding: 0 1.5rem 2rem;
  }
  .services-strip-popular {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 2rem 1.5rem 0;
  }
  .popular-lead {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-brand-red);
  }
  .popular-pill {
    font-size: 0.82rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--color-border);
    transition: border-color 0.15s, color 0.15s;
  }
  .popular-pill:hover {
    border-color: var(--color-brand-red);
    color: var(--color-brand-red);
  }

  /* ---- Service areas teaser ---- */
  .areas-teaser {
    background-color: var(--color-surface);
    border-top: 2px solid var(--color-border);
    border-bottom: 2px solid var(--color-border);
  }
  .areas-teaser-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
  }
