---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { serviceAreas } from '../../data/service-areas';
import { landingPages } from '../../data/services';

export function getStaticPaths() {
  return serviceAreas.map(area => ({
    params: { city: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props;

// Projects completed in this city, so each city page links to real proof.
const allProjects = await getCollection('projects');
const localProjects = allProjects.filter(
  pr => pr.data.location.toLowerCase().startsWith(area.cityName.toLowerCase())
);

// Nearby areas, for lateral links between city pages. `serviceAreas` is ordered
// geographically, so a window around this city's index gives genuine neighbours.
// Taking the first four instead would point all twelve pages at the same cities.
const areaIndex = serviceAreas.findIndex(a => a.slug === area.slug);
const windowStart = Math.max(0, Math.min(areaIndex - 2, serviceAreas.length - 5));
const nearbyAreas = serviceAreas
  .slice(windowStart, windowStart + 5)
  .filter(a => a.slug !== area.slug);

// The keyword landing pages are Flagstaff-specific, so they only belong on the
// Flagstaff page — surfacing them on Winslow would promise the wrong location.
const showLandingPages = area.slug === 'flagstaff';

// For multi-county areas (e.g. "Yavapai / Coconino"), skip appending "County"
const countyLabel = area.county.includes('/') ? `${area.county} Counties` : `${area.county} County`;

const services = [
  { title: 'Remodeling', desc: 'Kitchen, bathroom, whole-home, and room remodels.', href: '/services/remodeling/' },
  { title: 'Restoration', desc: 'Structural repair and restoration of older homes.', href: '/services/restoration/' },
  { title: 'New Construction', desc: 'Custom single-family homes from foundation to keys.', href: '/services/new-construction/' },
  { title: 'Handyman', desc: 'Small jobs and fixes around the house, done right.', href: '/services/handyman/' },
];
---

<Layout
  title={area.headline}
  description={`Licensed general contractor in ${area.cityName}, AZ (${countyLabel}). Home remodeling, restoration, new construction, and handyman services.`}
>
  <section class="area-hero">
    <div class="area-hero-inner">
      <p class="eyebrow">{countyLabel}, AZ</p>
      <h1>{area.headline}</h1>
      <p class="hero-desc">{area.description}</p>
      <div class="hero-actions">
        <a href="/quote/" class="btn-primary">Get a Free Quote &rarr;</a>
        <a href="/contact/" class="btn-outline">Contact Us</a>
      </div>
    </div>
  </section>

  <section class="services-strip">
    <div class="services-inner">
      <p class="section-eyebrow">What We Do in {area.cityName}</p>
      <h2 class="section-title">Construction and remodeling services in {area.cityName}, {area.stateAbbr}</h2>
      <div class="services-grid">
        {services.map(s => (
          <a href={s.href} class="service-tile">
            <h3 class="service-title">{s.title}</h3>
            <p class="service-desc">{s.desc}</p>
            <span class="service-arrow">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {area.highlights.length > 0 && (
    <section class="highlights-section">
      <div class="highlights-inner">
        <p class="section-eyebrow">Why {area.cityName} Homeowners Choose Stronghold</p>
        <ul class="highlights-list">
          {area.highlights.map(h => (
            <li class="highlight-item">{h}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {showLandingPages && (
    <section class="local-popular">
      <div class="local-popular-inner">
        <p class="section-eyebrow">Most Requested in {area.cityName}</p>
        <h2 class="section-title">Popular {area.cityName} projects</h2>
        <div class="local-popular-grid">
          {landingPages.map(l => (
            <a href={`/services/${l.slug}/`} class="local-popular-card">
              <span class="local-popular-label">{l.label}</span>
              <span class="local-popular-blurb">{l.blurb}</span>
              <span class="service-arrow">&rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {localProjects.length > 0 && (
    <section class="local-projects">
      <div class="local-projects-inner">
        <p class="section-eyebrow">Recent Work</p>
        <h2 class="section-title">Projects we've completed in {area.cityName}</h2>
        <div class="local-projects-grid">
          {localProjects.map(pr => (
            <a href={`/projects/${pr.id}/`} class="local-project-card">
              <Image
                src={pr.data.afterImage}
                alt={pr.data.title}
                widths={[400, 800]}
                sizes="(max-width: 700px) 100vw, 400px"
                loading="lazy"
              />
              <span class="local-project-title">{pr.data.title}</span>
              <span class="local-project-loc">{pr.data.location}</span>
            </a>
          ))}
        </div>
        <a href="/projects/" class="btn-outline">See All Projects &rarr;</a>
      </div>
    </section>
  )}

  <section class="area-note">
    <div class="area-note-inner">
      <p class="note-label">Travel & Logistics</p>
      <p class="note-dist">{area.distanceFromFlagstaff} from our Flagstaff base.</p>
      <p class="note-text">{area.servicesNote}</p>
    </div>
  </section>

  <section class="area-cta">
    <div class="area-cta-inner">
      <h2>Ready to talk about your {area.cityName} project?</h2>
      <p>Every project starts with a straight conversation. No pitch, no pressure. We'll tell you what's involved and what it costs.</p>
      <a href="/contact/" class="btn-cta">Get in Touch &rarr;</a>

      <nav class="nearby-areas" aria-label="Nearby service areas">
        <span class="nearby-label">Nearby</span>
        {nearbyAreas.map(a => (
          <a href={`/service-areas/${a.slug}/`} class="nearby-link">{a.cityName}</a>
        ))}
        <a href="/service-areas/" class="nearby-link nearby-link--all">All service areas &rarr;</a>
      </nav>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `https://builtstronghold.com/service-areas/${area.slug}/#service`,
    "name": `General contracting in ${area.cityName}, ${area.stateAbbr}`,
    "serviceType": ["Residential remodeling", "Home restoration", "New home construction", "Handyman services"],
    "provider": { "@id": "https://builtstronghold.com/#organization" },
    "areaServed": {
      "@type": "City",
      "name": area.cityName,
      "containedInPlace": {
        "@type": "State",
        "name": "Arizona"
      }
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://builtstronghold.com/"},
      {"@type": "ListItem", "position": 2, "name": "Service Areas", "item": "https://builtstronghold.com/service-areas/"},
      {"@type": "ListItem", "position": 3, "name": `${area.cityName}, ${area.stateAbbr}`, "item": `https://builtstronghold.com/service-areas/${area.slug}/`}
    ]
  })} />

</Layout>

<style>
  .area-hero {
    padding: 6rem 1.5rem 5rem;
    border-bottom: 2px solid var(--color-border);
  }
  .area-hero-inner { max-width: 800px; margin: 0 auto; }
  .eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 1rem;
  }
  .area-hero h1 { font-size: var(--font-size-h1); margin-bottom: 1.5rem; }
  .hero-desc { font-size: 1.05rem; line-height: 1.75; opacity: 0.8; margin-bottom: 2rem; }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

  .services-strip { background-color: var(--color-surface); border-bottom: 2px solid var(--color-border); padding: 4rem 1.5rem; }
  .services-inner { max-width: 1200px; margin: 0 auto; }
  .section-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 1.5rem;
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    border: 2px solid var(--color-border);
  }
  .service-tile {
    padding: 2rem;
    border-right: 2px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: background-color 0.15s;
    color: var(--color-text);
    text-decoration: none;
  }
  .service-tile:last-child { border-right: none; }
  .service-tile:hover { background-color: var(--color-brand-white, #fff); }
  .service-title { font-family: var(--font-heading); font-size: 1.1rem; font-weight: 700; border-bottom: 2px solid var(--color-brand-red); padding-bottom: 0.4rem; display: inline-block; }
  .service-desc { font-size: 0.875rem; opacity: 0.65; line-height: 1.5; flex: 1; }
  .service-arrow { font-size: 1.1rem; opacity: 0.4; }
  .service-tile:hover .service-arrow { color: var(--color-brand-red); opacity: 1; }

  .highlights-section { padding: 4rem 1.5rem; border-bottom: 2px solid var(--color-border); }
  .highlights-inner { max-width: 900px; margin: 0 auto; }
  .highlights-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .highlight-item {
    font-size: 1rem;
    line-height: 1.6;
    padding-left: 1.5rem;
    position: relative;
    opacity: 0.85;
  }
  .highlight-item::before { content: '—'; position: absolute; left: 0; color: var(--color-brand-red); font-weight: 700; }

  .area-note {
    background-color: var(--color-surface);
    border-bottom: 2px solid var(--color-border);
    padding: 3rem 1.5rem;
  }
  .area-note-inner { max-width: 900px; margin: 0 auto; }
  .note-label { font-family: var(--font-heading); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-brand-red); margin-bottom: 0.5rem; }
  .note-dist { font-family: var(--font-heading); font-size: 1rem; font-weight: 700; margin-bottom: 0.5rem; }
  .note-text { font-size: 0.9rem; opacity: 0.7; }

  .area-cta { background-color: var(--color-brand-red); border-top: 3px solid var(--color-brand-black); color: var(--color-brand-white); }
  .area-cta-inner { max-width: 1200px; margin: 0 auto; padding: 5rem 1.5rem; }
  .area-cta h2 { font-size: var(--font-size-h2); margin-bottom: 1rem; color: #fff; }
  .area-cta p { color: rgba(255,255,255,0.85); max-width: 480px; line-height: 1.7; margin-bottom: 2rem; }

  .btn-primary {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: var(--color-brand-red);
    color: #fff;
    border: 2px solid var(--color-brand-red);
    box-shadow: 4px 4px 0 var(--color-brand-black);
    transition: box-shadow 0.1s, transform 0.1s;
  }
  .btn-primary:hover { box-shadow: 2px 2px 0 var(--color-brand-black); transform: translate(2px,2px); }
  .btn-outline {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: transparent;
    color: var(--color-text);
    border: 2px solid var(--color-text);
    transition: background-color 0.15s, color 0.15s;
  }
  .btn-outline:hover { background-color: var(--color-text); color: #fff; }
  .btn-cta {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: var(--color-brand-black);
    color: #fff;
    border: 2px solid var(--color-brand-black);
    box-shadow: 4px 4px 0 rgba(255,255,255,0.4);
    transition: box-shadow 0.1s, transform 0.1s;
  }
  .btn-cta:hover { box-shadow: 2px 2px 0 rgba(255,255,255,0.4); transform: translate(2px,2px); }

  @media (max-width: 900px) {
    .services-grid { grid-template-columns: 1fr 1fr; }
    .service-tile { border-right: 2px solid var(--color-border); border-bottom: 2px solid var(--color-border); }
    .service-tile:nth-child(even) { border-right: none; }
  }
  @media (max-width: 600px) {
    .services-grid { grid-template-columns: 1fr; }
    .service-tile { border-right: none; }
  }
  /* Section headings */
  .section-title {
    font-size: var(--font-size-h3);
    margin-bottom: 2rem;
    max-width: 32ch;
  }

  /* Most requested */
  .local-popular {
    border-bottom: 2px solid var(--color-border);
  }
  .local-popular-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }
  .local-popular-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .local-popular-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border: 2px solid var(--color-border);
    background-color: var(--color-brand-white);
    transition: border-color 0.15s, transform 0.1s;
  }
  .local-popular-card:hover {
    border-color: var(--color-brand-red);
    transform: translateY(-2px);
  }
  .local-popular-label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .local-popular-blurb {
    font-size: 0.82rem;
    line-height: 1.6;
    opacity: 0.7;
  }

  /* Local projects */
  .local-projects {
    background-color: var(--color-surface);
    border-bottom: 2px solid var(--color-border);
  }
  .local-projects-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }
  .local-projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  .local-project-card {
    display: flex;
    flex-direction: column;
    border: 2px solid var(--color-border);
    background-color: var(--color-brand-white);
    transition: border-color 0.15s, transform 0.1s;
  }
  .local-project-card:hover {
    border-color: var(--color-brand-red);
    transform: translateY(-2px);
  }
  .local-project-card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
  }
  .local-project-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.875rem 1rem 0.25rem;
  }
  .local-project-loc {
    font-size: 0.78rem;
    opacity: 0.6;
    padding: 0 1rem 1rem;
  }

  /* Nearby areas */
  .nearby-areas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
  }
  .nearby-label {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-right: 0.25rem;
  }
  .nearby-link {
    font-size: 0.82rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.4);
    transition: background-color 0.15s;
  }
  .nearby-link:hover {
    background-color: rgba(0, 0, 0, 0.2);
  }
  .nearby-link--all {
    border-color: transparent;
    text-decoration: underline;
  }
</style>
