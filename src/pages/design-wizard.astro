---
import Layout from '../layouts/Layout.astro';

const styles = [
  {
    id: 'organic-modern',
    name: 'Organic Modern',
    tagline: 'Warm. Natural. Grounded.',
    description: 'Your home should feel alive, not constructed. Natural materials lead every decision — light oak, quartzite, linen, clay. Clean modern lines keep it current without feeling cold. Texture does the work that color usually does. The result is a home that is warm without being heavy, refined without feeling formal.',
    palette: ['#F0EBE1', '#C4B99A', '#6B7B5A', '#888880', '#2A2A2A'],
    paletteNames: ['Alabaster', 'Warm Taupe', 'Pewter Green', 'Warm Gray', 'Charcoal'],
    dna: [
      'Natural materials lead every decision: light oak, stone, linen, and clay over synthetic',
      'Clean architecture creates the "modern" half: no heavy molding, no ornate trim',
      'Light rift-sawn oak is the defining material. Use it in cabinetry, flooring, and ceilings.',
      'Texture does the heavy lifting: leathered stone, reeded cabinets, plaster walls, woven textiles',
    ],
    guardrails: [
      'Does this feel warm and grounded, or cold and sterile?',
      'Does it look like it came from nature, or a factory?',
      'Does it add texture and depth, or just visual noise?',
      'Will it still feel right in fifteen years?',
    ],
  },
  {
    id: 'european-modern',
    name: 'European Modern',
    tagline: 'Timeless. Layered. Quietly Sophisticated.',
    description: 'Your home should feel like it has always been there. Warm plaster, timeless tile, unlacquered brass, and arched details create a home with real soul. Nothing trendy. Nothing stark. Every surface carries character.',
    palette: ['#EEE8DE', '#B4A48C', '#6B5E4C', '#8A8880', '#2A2A2A'],
    paletteNames: ['White Dove', 'Stone Hearth', 'Warm Umber', 'Warm Gray', 'Charcoal'],
    dna: [
      'Tone is everything. This style is built on a feeling, not a trend. Ask: does this room have soul?',
      'White Dove at 50% strength on walls creates a softness no standard white can match',
      'Arch shapes and repeated details create continuity. Carry them from room to room.',
      'Hard finishes carry the character: zellige, checkered floors, leathered stone, plaster range hoods',
    ],
    guardrails: [
      'Does this feel collected and timeless, or trendy and temporary?',
      'Does it have texture, warmth, or character, or does it feel flat?',
      'Could this have lived in a beautiful home 50 years ago?',
      'Does it add depth and charm, or just visual noise?',
    ],
  },
  {
    id: 'transitional-modern',
    name: 'Transitional Modern',
    tagline: 'Classic Bones. Modern Edge. Built to Last.',
    description: 'Your home should feel elevated and livable at the same time. Classic proportions, clean modern lines, and bold contrast moments that anchor each space. One or two dramatic decisions surrounded by warm, grounded neutrals.',
    palette: ['#EEE8DE', '#D0C9B4', '#3D3D3A', '#5A6673', '#4A5042'],
    paletteNames: ['White Dove', 'Pale Oak', 'Wrought Iron', 'Ocean Floor', 'Dark Olive'],
    dna: [
      'This style walks the line between classic and modern and does it with confidence',
      'White Dove at 50% on walls, full strength on trim creates built-in warmth throughout',
      'Contrast is the defining move: bold dark moments against soft, grounded backgrounds',
      'Clean architecture throughout: caseless trim, slim shaker profiles, nothing ornate',
    ],
    guardrails: [
      'Does this feel elevated and timeless, or trendy and dated?',
      'Does it balance classic character with a clean modern edge?',
      'Does it add contrast intentionally, or just create visual confusion?',
      'Could this piece live comfortably here for twenty years?',
    ],
  },
];

const wizardSteps = [
  {
    id: 'flooring',
    step: 1,
    title: 'Flooring & Wood Tone',
    subtitle: 'Start here. Everything follows from this decision.',
    why: 'Your flooring sets the entire visual tone of your home. Every downstream decision — cabinetry color, countertop selection, wall color, hardware finish — is calibrated against it. Lock this in first and let everything cascade from it.',
    options: {
      'organic-modern': [
        { id: 'om-f1', label: 'Light Rift-Sawn Oak, Wide Plank', desc: '5"+ plank, matte or satin finish, warm-light natural tone. The signature choice for this style.', tag: 'Most Aligned' },
        { id: 'om-f2', label: 'Blonde Wire-Brushed Oak', desc: 'Slightly more texture, same warm-light tone. Adds depth while staying natural and clean.' },
        { id: 'om-f3', label: 'LVP: Wide-Plank, Warm Matte', desc: 'Wide format (6"+), subtle grain, matte finish. Excellent value — close at a glance.' },
      ],
      'european-modern': [
        { id: 'em-f1', label: 'Medium Hardwood, Warm Matte Finish', desc: 'Traditional 4-5" plank, warm neutral stain, clean matte finish. Timeless European feel.', tag: 'Most Aligned' },
        { id: 'em-f2', label: 'Honey Oak, Lightly Finished', desc: 'Slightly warmer tone. More casual European feel — works with layered detail elsewhere.' },
        { id: 'em-f3', label: 'LVP: Medium Warm, Wide Plank', desc: 'Wide format, subtle grain, warm matte finish. Nearly indistinguishable — strong value.' },
      ],
      'transitional-modern': [
        { id: 'tm-f1', label: 'Medium-Warm Hardwood, Wide Plank', desc: '5"+ plank, warm matte finish. Works in both the lighter and bolder directions.', tag: 'Most Aligned' },
        { id: 'tm-f2', label: 'Wire-Brushed Oak, Mid-Tone', desc: 'Adds texture. Casual-modern feel — not too rustic, not too stark.' },
        { id: 'tm-f3', label: 'LVP: Wide, Warm-Neutral Tone', desc: 'Mid-tone, wide plank, matte finish. High value for a look that reads as hardwood.' },
      ],
    },
    splurge: 'Real hardwood — especially wide-plank engineered oak. The warmth underfoot and the way it ages over time is worth the investment, particularly in main living areas.',
    save: 'LVP in a wide-plank format with a matte, warm-toned finish. Look for 6"+ wide planks with subtle texture. The best options are nearly indistinguishable from hardwood at a glance.',
  },
  {
    id: 'cabinetry',
    step: 2,
    title: 'Cabinetry Style & Finish',
    subtitle: 'The most visible ongoing decision in your home.',
    why: 'Cabinetry drives your paint color, tile direction, hardware finish, and lighting choices throughout the whole home. It is in every room, every day. Once installed it stays — so choose with intention.',
    options: {
      'organic-modern': [
        { id: 'om-c1', label: 'Slim Shaker or Reeded Oak, Natural Finish', desc: 'Light rift-sawn oak, minimal hardware, matte sealer. The defining organic modern cabinet.', tag: 'Most Aligned' },
        { id: 'om-c2', label: 'Flat-Panel Oak, No Hardware', desc: 'Completely flat front — the wood is the design. Ultra-clean, quietly luxurious.' },
        { id: 'om-c3', label: 'Slim White Shaker', desc: 'Warm creamy white, simple profile. Pairs well with natural countertops and oak accents.' },
      ],
      'european-modern': [
        { id: 'em-c1', label: 'White Dove Shaker, Full Strength', desc: 'Classic shaker painted White Dove at 100%. The European Modern foundation — clean and quietly elegant.', tag: 'Most Aligned' },
        { id: 'em-c2', label: 'Two-Tone: Painted Uppers, Oak Lowers', desc: 'White Dove uppers over natural oak base cabinets. Layered, collected, distinctly European.' },
        { id: 'em-c3', label: 'Full Natural Oak with Brass Hardware', desc: 'All oak kitchen with unlacquered brass pulls. Rich, warm, unmistakably European.' },
      ],
      'transitional-modern': [
        { id: 'tm-c1', label: 'White Dove Perimeter + Dark Contrast Island', desc: 'White Dove cabinets on the perimeter, Wrought Iron or deep charcoal island. The signature transitional move.', tag: 'Most Aligned' },
        { id: 'tm-c2', label: 'All White Dove, Clean Shaker', desc: 'Crisp, polished, timeless. The contrast comes from hardware, tile, and an occasional accent wall.' },
        { id: 'tm-c3', label: 'All Natural Oak + Bold Dark Moments', desc: 'Full oak kitchen with dark hood or island accent. Warm and bold at the same time.' },
      ],
    },
    splurge: 'Custom or semi-custom cabinetry in your kitchen and primary bath. The quality of fit, finish, and material — especially rift-sawn oak detail — is visible every day.',
    save: 'Pre-made cabinetry in a slim shaker or flat-panel profile, elevated with the right paint color and hardware. The gap is smaller than most people expect. Focus savings here and reinvest in flooring or stone.',
  },
  {
    id: 'countertops',
    step: 3,
    title: 'Countertops',
    subtitle: 'The surface you will touch every single day.',
    why: 'Countertops sit directly between your cabinetry and wall color — they are the critical cohesion point in every kitchen and bathroom. The right stone ties the whole space together. Choose this early in the process.',
    options: {
      'organic-modern': [
        { id: 'om-ct1', label: 'Quartzite or Quartzite-Look, Honed', desc: 'Warm white stone with soft, subtle movement. Honed or leathered finish — never high polish.', tag: 'Most Aligned' },
        { id: 'om-ct2', label: 'Limestone or Soapstone', desc: 'Ultra-natural, matte, develops character over time. Deeply organic — requires sealing.' },
        { id: 'om-ct3', label: 'Warm White Quartz, Subtle Movement', desc: 'Highly durable, low maintenance. Soft warm tone with subtle veining. Strong save choice.' },
      ],
      'european-modern': [
        { id: 'em-ct1', label: 'Marble or Calacatta, Honed or Leathered', desc: 'Natural stone with real movement. Develops warmth and character over time. Unmistakably European.', tag: 'Most Aligned' },
        { id: 'em-ct2', label: 'Quartzite, Honed or Leathered', desc: 'Similar look to marble, greater durability. Warm white to light beige with natural movement.' },
        { id: 'em-ct3', label: 'Warm-Toned Quartz, Soft Movement', desc: 'Durable, low maintenance. Nearly indistinguishable from natural stone — strong save choice.' },
      ],
      'transitional-modern': [
        { id: 'tm-ct1', label: 'Crisp White Marble or Quartzite', desc: 'Classic, elevated, pairs beautifully with both the soft and bold directions of this style.', tag: 'Most Aligned' },
        { id: 'tm-ct2', label: 'Dark Leathered Stone (Island)', desc: 'Dramatic island counterpoint. Pairs directly with the Wrought Iron two-tone cabinet approach.' },
        { id: 'tm-ct3', label: 'White Quartz, Clean Edge', desc: 'Crisp, consistent, durable. Timeless choice that works in both the lighter and bolder direction.' },
      ],
    },
    splurge: 'Natural stone — quartzite, marble, or limestone. It is timeless, leathers beautifully, and instantly elevates every surface it touches. Worth it in the kitchen and primary bath.',
    save: 'Quartz that mimics the look of warm, natural stone. The best options are highly durable and nearly indistinguishable at a glance. Prioritize getting the tone and texture right over the brand name.',
  },
  {
    id: 'tile',
    step: 4,
    title: 'Tile & Grout',
    subtitle: 'Your designer moment. Use it wisely.',
    why: 'Tile is easiest to choose once your cabinetry and paint direction are locked in. Grout color is just as important as the tile itself — the wrong grout on the right tile can undermine the entire look.',
    options: {
      'organic-modern': [
        { id: 'om-t1', label: 'Zellige or Handmade Tile, Full-Height Backsplash', desc: 'Handcrafted variation, natural imperfection, organic depth. Kitchen backsplash in zellige is the defining choice.', tag: 'Most Aligned' },
        { id: 'om-t2', label: 'Limewash Walls in Place of Tile', desc: 'Skip tile in secondary spaces — let a textured limewash or plaster wall carry the look.' },
        { id: 'om-t3', label: 'Large-Format Porcelain, Warm Grout', desc: 'Clean and restrained. Straight-stack layout, warm-toned grout. Understated and on-style.' },
      ],
      'european-modern': [
        { id: 'em-t1', label: 'Handmade Zellige Kitchen Backsplash', desc: 'Full-height kitchen backsplash in zellige. The soul of the European Modern kitchen.', tag: 'Most Aligned' },
        { id: 'em-t2', label: 'Checkered Floor in Powder Bath', desc: 'Black and cream checkered tile. A design moment guests always remember.' },
        { id: 'em-t3', label: 'Vintage-Inspired Pattern Tile', desc: 'Antique-pattern tile in a bathroom or mudroom. Adds collected character without competing.' },
      ],
      'transitional-modern': [
        { id: 'tm-t1', label: 'Bold Checkered or Statement Floor', desc: 'A single dramatic tile moment — checkered powder bath, elegant patterned bathroom floor.', tag: 'Most Aligned' },
        { id: 'tm-t2', label: 'Large-Format Dark Stone in Primary Bath', desc: 'Dramatic, sophisticated. Pairs directly with the high-contrast direction of this style.' },
        { id: 'tm-t3', label: 'Classic Marble-Look Porcelain', desc: 'Clean layout, refined grout, enduringly classic. Strong choice for secondary bathrooms.' },
      ],
    },
    splurge: 'Handmade zellige, a true checkered floor, or a full-height stone backsplash in the kitchen. These are the details guests always notice — what separates a house from a home with character.',
    save: 'Clean porcelain or ceramic in secondary spaces in a simple layout with a warm, well-chosen grout color. Reserve the statement tile for one or two focal spots where it makes the biggest impact.',
  },
  {
    id: 'lighting',
    step: 5,
    title: 'Lighting Selections',
    subtitle: 'Choose these early. Wiring cannot move after drywall.',
    why: 'Statement lighting fixtures drive ceiling rough-in heights and wire locations — decisions made at framing that cannot easily change after drywall. Lock in your statement fixtures before the rough-in stage.',
    options: {
      'organic-modern': [
        { id: 'om-l1', label: 'Organic Pendant Forms — Woven, Ceramic, or Blown Glass', desc: 'Warm, natural, unassuming shapes. Not industrial, not trendy. Hand-formed over machine-perfect.', tag: 'Most Aligned' },
        { id: 'om-l2', label: 'Matte Black Simple Pendants', desc: 'A clean contrast moment over the island. Simple silhouette, no ornamentation.' },
        { id: 'om-l3', label: 'Warm Recessed + One Statement Per Room', desc: 'Keep recessed as the workhorse. Invest the budget in one fixture per room where it matters most.' },
      ],
      'european-modern': [
        { id: 'em-l1', label: 'Antique-Inspired Pendants or Chandeliers', desc: 'Brass, aged metal, or artisan-crafted. The soul of the European Modern home — guests always ask.', tag: 'Most Aligned' },
        { id: 'em-l2', label: 'Artisan Sconces Throughout', desc: 'Handcrafted sconces in bathrooms, hallways, and bedrooms — repeated throughout for continuity.' },
        { id: 'em-l3', label: 'Statement Chandelier + Warm Recessed', desc: 'One show-stopping fixture. Warm 2700K recessed lighting everywhere else.' },
      ],
      'transitional-modern': [
        { id: 'tm-l1', label: 'Well-Proportioned Pendants, Clean Silhouette', desc: 'Where classic character meets modern restraint. A great pendant over the island is the investment.', tag: 'Most Aligned' },
        { id: 'tm-l2', label: 'Globe or Drum Pendants', desc: 'Round, simple, timeless. Available in matte black or brushed nickel — versatile and enduring.' },
        { id: 'tm-l3', label: 'Warm Recessed + One Statement Per Space', desc: 'Recessed as the foundation. Invest in the one fixture per room with the most visual impact.' },
      ],
    },
    splurge: 'Statement pendants and sconces in your primary spaces. These are the most noticed detail in any room — guests always ask about them. One great pendant over the island does more than six mediocre fixtures spread around.',
    save: 'Warm recessed lighting as the primary source throughout. Invest in one or two quality decorative fixtures per room. Skip the budget-fixture approach — even a single great pendant makes more impact.',
  },
  {
    id: 'paint',
    step: 6,
    title: 'Paint & Wall Treatments',
    subtitle: 'The backdrop. Always chosen after your hard finishes.',
    why: 'Paint responds to everything else — your flooring, your stone, your cabinetry. Getting large samples on the actual wall next to your installed materials is non-negotiable. Paint chips cannot tell you what a color will look like in your specific light.',
    options: {
      'organic-modern': [
        { id: 'om-p1', label: 'Warm Creamy White — Alabaster or Similar', desc: 'Soft, earthy, never stark. The most common organic modern wall color — warm off-white throughout.', tag: 'Most Aligned' },
        { id: 'om-p2', label: 'Limewash or Plaster Finish', desc: 'A living wall with depth, variation, and natural imperfection. Deeply on-style — gets better over time.' },
        { id: 'om-p3', label: 'Soft Earthy Neutral', desc: 'Revere Pewter range — warm gray-beige. Good in rooms with less natural light or a slightly moodier feel.' },
      ],
      'european-modern': [
        { id: 'em-p1', label: 'White Dove at 50% Strength on Walls', desc: 'Softer than any standard white. A breathtaking warmth throughout the home that no off-the-shelf color replicates.', tag: 'Most Aligned' },
        { id: 'em-p2', label: 'Stone Hearth or Warm Taupe Accent', desc: 'Deeper earthy neutral for a space needing more grounding — dining room, primary bedroom.' },
        { id: 'em-p3', label: 'Limewash Wall in Primary Bedroom or Living Room', desc: 'One limewash wall adds old-world texture and soul. A moment, not a whole-house treatment.' },
      ],
      'transitional-modern': [
        { id: 'tm-p1', label: 'White Dove 50% Walls + Full-Strength Trim', desc: 'The built-in warmth trick. Walls at half-strength, trim and cabinets at 100%. Cohesion throughout the home.', tag: 'Most Aligned' },
        { id: 'tm-p2', label: 'Pale Oak Throughout', desc: 'Warm balanced neutral, slightly more tonal than White Dove. Works in almost any light condition.' },
        { id: 'tm-p3', label: 'One Deep Color Room — Wrought Iron or Dark Olive', desc: 'A powder bath, library, or bedroom in a moody deep color. Dramatic, intentional, memorable.' },
      ],
    },
    splurge: 'Limewash or plaster finish in one or two key spaces. The depth, movement, and texture cannot be replicated with flat paint — and it only gets better as it ages.',
    save: 'High-quality flat or eggshell in the right color. The tone matters more than the brand. Always put large samples directly on the wall next to your installed materials before committing.',
  },
  {
    id: 'decor',
    step: 7,
    title: 'Decor & Textiles',
    subtitle: 'The final layer. Where warmth and personality live.',
    why: 'This is where your home gets personalized in ways that hard finishes cannot. Textiles, rugs, furniture scale, and objects bring comfort, warmth, and life. Do not rush this layer — it is allowed to evolve over time.',
    options: {
      'organic-modern': [
        { id: 'om-d1', label: 'Natural Fiber Textiles — Linen, Wool, Jute', desc: 'Undyed linen curtains, wool or jute area rugs, chunky throws. Texture over color, always.', tag: 'Most Aligned' },
        { id: 'om-d2', label: 'Handcrafted Ceramics & Woven Objects', desc: 'Hand-formed ceramic vessels, woven baskets, simple dried botanical arrangements. Nothing mass-produced.' },
        { id: 'om-d3', label: 'Clean, Low-Profile Furniture', desc: 'Simple silhouettes, natural upholstery in cream, oat, or warm sand. Not overstuffed, not minimal.' },
      ],
      'european-modern': [
        { id: 'em-d1', label: 'One Collected Antique or Vintage Piece', desc: 'A piece that looks found, not purchased. A weathered mirror, worn leather chair, or aged wood table.', tag: 'Most Aligned' },
        { id: 'em-d2', label: 'Layered Rugs & Soft Linen Drapes', desc: 'Persian-influenced or vintage rugs, simple linen curtains floor-to-ceiling, soft wool throws.' },
        { id: 'em-d3', label: 'Living Greenery & Fresh Botanicals', desc: 'Simple stems in architectural vases, olive branches, herbs in a window. Living, European warmth.' },
      ],
      'transitional-modern': [
        { id: 'tm-d1', label: 'Well-Proportioned Furniture, Natural Fabrics', desc: 'Elevated but livable. Not overstuffed, not sparse. Warm neutrals in linen, cotton, or performance fabric.', tag: 'Most Aligned' },
        { id: 'tm-d2', label: 'One Great Rug as the Foundation', desc: 'A well-chosen area rug anchors the room and sets the tone for everything above it.' },
        { id: 'tm-d3', label: 'Intentional Art — A Few Meaningful Pieces', desc: 'Not a gallery wall, not bare walls. Curated and confident. Two or three pieces that actually mean something.' },
      ],
    },
    splurge: 'One great rug or one genuine antique piece per primary room. Quality at this layer is visible and lasting — a great rug changes the feeling of an entire space.',
    save: 'Pillow covers, throw blankets, and simple curtains from quality sources. These are inexpensive and easy to change as your taste evolves. Let the hard finishes stay neutral and flex your personality here.',
  },
];
---

<Layout
  title="Design Wizard"
  description="Walk through 7 key design decisions with Stronghold's Design Wizard — flooring, cabinetry, countertops, tile, lighting, paint, and decor — in the right order."
>
  <!-- ═══════════════════════════════════════════════════ PAGE HEADER -->
  <div class="wizard-page-header">
    <div class="wizard-page-header-inner">
      <a href="/design" class="wizard-back-link">&larr; Retake Style Quiz</a>
      <div class="wizard-page-title-block">
        <p class="wizard-page-eyebrow">Design Wizard</p>
        <h1 id="wizard-page-style-name" class="wizard-page-style-name">Loading your style&hellip;</h1>
      </div>
    </div>
  </div>

  <div id="wizard-app" class="wizard-app">

    <!-- ══════════════════════════════════════════════ PHASE: WIZARD -->
    <div id="phase-wizard">
      <div class="wizard-style-header" id="wizard-style-header">
        <div class="wizard-style-header-inner">
          <div class="wizard-style-meta">
            <span class="wizard-style-label">Your Style</span>
            <span class="wizard-style-name" id="wizard-style-name">—</span>
          </div>
          <div class="wizard-header-palette" id="wizard-header-palette"></div>
          <span class="wizard-step-count" id="wizard-step-count">Step 1 of 7</span>
        </div>
        <div class="wizard-step-dots" id="wizard-step-dots"></div>
        <div class="wizard-progress-bar">
          <div class="wizard-progress-fill" id="wizard-progress-fill" style="width:0%"></div>
        </div>
      </div>

      <div id="wizard-steps-container">
        {wizardSteps.map((step, si) => (
          <div
            class={`wizard-step ${si === 0 ? 'wizard-step--active' : ''}`}
            id={`wizard-step-${step.id}`}
            data-step={step.step}
          >
            <div class="wizard-step-inner">
              <div class="wizard-step-header">
                <span class="wizard-step-num">{String(step.step).padStart(2, '0')}</span>
                <div class="wizard-step-header-text">
                  <h2 class="wizard-step-title">{step.title}</h2>
                  <p class="wizard-step-subtitle">{step.subtitle}</p>
                </div>
              </div>

              <div class="wizard-why-box">
                <p class="wizard-why-label">Why this comes first</p>
                <p class="wizard-why-text">{step.why}</p>
              </div>

              <div class="wizard-options-label">
                <p class="wizard-options-heading">Choose your direction</p>
                <p class="wizard-options-sub">Select the option that resonates most. You can go back and change this anytime.</p>
              </div>
              <div class="wizard-options" id={`wizard-options-${step.id}`}></div>

              <div class="wizard-splurge-save">
                <div class="ss-block ss-block--splurge">
                  <span class="ss-label">Splurge If&hellip;</span>
                  <p class="ss-text">{step.splurge}</p>
                </div>
                <div class="ss-block ss-block--save">
                  <span class="ss-label">Save If&hellip;</span>
                  <p class="ss-text">{step.save}</p>
                </div>
              </div>

              <div class="wizard-nav">
                <button class="wizard-back-btn btn-outline" data-target-step={step.step - 1} style={si === 0 ? 'visibility:hidden' : ''}>
                  &larr; Back
                </button>
                {si < wizardSteps.length - 1 ? (
                  <button class="wizard-next-btn btn-primary" data-target-step={step.step + 1}>
                    Next Step &rarr;
                  </button>
                ) : (
                  <button class="wizard-finish-btn btn-primary">
                    See My Full Summary &rarr;
                  </button>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ════════════════════════════════════════════════ PHASE: SUMMARY -->
    <div id="phase-summary" style="display:none">
      <div class="summary-inner">
        <p class="eyebrow">Your Design Summary</p>
        <h2 class="summary-headline">Here is where you are starting from.</h2>
        <p class="summary-sub">Bring this to your first conversation with Stronghold. We come prepared.</p>

        <div class="summary-style-block">
          <div class="summary-style-text">
            <h3 id="summary-style-name" class="summary-style-name">—</h3>
            <p id="summary-style-tagline" class="summary-style-tagline">—</p>
          </div>
          <div class="summary-palette" id="summary-palette"></div>
        </div>

        <div class="summary-grid" id="summary-grid"></div>

        <div class="summary-guardrails-section">
          <p class="eyebrow">Your Guardrail Filter</p>
          <h3 class="summary-guardrails-title">Ask these before every purchase decision.</h3>
          <ul id="summary-guardrails" class="summary-guardrails-list"></ul>
        </div>

        <div class="summary-actions">
          <a href="/contact?ref=design-wizard" class="btn-primary">Book a Design Consultation &rarr;</a>
          <button id="restart-btn" class="btn-outline">Start Over</button>
        </div>
      </div>
    </div>

  </div>
</Layout>

<script define:vars={{ styles, wizardSteps }}>
  // ─── Read style from URL ──────────────────────────────────────────────────
  const params = new URLSearchParams(window.location.search);
  const styleId = params.get('style');
  const validStyle = styles.find(s => s.id === styleId);

  if (!validStyle) {
    window.location.href = '/design';
  }

  // ─── State ────────────────────────────────────────────────────────────────
  const state = {
    selectedStyle: styleId,
    wizardStep: 1,
    wizardSelections: {},
    wizardLabels: {},
  };

  const TOTAL_WIZARD = 7;

  // ─── Element refs ─────────────────────────────────────────────────────────
  const phaseWizard  = document.getElementById('phase-wizard');
  const phaseSummary = document.getElementById('phase-summary');

  // ─── Phase transitions ────────────────────────────────────────────────────
  function showPhase(phase) {
    [phaseWizard, phaseSummary].forEach(el => {
      if (el) el.style.display = 'none';
    });
    if (phase === 'wizard')  { phaseWizard.style.display  = 'block'; }
    if (phase === 'summary') { phaseSummary.style.display = 'block'; }
    document.getElementById('wizard-app').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // ─── WIZARD ───────────────────────────────────────────────────────────────
  function initWizard(sid) {
    const profile = styles.find(s => s.id === sid);
    if (!profile) return;

    // Set page-level style name
    const pageNameEl = document.getElementById('wizard-page-style-name');
    if (pageNameEl) pageNameEl.textContent = profile.name;

    document.getElementById('wizard-style-name').textContent = profile.name;

    const headerPaletteEl = document.getElementById('wizard-header-palette');
    headerPaletteEl.innerHTML = profile.palette.map(c =>
      `<span class="wizard-palette-dot" style="background:${c}"></span>`
    ).join('');

    buildWizardDots();
    updateWizardProgress(1);

    wizardSteps.forEach(step => {
      renderWizardOptions(step.id, sid);
    });

    showWizardStep(1);
    showPhase('wizard');
  }

  function buildWizardDots() {
    const dotsEl = document.getElementById('wizard-step-dots');
    dotsEl.innerHTML = wizardSteps.map(step => `
      <button
        class="wizard-dot"
        id="wizard-dot-${step.step}"
        data-goto-step="${step.step}"
        title="Step ${step.step}: ${step.title}"
      >
        <span class="wizard-dot-num">${step.step}</span>
      </button>
    `).join('');

    dotsEl.querySelectorAll('.wizard-dot').forEach(dot => {
      dot.addEventListener('click', () => {
        const target = parseInt(dot.dataset.gotoStep);
        goToWizardStep(target);
      });
    });
  }

  function updateWizardProgress(step) {
    const pct = ((step - 1) / TOTAL_WIZARD) * 100;
    document.getElementById('wizard-progress-fill').style.width = pct + '%';
    document.getElementById('wizard-step-count').textContent = `Step ${step} of ${TOTAL_WIZARD}`;

    document.querySelectorAll('.wizard-dot').forEach(dot => {
      const dotStep = parseInt(dot.dataset.gotoStep);
      dot.classList.remove('wizard-dot--active', 'wizard-dot--complete');
      if (dotStep === step) dot.classList.add('wizard-dot--active');
      if (dotStep < step)  dot.classList.add('wizard-dot--complete');
    });
  }

  function renderWizardOptions(stepId, sid) {
    const step = wizardSteps.find(s => s.id === stepId);
    if (!step) return;
    const container = document.getElementById(`wizard-options-${stepId}`);
    if (!container) return;

    const options = step.options[sid] || [];
    const currentSel = state.wizardSelections[stepId];

    container.innerHTML = options.map(opt => `
      <button
        class="wizard-option-card ${currentSel === opt.id ? 'wizard-option-card--selected' : ''}"
        data-step-id="${stepId}"
        data-option-id="${opt.id}"
        data-option-label="${opt.label}"
      >
        ${opt.tag ? `<span class="option-tag">${opt.tag}</span>` : ''}
        <span class="option-card-label">${opt.label}</span>
        <span class="option-card-desc">${opt.desc}</span>
      </button>
    `).join('');

    container.querySelectorAll('.wizard-option-card').forEach(btn => {
      btn.addEventListener('click', () => {
        const { stepId, optionId, optionLabel } = btn.dataset;
        state.wizardSelections[stepId] = optionId;
        state.wizardLabels[stepId] = optionLabel;
        container.querySelectorAll('.wizard-option-card').forEach(b => b.classList.remove('wizard-option-card--selected'));
        btn.classList.add('wizard-option-card--selected');
      });
    });
  }

  function showWizardStep(stepNum) {
    state.wizardStep = stepNum;
    document.querySelectorAll('.wizard-step').forEach(el => el.classList.remove('wizard-step--active'));
    const target = document.querySelector(`#wizard-steps-container [data-step="${stepNum}"]`);
    if (target) {
      target.classList.add('wizard-step--active');
      document.getElementById('wizard-style-header').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    updateWizardProgress(stepNum);
  }

  function goToWizardStep(target) {
    if (target >= 1 && target <= TOTAL_WIZARD) {
      showWizardStep(target);
    }
  }

  document.getElementById('wizard-steps-container')?.addEventListener('click', e => {
    const backBtn   = e.target.closest('.wizard-back-btn');
    const nextBtn   = e.target.closest('.wizard-next-btn');
    const finishBtn = e.target.closest('.wizard-finish-btn');

    if (backBtn)   { goToWizardStep(parseInt(backBtn.dataset.targetStep)); }
    if (nextBtn)   { goToWizardStep(parseInt(nextBtn.dataset.targetStep)); }
    if (finishBtn) { showSummary(); showPhase('summary'); }
  });

  // ─── SUMMARY ──────────────────────────────────────────────────────────────
  function showSummary() {
    const profile = styles.find(s => s.id === state.selectedStyle);
    if (!profile) return;

    document.getElementById('summary-style-name').textContent = profile.name;
    document.getElementById('summary-style-tagline').textContent = profile.tagline;

    const summaryPaletteEl = document.getElementById('summary-palette');
    summaryPaletteEl.innerHTML = profile.palette.map((c, i) => `
      <div class="palette-swatch-wrap">
        <span class="palette-swatch" style="background:${c}"></span>
        <span class="palette-swatch-name">${profile.paletteNames[i]}</span>
      </div>
    `).join('');

    const gridEl = document.getElementById('summary-grid');
    gridEl.innerHTML = wizardSteps.map(step => {
      const label    = state.wizardLabels[step.id] || '—';
      const selected = !!state.wizardSelections[step.id];
      return `
        <div class="summary-item ${selected ? 'summary-item--selected' : 'summary-item--empty'}">
          <div class="summary-item-step">
            <span class="summary-item-num">${String(step.step).padStart(2, '0')}</span>
            <span class="summary-item-title">${step.title}</span>
          </div>
          <p class="summary-item-choice">${label}</p>
        </div>
      `;
    }).join('');

    const guardrailsEl = document.getElementById('summary-guardrails');
    guardrailsEl.innerHTML = profile.guardrails.map(q => `
      <li class="guardrail-item">
        <span class="guardrail-arrow">&rarr;</span>
        <span>${q}</span>
      </li>
    `).join('');
  }

  document.getElementById('restart-btn')?.addEventListener('click', () => {
    window.location.href = '/design';
  });

  // ─── Boot ─────────────────────────────────────────────────────────────────
  if (validStyle) {
    initWizard(state.selectedStyle);
  }
</script>

