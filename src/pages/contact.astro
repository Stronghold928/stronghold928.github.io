---
import Layout from '../layouts/Layout.astro';
import { serviceAreas } from '../data/service-areas';

// Formspree endpoint for the general contact form — separate form from the quote request form
const FORMSPREE_URL = 'https://formspree.io/f/mojgvwpp';



const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://builtstronghold.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Contact',
      item: 'https://builtstronghold.com/contact/',
    },
  ],
};
---

<Layout
  title="Contact | Flagstaff, AZ"
  description="Contact Stronghold Construction in Flagstaff, AZ. Ask about availability, request a quote, or check whether we serve your area."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="contact-hero">
    <div class="contact-hero-inner">
      <p class="eyebrow">Let's Talk</p>
      <h1>Questions welcome. <br /><span class="accent">We pick up the phone.</span></h1>
      <p class="hero-sub">Not sure where to start? Have a quick question? Just want to know if we cover your area? Send a note. We respond within one business day. Prefer to call: <a href="tel:+19289627535" class="phone-link">(928) 962-7535</a></p>
    </div>
  </section>

  <div class="contact-layout">
    <div class="contact-layout-inner">

      <!-- Form -->
      <div class="form-col">
        <h2 class="form-heading">Send us a message</h2>

        <div class="form-divert">
          <p>Ready to start a project? <a href="/quote/" class="form-divert-link">Request a detailed project quote &rarr;</a></p>
        </div>

        <form
          id="contact-form"
          action={FORMSPREE_URL}
          method="POST"
          class="contact-form"
          novalidate
        >
          <div class="form-row form-row--2">
            <div class="field-group">
              <label for="name" class="field-label">Your Name <span class="required">*</span></label>
              <input type="text" id="name" name="name" required placeholder="Jane Smith" class="field-input" />
            </div>
            <div class="field-group">
              <label for="phone" class="field-label">Phone Number</label>
              <input type="tel" id="phone" name="phone" placeholder="(928) 962-7535" class="field-input" />
            </div>
          </div>

          <div class="field-group">
            <label for="email" class="field-label">Email Address <span class="required">*</span></label>
            <input type="email" id="email" name="email" required placeholder="jane@example.com" class="field-input" />
          </div>

          <div class="field-group">
            <label for="message" class="field-label">What's on your mind? <span class="required">*</span></label>
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              placeholder="Ask anything: availability, service area, whether we handle your type of project, how the process works. No question is too small."
              class="field-input field-textarea"
            ></textarea>
          </div>

          <input type="hidden" name="_subject" value="General inquiry, Stronghold" />
          <input type="hidden" name="_next" value="https://builtstronghold.com/thank-you/" />
          <input type="text" name="_gotcha" style="display:none" />

          <div class="form-submit-row">
            <button type="submit" class="btn-primary">Send Message &rarr;</button>
            <p class="form-note">We respond within one business day. Your info stays with us.</p>
          </div>

          <div id="form-success" class="form-success" style="display:none">
            <p class="form-success-title">Message received.</p>
            <p>We'll get back to you within one business day. Thank you for reaching out.</p>
          </div>
        </form>
      </div>

      <!-- Sidebar -->
      <aside class="contact-sidebar" aria-labelledby="sidebar-heading">
        <h2 id="sidebar-heading" class="sidebar-heading">Reach Stronghold directly</h2>
        <div class="sidebar-block">
          <h3 class="sidebar-title">Direct Contact</h3>
          <a href="tel:+19289627535" class="contact-item contact-item--link">
            <span class="contact-item-label">Phone</span>
            <span class="contact-item-value">(928) 962-7535</span>
          </a>
          <a href="mailto:hello@builtstronghold.com" class="contact-item contact-item--link">
            <span class="contact-item-label">Email</span>
            <span class="contact-item-value">hello@builtstronghold.com</span>
          </a>
          <div class="contact-item">
            <span class="contact-item-label">Address</span>
            <span class="contact-item-value">1155 W Kaibab Lane<br />Flagstaff, AZ 86001</span>
          </div>
          <div class="contact-item">
            <span class="contact-item-label">Hours</span>
            <span class="contact-item-value">Mon–Fri 9am–4pm</span>
          </div>
        </div>

        <div class="sidebar-block">
          <h3 class="sidebar-title">Service Area</h3>
          <p class="sidebar-note">Based in Flagstaff. Serving northern Arizona including:</p>
          <div class="area-tags">
            {serviceAreas.map(area => (
              <a href={`/service-areas/${area.slug}/`} class="area-tag">{area.cityName}</a>
            ))}
          </div>
        </div>

        <div class="sidebar-block">
          <h3 class="sidebar-title">Location</h3>
          <p class="sidebar-note">Based in Flagstaff, AZ</p>
          <!-- TODO: Replace src with real Google Maps embed URL once business address is confirmed -->
          <!-- Example: https://www.google.com/maps/embed?pb=!1m18!... -->
          <!-- <iframe
            src="TODO_GOOGLE_MAPS_EMBED_URL"
            width="100%"
            height="200"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Stronghold Construction location in Flagstaff, AZ"
          ></iframe> -->
        </div>

        <div class="sidebar-block">
          <h3 class="sidebar-title">License</h3>
          <p class="sidebar-note">Arizona Registrar of Contractors</p>
          <p class="license-num">ROC License: 354046</p>
          <p class="accreditation">Licensed, Bonded, Insured</p>
        </div>

        <div class="sidebar-block sidebar-block--design">
          <h3 class="sidebar-title">Not sure what style you want?</h3>
          <p>Our free design quiz takes a few minutes and hands you back a real plan: a named style, a proven palette, and the materials that make it work.</p>
          <a href="/design/" class="btn-outline">Get Your Design Plan &rarr;</a>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('form-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const action = form.getAttribute('action') ?? '';

    try {
      const res = await fetch(action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        form.style.display = 'none';
        if (success) success.style.display = 'block';
      } else {
        alert('Something went wrong. Please try calling us directly at (928) 962-7535.');
      }
    } catch {
      alert('Unable to send. Please try calling us directly at (928) 962-7535.');
    }
  });
</script>

<style>
  /* Hero */
  .contact-hero {
    padding: 6rem 1.5rem 4rem;
    border-bottom: 2px solid var(--color-border);
  }
  .contact-hero-inner { max-width: 1200px; margin: 0 auto; }
  .eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 1rem;
  }
  .contact-hero h1 { font-size: var(--font-size-h1); margin-bottom: 1.25rem; }
  .accent { color: var(--color-brand-red); }
  .hero-sub { font-size: 1.1rem; opacity: 0.75; max-width: 580px; line-height: 1.6; }
  .phone-link { color: var(--color-brand-red); font-weight: 700; text-decoration: underline; }

  /* Divert banner */
  .form-divert {
    background-color: var(--color-surface);
    border: 2px solid var(--color-border);
    border-left: 4px solid var(--color-brand-red);
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    font-size: 0.9rem;
    opacity: 0.85;
  }
  .form-divert-link {
    color: var(--color-brand-red);
    font-weight: 700;
    text-decoration: underline;
    transition: opacity 0.15s;
  }
  .form-divert-link:hover { opacity: 0.7; }

  /* Layout */
  .contact-layout { padding: 4rem 1.5rem 6rem; }
  .contact-layout-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 5rem;
    align-items: start;
  }

  /* Form */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .form-row { display: flex; gap: 1rem; }
  .form-row--2 > * { flex: 1; }
  .field-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .field-label {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .required { color: var(--color-brand-red); }
  .field-input {
    background-color: var(--color-surface);
    border: 2px solid var(--color-border);
    color: var(--color-text);
    padding: 0.875rem 1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    width: 100%;
    transition: border-color 0.15s;
    appearance: none;
    -webkit-appearance: none;
  }
  .field-input::placeholder { opacity: 0.4; }
  .field-input:focus {
    outline: none;
    border-color: var(--color-brand-red);
    box-shadow: 3px 3px 0 var(--color-brand-red);
  }
  .field-textarea { resize: vertical; min-height: 160px; }
  .form-submit-row { display: flex; align-items: flex-start; gap: 1.5rem; flex-wrap: wrap; }
  .form-note { font-size: 0.8rem; opacity: 0.45; line-height: 1.5; max-width: 240px; }

  .form-success {
    background-color: var(--color-surface);
    border-left: 4px solid var(--color-brand-red);
    padding: 2rem;
  }
  .form-success h3 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .form-success p { opacity: 0.75; font-size: 0.9rem; }

  /* Sidebar */
  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 2px solid var(--color-border);
    position: sticky;
    top: 80px;
  }
  .sidebar-block {
    padding: 1.75rem;
    border-bottom: 2px solid var(--color-border);
  }
  .sidebar-block:last-child { border-bottom: none; }
  .sidebar-title {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 1rem;
  }
  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-bottom: 1rem;
  }
  .contact-item:last-child { margin-bottom: 0; }
  .contact-item--link { text-decoration: none; transition: opacity 0.15s; }
  .contact-item--link:hover { opacity: 0.75; }
  .contact-item-label {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.4;
  }
  .contact-item-value { font-size: 0.95rem; line-height: 1.4; }
  .sidebar-note { font-size: 0.8rem; opacity: 0.6; line-height: 1.5; margin-bottom: 0.75rem; }
  .area-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .area-tag {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.5rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    opacity: 0.8;
    text-decoration: none;
    transition: border-color 0.15s, opacity 0.15s;
  }
  .area-tag:hover {
    border-color: var(--color-brand-red);
    opacity: 1;
  }
  .license-num { font-size: 0.85rem; opacity: 0.7; }
  .accreditation {
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-top: 0.6rem;
  }
  .sidebar-block--design p {
    font-size: 0.875rem;
    opacity: 0.7;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  /* Buttons */
  .btn-primary {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: var(--color-brand-red);
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-red);
    box-shadow: 4px 4px 0 var(--color-dark);
    transition: box-shadow 0.1s, transform 0.1s;
    cursor: pointer;
  }
  .btn-primary:hover {
    box-shadow: 2px 2px 0 var(--color-dark);
    transform: translate(2px, 2px);
  }
  .btn-outline {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.75rem 1.25rem;
    background-color: transparent;
    color: var(--color-text);
    border: 2px solid var(--color-text);
    transition: background-color 0.15s, color 0.15s;
  }
  .btn-outline:hover {
    background-color: var(--color-text);
    color: var(--color-bg);
  }

  @media (max-width: 900px) {
    .contact-layout-inner { grid-template-columns: 1fr; }
    .contact-sidebar { position: static; }
    .form-row { flex-direction: column; }
  }
</style>
