---
import Layout from '../layouts/Layout.astro';

const projectTypes = [
  'Kitchen Remodel',
  'Bathroom Remodel',
  'Whole-Home Remodel',
  'Room Addition',
  'Restoration / Historic Repair',
  'New Single-Family Build',
  'New Multi-Family Build',
  'Deck / Exterior Repair',
  'Structural Repair',
  'Other Repair',
  'Not sure yet',
];

// Formspree endpoint — replace with your actual form ID after signing up at formspree.io
const FORMSPREE_URL = 'https://formspree.io/f/xyzgtest';

const serviceAreas = [
  'Flagstaff', 'Williams', 'Sedona', 'Camp Verde',
  'Winslow', 'Show Low', 'Payson', 'Prescott Valley',
];
---

<Layout
  title="Contact"
  description="Get in touch with Stronghold928. Request a quote, describe a repair, or ask a question — based in Flagstaff, AZ serving northern Arizona."
>
  <section class="contact-hero">
    <div class="contact-hero-inner">
      <p class="eyebrow">Let's Talk</p>
      <h1>No forms for the<br /><span class="accent">sake of forms.</span></h1>
      <p class="hero-sub">Fill this out and we'll respond within one business day. Rather call? We answer: <a href="tel:+19285550100" class="phone-link">(928) 555-0100</a></p>
    </div>
  </section>

  <div class="contact-layout">
    <div class="contact-layout-inner">

      <!-- Form -->
      <div class="form-col">
        <form
          id="contact-form"
          action={FORMSPREE_URL}
          method="POST"
          class="contact-form"
          novalidate
        >
          <div class="form-row form-row--2">
            <div class="field-group">
              <label for="name" class="field-label">Your Name <span class="required">*</span></label>
              <input type="text" id="name" name="name" required placeholder="Jane Smith" class="field-input" />
            </div>
            <div class="field-group">
              <label for="phone" class="field-label">Phone Number <span class="required">*</span></label>
              <input type="tel" id="phone" name="phone" required placeholder="(928) 555-0100" class="field-input" />
            </div>
          </div>

          <div class="field-group">
            <label for="email" class="field-label">Email Address <span class="required">*</span></label>
            <input type="email" id="email" name="email" required placeholder="jane@example.com" class="field-input" />
          </div>

          <div class="field-group">
            <label for="project-type" class="field-label">Project Type</label>
            <select id="project-type" name="project_type" class="field-input field-select">
              <option value="" disabled selected>Select a project type...</option>
              {projectTypes.map(t => <option value={t}>{t}</option>)}
            </select>
          </div>

          <div class="field-group">
            <label for="address" class="field-label">Property Address or City</label>
            <input type="text" id="address" name="address" placeholder="123 Ponderosa Dr, Flagstaff, AZ" class="field-input" />
          </div>

          <div class="field-group">
            <label for="timeline" class="field-label">Rough Timeline</label>
            <select id="timeline" name="timeline" class="field-input field-select">
              <option value="" disabled selected>When are you hoping to start?</option>
              <option>ASAP — this is urgent</option>
              <option>Within 1–3 months</option>
              <option>3–6 months</option>
              <option>6–12 months</option>
              <option>Just exploring right now</option>
            </select>
          </div>

          <div class="field-group">
            <label for="message" class="field-label">Tell us about the project <span class="required">*</span></label>
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              placeholder="Describe what you're hoping to do, what problem needs solving, or what questions you have. The more detail, the better we can prepare."
              class="field-input field-textarea"
            ></textarea>
          </div>

          <input type="hidden" name="_subject" value="New project inquiry — Stronghold928" />
          <input type="text" name="_gotcha" style="display:none" />

          <div class="form-submit-row">
            <button type="submit" class="btn-primary">Send Message &rarr;</button>
            <p class="form-note">We respond within one business day. Your information is never sold or shared.</p>
          </div>

          <div id="form-success" class="form-success" style="display:none">
            <h3>Message received.</h3>
            <p>We'll be in touch within one business day. Thank you for reaching out.</p>
          </div>
        </form>
      </div>

      <!-- Contact info sidebar -->
      <aside class="contact-sidebar">
        <div class="sidebar-block">
          <h3 class="sidebar-title">Direct Contact</h3>
          <a href="tel:+19285550100" class="contact-item contact-item--link">
            <span class="contact-item-label">Phone</span>
            <span class="contact-item-value">(928) 555-0100</span>
          </a>
          <a href="mailto:hello@stronghold928.com" class="contact-item contact-item--link">
            <span class="contact-item-label">Email</span>
            <span class="contact-item-value">hello@stronghold928.com</span>
          </a>
          <div class="contact-item">
            <span class="contact-item-label">Hours</span>
            <span class="contact-item-value">Mon–Fri 7am–5pm<br />Sat by appointment</span>
          </div>
        </div>

        <div class="sidebar-block">
          <h3 class="sidebar-title">Service Area</h3>
          <p class="sidebar-note">Based in Flagstaff. Serving northern Arizona including:</p>
          <div class="area-tags">
            {serviceAreas.map(area => (
              <span class="area-tag">{area}</span>
            ))}
          </div>
        </div>

        <div class="sidebar-block">
          <h3 class="sidebar-title">License</h3>
          <p class="sidebar-note">Arizona Registrar of Contractors</p>
          <p class="license-num">ROC License: <span class="license-placeholder">[Pending]</span></p>
        </div>

        <div class="sidebar-block sidebar-block--design">
          <h3 class="sidebar-title">Not sure what you want?</h3>
          <p>Take our guided design questionnaire — five questions that help you find your style profile before the first conversation.</p>
          <a href="/style-selector" class="btn-outline">Start Design Guide &rarr;</a>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('form-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const action = form.getAttribute('action') ?? '';

    try {
      const res = await fetch(action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        form.style.display = 'none';
        if (success) success.style.display = 'block';
      } else {
        alert('Something went wrong. Please try calling us directly at (928) 555-0100.');
      }
    } catch {
      alert('Unable to send. Please try calling us directly at (928) 555-0100.');
    }
  });
</script>

<style>
  /* Hero */
  .contact-hero {
    padding: 6rem 1.5rem 4rem;
    border-bottom: 2px solid var(--color-brand-gray);
  }
  .contact-hero-inner { max-width: 1200px; margin: 0 auto; }
  .eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 1rem;
  }
  .contact-hero h1 { font-size: var(--font-size-h1); margin-bottom: 1.25rem; }
  .accent { color: var(--color-brand-red); }
  .hero-sub { font-size: 1.1rem; opacity: 0.75; max-width: 540px; line-height: 1.6; }
  .phone-link { color: var(--color-brand-red); font-weight: 700; text-decoration: underline; }

  /* Layout */
  .contact-layout { padding: 4rem 1.5rem 6rem; }
  .contact-layout-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 5rem;
    align-items: start;
  }

  /* Form */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .form-row { display: flex; gap: 1rem; }
  .form-row--2 > * { flex: 1; }
  .field-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .field-label {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .required { color: var(--color-brand-red); }
  .field-input {
    background-color: var(--color-brand-gray);
    border: 2px solid var(--color-brand-gray-light);
    color: var(--color-brand-white);
    padding: 0.875rem 1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    width: 100%;
    transition: border-color 0.15s;
    appearance: none;
    -webkit-appearance: none;
  }
  .field-input::placeholder { opacity: 0.4; }
  .field-input:focus {
    outline: none;
    border-color: var(--color-brand-red);
    box-shadow: 3px 3px 0 var(--color-brand-red);
  }
  .field-select { cursor: pointer; }
  .field-textarea { resize: vertical; min-height: 140px; }
  .form-submit-row { display: flex; align-items: flex-start; gap: 1.5rem; flex-wrap: wrap; }
  .form-note { font-size: 0.8rem; opacity: 0.45; line-height: 1.5; max-width: 240px; }

  .form-success {
    background-color: var(--color-brand-gray);
    border-left: 4px solid var(--color-brand-red);
    padding: 2rem;
  }
  .form-success h3 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .form-success p { opacity: 0.75; font-size: 0.9rem; }

  /* Sidebar */
  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 2px solid var(--color-brand-gray);
    position: sticky;
    top: 80px;
  }
  .sidebar-block {
    padding: 1.75rem;
    border-bottom: 2px solid var(--color-brand-gray);
  }
  .sidebar-block:last-child { border-bottom: none; }
  .sidebar-title {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 1rem;
  }
  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-bottom: 1rem;
  }
  .contact-item:last-child { margin-bottom: 0; }
  .contact-item--link { text-decoration: none; transition: opacity 0.15s; }
  .contact-item--link:hover { opacity: 0.75; }
  .contact-item-label {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.4;
  }
  .contact-item-value { font-size: 0.95rem; line-height: 1.4; }
  .sidebar-note { font-size: 0.8rem; opacity: 0.6; line-height: 1.5; margin-bottom: 0.75rem; }
  .area-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .area-tag {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.5rem;
    background-color: var(--color-brand-black);
    border: 1px solid var(--color-brand-gray-light);
    opacity: 0.8;
  }
  .license-num { font-size: 0.85rem; opacity: 0.7; }
  .license-placeholder { color: var(--color-brand-red); }
  .sidebar-block--design p {
    font-size: 0.875rem;
    opacity: 0.7;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  /* Buttons */
  .btn-primary {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: var(--color-brand-red);
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-red);
    box-shadow: 4px 4px 0 var(--color-brand-white);
    transition: box-shadow 0.1s, transform 0.1s;
    cursor: pointer;
  }
  .btn-primary:hover {
    box-shadow: 2px 2px 0 var(--color-brand-white);
    transform: translate(2px, 2px);
  }
  .btn-outline {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.75rem 1.25rem;
    background-color: transparent;
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-white);
    transition: background-color 0.15s, color 0.15s;
  }
  .btn-outline:hover {
    background-color: var(--color-brand-white);
    color: var(--color-brand-black);
  }

  @media (max-width: 900px) {
    .contact-layout-inner { grid-template-columns: 1fr; }
    .contact-sidebar { position: static; }
    .form-row { flex-direction: column; }
  }
</style>
