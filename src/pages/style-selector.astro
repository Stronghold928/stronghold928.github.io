---
import Layout from '../layouts/Layout.astro';

// Style profiles — determined by answers
const profiles = [
  {
    id: 'modern-warm',
    name: 'Modern Warm',
    tagline: 'Clean lines. Natural materials. No cold edges.',
    description: 'You want a home that feels current and uncluttered, but also genuinely lived-in. You gravitate toward neutral palettes with warmth — creamy whites, warm grays, natural wood, aged metal. Function drives decisions, but beauty follows close behind.',
    palette: ['#F5F0E8', '#D4C5B0', '#8B7355', '#2C2416', '#B87333'],
    materials: ['White oak flooring', 'Quartz or honed stone countertops', 'Shaker or flat-panel cabinetry', 'Unlacquered brass or matte black hardware', 'Linen and cotton textiles'],
    image: 'https://images.unsplash.com/photo-1556909172-54557c7e4fb7?w=900&auto=format&fit=crop&q=80',
  },
  {
    id: 'southwest-organic',
    name: 'Southwest Organic',
    tagline: 'The land, brought inside.',
    description: 'You want your home to feel rooted in the high desert — warm terracotta tones, handmade textures, natural imperfection. You value craftsmanship you can see, materials that age well, and spaces that feel like they belong where they are.',
    palette: ['#C4724A', '#D4956A', '#8B6914', '#3D2B1F', '#A89070'],
    materials: ['Saltillo or handmade tile', 'Adobe, plaster, or limewash walls', 'Reclaimed wood beams and shelving', 'Hand-hammered copper or iron fixtures', 'Woven textiles and natural fiber rugs'],
    image: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=900&auto=format&fit=crop&q=80',
  },
  {
    id: 'industrial-modern',
    name: 'Industrial Modern',
    tagline: 'Raw materials. Honest construction.',
    description: 'You appreciate exposed structure, concrete, steel, and glass. You want a home that shows how it\'s made rather than hiding it. High contrast — dark and light — with minimal ornamentation. Every element earns its place.',
    palette: ['#2A2A2A', '#4A4A4A', '#8C8C8C', '#F5F5F5', '#CC0000'],
    materials: ['Polished or honed concrete floors', 'Exposed brick or block', 'Black steel windows and doors', 'Open shelving, no upper cabinet doors', 'Matte black or raw steel fixtures'],
    image: 'https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=900&auto=format&fit=crop&q=80',
  },
  {
    id: 'classic-refined',
    name: 'Classic Refined',
    tagline: 'Timeless detail. Nothing trendy.',
    description: 'You want a home that will look right in 30 years. Detailed millwork, traditional proportions, quality materials chosen for longevity. You\'re drawn to homes that have history — or feel like they do.',
    palette: ['#F8F4EE', '#E8DDD0', '#8B7B6B', '#2C1810', '#4A3728'],
    materials: ['Hardwood floors (oak, maple, walnut)', 'Subway tile or Zellige in baths', 'Inset cabinetry with furniture-grade finish', 'Polished nickel or brushed brass hardware', 'Crown molding, window casing, built-ins'],
    image: 'https://images.unsplash.com/photo-1600121848594-d8644e57abab?w=900&auto=format&fit=crop&q=80',
  },
];

// Questions and answers — each answer has weights per profile id
const questions = [
  {
    id: 'q1',
    step: 1,
    question: 'Which best describes how you want your home to feel?',
    answers: [
      { label: 'Calm and uncluttered', weights: { 'modern-warm': 2, 'industrial-modern': 1 } },
      { label: 'Warm and rooted in place', weights: { 'southwest-organic': 2, 'classic-refined': 1 } },
      { label: 'Bold and honest about materials', weights: { 'industrial-modern': 3 } },
      { label: 'Polished and traditionally grounded', weights: { 'classic-refined': 3 } },
    ],
  },
  {
    id: 'q2',
    step: 2,
    question: 'Which kitchen speaks to you?',
    type: 'image',
    answers: [
      {
        label: 'White shaker cabinets, quartz counters, brass hardware',
        image: 'https://images.unsplash.com/photo-1556909172-54557c7e4fb7?w=600&auto=format&fit=crop&q=80',
        weights: { 'modern-warm': 3, 'classic-refined': 1 },
      },
      {
        label: 'Terracotta tile, plaster walls, wood open shelves',
        image: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=600&auto=format&fit=crop&q=80',
        weights: { 'southwest-organic': 3 },
      },
      {
        label: 'Concrete counters, open steel shelving, black fixtures',
        image: 'https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=600&auto=format&fit=crop&q=80',
        weights: { 'industrial-modern': 3 },
      },
      {
        label: 'Inset cabinetry, marble, polished hardware',
        image: 'https://images.unsplash.com/photo-1600121848594-d8644e57abab?w=600&auto=format&fit=crop&q=80',
        weights: { 'classic-refined': 3, 'modern-warm': 1 },
      },
    ],
  },
  {
    id: 'q3',
    step: 3,
    question: 'How do you feel about visible imperfections — hand-done tile, natural wood variation, aged finishes?',
    answers: [
      { label: 'Love them — character beats perfection', weights: { 'southwest-organic': 3, 'classic-refined': 1 } },
      { label: 'Appreciate them, but within limits', weights: { 'modern-warm': 2, 'classic-refined': 2 } },
      { label: 'Prefer clean, precise, consistent', weights: { 'industrial-modern': 2, 'modern-warm': 1 } },
      { label: 'Depends on where in the house', weights: { 'modern-warm': 1, 'classic-refined': 1, 'southwest-organic': 1 } },
    ],
  },
  {
    id: 'q4',
    step: 4,
    question: 'Pick the flooring that feels most like home.',
    type: 'image',
    answers: [
      {
        label: 'Wide-plank white oak, lightly finished',
        image: 'https://images.unsplash.com/photo-1600566753376-12c8ab7fb75b?w=600&auto=format&fit=crop&q=80',
        weights: { 'modern-warm': 3, 'classic-refined': 1 },
      },
      {
        label: 'Saltillo tile, large format terracotta',
        image: 'https://images.unsplash.com/photo-1565538810643-b5bdb714032a?w=600&auto=format&fit=crop&q=80',
        weights: { 'southwest-organic': 3 },
      },
      {
        label: 'Polished concrete, large format gray stone',
        image: 'https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=600&auto=format&fit=crop&q=80',
        weights: { 'industrial-modern': 3 },
      },
      {
        label: 'Traditional hardwood, medium-dark stain',
        image: 'https://images.unsplash.com/photo-1600607687939-ce8a6c349479?w=600&auto=format&fit=crop&q=80',
        weights: { 'classic-refined': 3, 'southwest-organic': 1 },
      },
    ],
  },
  {
    id: 'q5',
    step: 5,
    question: 'When it comes to color in your home, you tend to:',
    answers: [
      { label: 'Keep it neutral — let materials and texture carry it', weights: { 'modern-warm': 2, 'industrial-modern': 2 } },
      { label: 'Use warm earth tones as the base', weights: { 'southwest-organic': 3, 'classic-refined': 1 } },
      { label: 'Prefer high contrast — darks and lights, little in between', weights: { 'industrial-modern': 3 } },
      { label: 'Mix classic neutrals with one or two intentional accent colors', weights: { 'classic-refined': 3, 'modern-warm': 1 } },
    ],
  },
];
---

<Layout
  title="Design Guide"
  description="Not sure what style you want for your remodel? Stronghold928's guided design selector helps you find your style profile in under 5 minutes."
>
  <section class="selector-hero">
    <div class="selector-hero-inner">
      <p class="eyebrow">Guided Design</p>
      <h1>Find your style.<br /><span class="accent">Before the first nail.</span></h1>
      <p class="hero-sub">
        Five questions. A clear style profile. A starting point for every design conversation to come.
        No commitment, no account required.
      </p>
    </div>
  </section>

  <!-- Questionnaire -->
  <div id="selector-app" class="selector-app">

    <!-- Progress bar -->
    <div class="progress-bar-wrap">
      <div class="progress-bar-inner">
        <div class="progress-fill" id="progress-fill" style="width: 0%"></div>
      </div>
      <span class="progress-label" id="progress-label">Step 1 of 5</span>
    </div>

    <!-- Questions -->
    <div id="questions-container">
      {questions.map((q, qi) => (
        <div
          class={`question-block ${qi === 0 ? 'question-block--active' : ''}`}
          id={`question-${q.id}`}
          data-step={q.step}
        >
          <div class="question-inner">
            <p class="question-num">Question {q.step} / {questions.length}</p>
            <h2 class="question-text">{q.question}</h2>
            <div class={`answers-grid ${q.type === 'image' ? 'answers-grid--image' : 'answers-grid--text'}`}>
              {q.answers.map((a, ai) => (
                <button
                  class={`answer-btn ${q.type === 'image' ? 'answer-btn--image' : ''}`}
                  data-question={q.id}
                  data-answer={ai}
                  data-weights={JSON.stringify(a.weights)}
                >
                  {q.type === 'image' && 'image' in a && (
                    <div class="answer-img-wrap">
                      <img src={(a as any).image} alt={a.label} loading="lazy" />
                    </div>
                  )}
                  <span class="answer-label">{a.label}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Results -->
    <div id="results-block" class="results-block" style="display:none">
      <div class="results-inner">
        <p class="eyebrow">Your Style Profile</p>
        <h2 id="result-name" class="result-name">—</h2>
        <p id="result-tagline" class="result-tagline">—</p>
        <div class="result-body">
          <div class="result-left">
            <div class="result-img-wrap">
              <img id="result-image" src="" alt="" loading="lazy" />
            </div>
            <div class="result-palette" id="result-palette"></div>
          </div>
          <div class="result-right">
            <p id="result-description" class="result-description">—</p>
            <h3 class="materials-title">Signature Materials</h3>
            <ul id="result-materials" class="materials-list"></ul>
            <div class="result-actions">
              <a href="/contact?ref=style-selector" class="btn-primary">Talk to Us About This Style &rarr;</a>
              <button id="retake-btn" class="btn-outline">Retake</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- How it works -->
  <section class="how-it-works">
    <div class="how-inner">
      <p class="eyebrow">After the Quiz</p>
      <h2>Your profile is a starting point,<br />not a contract.</h2>
      <p>Style profiles give us a shared vocabulary — a reference point so that when we're choosing between two countertop materials or three cabinet hardware options, we're not starting from scratch. We'll refine and adapt based on your specific space, budget, and what's actually available.</p>
      <div class="how-steps">
        <div class="how-step">
          <span class="how-num">01</span>
          <h3>Get your profile</h3>
          <p>Answer five questions about how you want your home to feel.</p>
        </div>
        <div class="how-step">
          <span class="how-num">02</span>
          <h3>Schedule a consultation</h3>
          <p>Share your profile with us when you reach out. We come prepared.</p>
        </div>
        <div class="how-step">
          <span class="how-num">03</span>
          <h3>Design session</h3>
          <p>Together we translate profile into specific selections for your project.</p>
        </div>
        <div class="how-step">
          <span class="how-num">04</span>
          <h3>Build with confidence</h3>
          <p>Every decision you make in the field has a reference point you already own.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ profiles }}>
  const scores = {};
  profiles.forEach(p => { scores[p.id] = 0; });

  const totalSteps = 5;
  let currentStep = 1;

  const progressFill = document.getElementById('progress-fill');
  const progressLabel = document.getElementById('progress-label');
  const resultsBlock = document.getElementById('results-block');
  const retakeBtn = document.getElementById('retake-btn');

  function updateProgress(step) {
    const pct = ((step - 1) / totalSteps) * 100;
    progressFill.style.width = pct + '%';
    progressLabel.textContent = step <= totalSteps
      ? `Step ${step} of ${totalSteps}`
      : 'Complete';
  }

  function showQuestion(step) {
    document.querySelectorAll('.question-block').forEach(el => {
      el.classList.remove('question-block--active');
    });
    const target = document.querySelector(`[data-step="${step}"]`);
    if (target) {
      target.classList.add('question-block--active');
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function showResults() {
    document.getElementById('questions-container').style.display = 'none';
    resultsBlock.style.display = 'block';

    const best = Object.entries(scores).sort((a, b) => b[1] - a[1])[0][0];
    const profile = profiles.find(p => p.id === best);

    document.getElementById('result-name').textContent = profile.name;
    document.getElementById('result-tagline').textContent = profile.tagline;
    document.getElementById('result-description').textContent = profile.description;
    document.getElementById('result-image').src = profile.image;
    document.getElementById('result-image').alt = profile.name;

    const paletteEl = document.getElementById('result-palette');
    paletteEl.innerHTML = profile.palette.map(c =>
      `<span class="swatch" style="background:${c}"></span>`
    ).join('');

    const materialsEl = document.getElementById('result-materials');
    materialsEl.innerHTML = profile.materials.map(m =>
      `<li>${m}</li>`
    ).join('');

    progressFill.style.width = '100%';
    progressLabel.textContent = 'Complete';
    resultsBlock.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  document.querySelectorAll('.answer-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const questionId = btn.dataset.question;
      const weights = JSON.parse(btn.dataset.weights);

      // Mark selected
      document.querySelectorAll(`[data-question="${questionId}"]`).forEach(b => {
        b.classList.remove('answer-btn--selected');
      });
      btn.classList.add('answer-btn--selected');

      // Apply weights
      Object.entries(weights).forEach(([id, w]) => {
        scores[id] = (scores[id] || 0) + w;
      });

      // Advance
      setTimeout(() => {
        if (currentStep < totalSteps) {
          currentStep++;
          updateProgress(currentStep);
          showQuestion(currentStep);
        } else {
          showResults();
        }
      }, 300);
    });
  });

  retakeBtn?.addEventListener('click', () => {
    profiles.forEach(p => { scores[p.id] = 0; });
    currentStep = 1;
    updateProgress(1);
    document.querySelectorAll('.answer-btn').forEach(b => b.classList.remove('answer-btn--selected'));
    document.querySelectorAll('.question-block').forEach(el => el.classList.remove('question-block--active'));
    resultsBlock.style.display = 'none';
    document.getElementById('questions-container').style.display = 'block';
    showQuestion(1);
    document.getElementById('selector-app').scrollIntoView({ behavior: 'smooth' });
  });

  updateProgress(1);
</script>

<style>
  /* Hero */
  .selector-hero {
    padding: 6rem 1.5rem 4rem;
    border-bottom: 2px solid var(--color-brand-gray);
  }
  .selector-hero-inner { max-width: 1200px; margin: 0 auto; }
  .eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 1rem;
  }
  .selector-hero h1 { font-size: var(--font-size-h1); margin-bottom: 1.25rem; }
  .accent { color: var(--color-brand-red); }
  .hero-sub { font-size: 1.1rem; opacity: 0.7; max-width: 540px; line-height: 1.6; }

  /* App container */
  .selector-app {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 0 5rem;
  }

  /* Progress */
  .progress-bar-wrap {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 64px;
    background-color: var(--color-bg);
    z-index: 9;
  }
  .progress-bar-inner {
    flex: 1;
    height: 3px;
    background-color: var(--color-border);
  }
  .progress-fill {
    height: 100%;
    background-color: var(--color-brand-red);
    transition: width 0.4s ease;
  }
  .progress-label {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.5;
    white-space: nowrap;
  }

  /* Questions */
  .question-block { display: none; }
  .question-block--active { display: block; }

  .question-inner {
    padding: 4rem 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
  }
  .question-num {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 0.75rem;
  }
  .question-text {
    font-size: var(--font-size-h2);
    margin-bottom: 2.5rem;
    max-width: 700px;
  }

  /* Answers — text */
  .answers-grid--text {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .answer-btn {
    text-align: left;
    background-color: var(--color-surface);
    border: 2px solid var(--color-border);
    color: var(--color-text);
    padding: 1.5rem;
    cursor: pointer;
    transition: border-color 0.15s, box-shadow 0.15s;
    font-family: var(--font-body);
  }
  .answer-btn:hover {
    border-color: var(--color-brand-white);
  }
  .answer-btn--selected {
    border-color: var(--color-brand-red) !important;
    box-shadow: 4px 4px 0 var(--color-brand-red);
  }
  .answer-label {
    font-size: 1rem;
    line-height: 1.4;
    display: block;
  }

  /* Answers — image */
  .answers-grid--image {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .answer-btn--image {
    padding: 0;
    overflow: hidden;
    background: none;
  }
  .answer-btn--image:hover .answer-img-wrap img {
    transform: scale(1.05);
  }
  .answer-img-wrap {
    aspect-ratio: 4/3;
    overflow: hidden;
  }
  .answer-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .answer-btn--image .answer-label {
    padding: 0.875rem 1rem;
    font-size: 0.875rem;
    opacity: 0.8;
    background-color: var(--color-surface);
    color: var(--color-text);
    display: block;
    text-align: left;
  }

  /* Results */
  .results-block { border-top: 2px solid var(--color-border); }
  .results-inner {
    max-width: 1000px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }
  .result-name {
    font-size: var(--font-size-h1);
    margin-bottom: 0.5rem;
  }
  .result-tagline {
    font-size: 1.25rem;
    color: var(--color-brand-red);
    font-family: var(--font-heading);
    margin-bottom: 2.5rem;
    opacity: 0.9;
  }
  .result-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  .result-img-wrap {
    aspect-ratio: 4/3;
    overflow: hidden;
    border: 2px solid var(--color-border);
    box-shadow: 6px 6px 0 var(--color-brand-red);
    margin-bottom: 1rem;
  }
  .result-img-wrap img { width: 100%; height: 100%; object-fit: cover; }
  .result-palette {
    display: flex;
    gap: 0.5rem;
  }
  .result-palette :global(.swatch) {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .result-description {
    font-size: 1rem;
    line-height: 1.7;
    opacity: 0.85;
    margin-bottom: 2rem;
  }
  .materials-title {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 0.75rem;
  }
  .materials-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .materials-list li {
    font-size: 0.9rem;
    opacity: 0.8;
    padding-left: 1rem;
    position: relative;
  }
  .materials-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-brand-red);
  }
  .result-actions { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }

  /* How it works */
  .how-it-works {
    background-color: var(--color-surface);
    border-top: 3px solid var(--color-brand-black);
  }
  .how-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
  }
  .how-inner h2 { font-size: var(--font-size-h2); margin-bottom: 1.25rem; }
  .how-inner > p { opacity: 0.75; max-width: 620px; line-height: 1.7; margin-bottom: 3rem; }
  .how-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .how-num {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-brand-red);
    display: block;
    margin-bottom: 0.75rem;
  }
  .how-step h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }
  .how-step p { font-size: 0.875rem; opacity: 0.65; line-height: 1.5; }

  /* Buttons */
  .btn-primary {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: var(--color-brand-red);
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-red);
    box-shadow: 4px 4px 0 var(--color-dark);
    transition: box-shadow 0.1s, transform 0.1s;
    cursor: pointer;
  }
  .btn-primary:hover {
    box-shadow: 2px 2px 0 var(--color-dark);
    transform: translate(2px, 2px);
  }
  .btn-outline {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: transparent;
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-white);
    transition: background-color 0.15s, color 0.15s;
    cursor: pointer;
  }
  .btn-outline:hover {
    background-color: var(--color-brand-white);
    color: var(--color-brand-black);
  }

  @media (max-width: 700px) {
    .answers-grid--text,
    .answers-grid--image,
    .result-body { grid-template-columns: 1fr; }
