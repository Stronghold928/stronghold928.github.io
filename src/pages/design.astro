        image: 'https://images.unsplash.com/photo-1600121848594-d8644e57abab?w=600&auto=format&fit=crop&q=80',
        weights: { 'european-modern': 3 },
      },
      {
        label: 'Dark charcoal island, white perimeter, marble countertop, black window frames',
        image: 'https://images.unsplash.com/photo-1586023492125-27b2c045efd7?w=600&auto=format&fit=crop&q=80',
