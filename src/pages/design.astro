    question: 'Which bathroom do you love?',
    answers: [
      {
        label: 'Oak vanity, warm stone, matte black fixtures — organic and calm',
        image: 'https://images.unsplash.com/photo-1552321554-5fefe8c9ef14?w=600&auto=format&fit=crop&q=80',
        weights: { 'organic-modern': 3 },
      },
      {
