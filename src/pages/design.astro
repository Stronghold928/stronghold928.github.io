        label: 'Natural oak, warm textiles, earthy materials — grounded and alive',
        image: 'https://images.unsplash.com/photo-1567016432779-094069958ea5?w=600&auto=format&fit=crop&q=80',
        weights: { 'organic-modern': 3 },
      },
      {
        label: 'Layered, collected, warm plaster walls — timeless and full of character',
