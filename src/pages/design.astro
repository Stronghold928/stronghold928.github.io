        image: 'https://images.unsplash.com/photo-1600566752355-35792bedcfea?w=600&auto=format&fit=crop&q=80',
        weights: { 'european-modern': 3 },
      },
      {
        label: 'Dramatic pendant, bold dark table, clean proportions — elevated and intentional',
