---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import moodboardPhoto from '../assets/moodboard.webp';

// The quiz data keeps site-style paths ('/design/<style>/<room>.webp') because
// they are also used as lookup keys. This resolves each one to the processed
// asset so the images get a srcset instead of shipping full size to phones.
const designImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/design/**/*.webp',
  { eager: true }
);

function designImg(path: string): ImageMetadata {
  const key = `../assets${path}`;
  const mod = designImages[key];
  if (!mod) throw new Error(`Missing design image: ${path}`);
  return mod.default;
}

const styles = [
  {
    id: 'organic-modern',
    name: 'Organic Modern',
    tagline: 'Warm. Natural. Grounded.',
    description: 'Your home should feel alive, not assembled. Natural materials lead every decision: light oak, quartzite, linen, clay. Clean modern lines keep it current without going cold. Texture does the work that color usually does. Warm without tipping into rustic. Current without going sterile.',
    palette: ['#F0EBE1', '#C4B99A', '#6B7B5A', '#888880', '#2A2A2A'],
    paletteNames: ['Alabaster', 'Warm Taupe', 'Pewter Green', 'Warm Gray', 'Charcoal'],
    dna: [
      'Natural materials lead every decision: light oak, stone, linen, and clay over synthetic',
      'Clean architecture creates the "modern" half: no heavy molding, no ornate trim',
      'Light rift-sawn oak is the defining material. Use it in cabinetry, flooring, and ceilings.',
      'Texture does the heavy lifting: leathered stone, reeded cabinets, plaster walls, woven textiles',
    ],
    guardrails: [
      'Does this feel warm and grounded, or cold and sterile?',
      'Does it look like it came from nature, or a factory?',
      'Does it add texture and depth, or just visual noise?',
      'Will it still feel right in fifteen years?',
    ],
  },
  {
    id: 'european-modern',
    name: 'European Modern',
    tagline: 'Timeless. Layered. Quietly Sophisticated.',
    description: 'Your home should feel collected, like it has always been there. Warm plaster, classic tile, unlacquered brass, and arched details create a home with real soul. Not trendy. Not stark. Every surface carries something worth looking at. Every room invites you to stay longer than you meant to.',
    palette: ['#EEE8DE', '#B4A48C', '#6B5E4C', '#8A8880', '#2A2A2A'],
    paletteNames: ['White Dove', 'Stone Hearth', 'Warm Umber', 'Warm Gray', 'Charcoal'],
    dna: [
      'Tone is everything. This style is built on a feeling, not a trend. Ask: does this room have soul?',
      'White Dove at 50% strength on walls creates a softness no standard white can match',
      'Arch shapes and repeated details create continuity. Carry them from room to room.',
      'Hard finishes carry the character: zellige, checkered floors, leathered stone, plaster range hoods',
    ],
    guardrails: [
      'Does this feel collected and timeless, or trendy and temporary?',
      'Does it have texture, warmth, or character, or does it feel flat?',
      'Could this have lived in a beautiful home 50 years ago?',
      'Does it add depth and charm, or just visual noise?',
    ],
  },
  {
    id: 'transitional-modern',
    name: 'Transitional Modern',
    tagline: 'Classic Bones. Modern Edge. Built to Last.',
    description: 'Your home should feel elevated without feeling untouchable. Classic proportions, clean lines, and one or two intentional contrast moments that anchor each space. Dark cabinetry, a statement tile. Those bold calls land because everything around them stays warm and grounded.',
    palette: ['#EEE8DE', '#D0C9B4', '#3D3D3A', '#5A6673', '#4A5042'],
    paletteNames: ['White Dove', 'Pale Oak', 'Wrought Iron', 'Ocean Floor', 'Dark Olive'],
    dna: [
      'This style walks the line between classic and modern and does it with confidence',
      'White Dove at 50% on walls, full strength on trim creates built-in warmth throughout',
      'Contrast is the defining move: bold dark moments against soft, grounded backgrounds',
      'Clean architecture throughout: caseless trim, slim shaker profiles, nothing ornate',
    ],
    guardrails: [
      'Does this feel elevated and timeless, or trendy and dated?',
      'Does it balance classic character with a clean modern edge?',
      'Does it add contrast intentionally, or just create visual confusion?',
      'Could this piece live comfortably here for twenty years?',
    ],
  },
];

// The client script sets the reveal image, so each style carries the resolved
// asset URL rather than a path it would have to build at runtime.
const stylesWithCovers = styles.map(s => ({
  ...s,
  coverSrc: designImg(`/design/${s.id}/cover.webp`).src,
}));

const quizQuestions = [
  {
    id: 'q1',
    step: 1,
    type: 'image',
    question: 'Which exterior speaks to you?',
    answers: [
      {
        label: 'Black-framed gables, warm stone, natural unfussy landscaping',
        image: '/design/organic-modern/exterior.webp',
        weights: { 'organic-modern': 3 },
      },
      {
        label: 'White stucco, dark roofline, arched black-framed windows',
        image: '/design/european-modern/exterior.webp',
        weights: { 'european-modern': 3 },
      },
      {
        label: 'Modern farmhouse lines, wood accents, walls of glass',
        image: '/design/transitional-modern/exterior.webp',
        weights: { 'transitional-modern': 3 },
      },
    ],
  },
  {
    id: 'q2',
    step: 2,
    type: 'image',
    question: 'Which living room feels like home?',
    answers: [
      {
        label: 'Stacked stone fireplace, exposed beams, arched built-ins',
        image: '/design/organic-modern/livingroom.webp',
        weights: { 'organic-modern': 3 },
      },
      {
        label: 'Brass chandelier, gallery wall, warm collected furnishings',
        image: '/design/european-modern/livingroom.webp',
        weights: { 'european-modern': 3 },
      },
      {
        label: 'Moody accent wall, linear fireplace, clean modern lines',
        image: '/design/transitional-modern/livingroom.webp',
        weights: { 'transitional-modern': 3 },
      },
    ],
  },
  {
    id: 'q3',
    step: 3,
    type: 'image',
    question: 'Which kitchen is your dream kitchen?',
    answers: [
      {
        label: 'Light oak cabinetry, glass uppers, honed quartzite counters',
        image: '/design/organic-modern/kitchen.webp',
        weights: { 'organic-modern': 3 },
      },
      {
        label: 'Arched range hood, brass pendants, oak island with stools',
        image: '/design/european-modern/kitchen.webp',
        weights: { 'european-modern': 3 },
      },
      {
        label: 'Dark cabinetry, soapstone counters, black hood over the range',
        image: '/design/transitional-modern/kitchen.webp',
        weights: { 'transitional-modern': 3 },
      },
    ],
  },
  {
    id: 'q4',
    step: 4,
    type: 'image',
    question: 'Which bathroom do you love?',
    answers: [
      {
        label: 'Reeded wood vanity, walk-in shower, unlacquered brass',
        image: '/design/organic-modern/bathroom.webp',
        weights: { 'organic-modern': 3 },
      },
      {
        label: 'Vessel sink, aged mirror, soft warm plaster walls',
        image: '/design/european-modern/bathroom.webp',
        weights: { 'european-modern': 3 },
      },
      {
        label: 'Marble soaking tub, fluted tile, brushed brass fixtures',
        image: '/design/transitional-modern/bathroom.webp',
        weights: { 'transitional-modern': 3 },
      },
    ],
  },
  {
    id: 'q5',
    step: 5,
    type: 'image',
    question: 'Which bedroom resonates with you?',
    answers: [
      {
        label: 'Stone fireplace, wood mantle, linen bedding, soft light',
        image: '/design/organic-modern/bedroom.webp',
        weights: { 'organic-modern': 3 },
      },
      {
        label: 'Arched window, brass sconce, layered warm neutrals',
        image: '/design/european-modern/bedroom.webp',
        weights: { 'european-modern': 3 },
      },
      {
        label: 'Dark fireplace wall, marble accent, crisp white linens',
        image: '/design/transitional-modern/bedroom.webp',
        weights: { 'transitional-modern': 3 },
      },
    ],
  },
  {
    id: 'q6',
    step: 6,
    type: 'image',
    question: 'Which pantry catches your eye?',
    answers: [
      {
        label: 'Dark glass-front cabinetry, brass hardware, checkered floor',
        image: '/design/organic-modern/pantry.webp',
        weights: { 'organic-modern': 3 },
      },
      {
        label: 'Warm oak shelving, woven baskets, brass pendant light',
        image: '/design/european-modern/pantry.webp',
        weights: { 'european-modern': 3 },
      },
      {
        label: 'Glass sliding door, marble backsplash, patterned tile floor',
        image: '/design/transitional-modern/pantry.webp',
        weights: { 'transitional-modern': 3 },
      },
    ],
  },
  {
    id: 'q7',
    step: 7,
    type: 'image',
    question: 'Which laundry room fits your style?',
    answers: [
      {
        label: 'Navy cabinetry, open shelving, brass fixtures, natural light',
        image: '/design/organic-modern/laundry.webp',
        weights: { 'organic-modern': 3 },
      },
      {
        label: 'Marble backsplash, fluted pendant, soft warm cabinetry',
        image: '/design/european-modern/laundry.webp',
        weights: { 'european-modern': 3 },
      },
      {
        label: 'Light shaker cabinets, brass hardware, woven basket storage',
        image: '/design/transitional-modern/laundry.webp',
        weights: { 'transitional-modern': 3 },
      },
    ],
  },
];
---

<Layout
  title="Free Remodel Design Plan"
  description="Not sure what style you want for your remodel? Take Stronghold's free design quiz for an actionable plan: a named style, palette, and materials to build it."
>
  <!-- ═══════════════════════════════════════════════════════════ HERO -->
  <section class="selector-hero">
    <div class="selector-hero-inner">
      <div class="hero-content">
        <div class="hero-text">
          <p class="eyebrow">Guided Design</p>
          <h1>Know what you want <br /><span class="accent">before we break ground.</span></h1>
          <p class="hero-sub">
            Most people start a remodel with a vague idea and a Pinterest board. Stronghold's guided design
            process gives you something more useful: a complete design plan, a named style, a proven palette,
            and the exact materials and finishes that make it work, ready before any work starts.
          </p>

          <h2 class="hero-value-heading">What the design quiz gives you</h2>
          <div class="hero-value-grid">
            <div class="hero-value-item">
              <span class="hero-value-num">01</span>
              <h3 class="hero-value-title">Style Clarity</h3>
              <p class="hero-value-desc">You leave with a real answer, not just "modern-ish" or "warm but clean." A named style, a proven palette, and the specific materials and finishes that define it, ready to act on.</p>
            </div>
            <div class="hero-value-item">
              <span class="hero-value-num">02</span>
              <h3 class="hero-value-title">Right Decision Order</h3>
              <p class="hero-value-desc">Your style profile locks in real material principles, wood tones, stone types, paint formulas, so every choice you make afterward stays aligned instead of getting undone later.</p>
            </div>
            <div class="hero-value-item">
              <span class="hero-value-num">03</span>
              <h3 class="hero-value-title">Ready to Build On</h3>
              <p class="hero-value-desc">Your plan walks into every contractor meeting with you. No miscommunication, no costly surprises, no "I thought you meant something else" when the tile is already on the wall.</p>
            </div>
          </div>
        </div>

        <div class="hero-moodboard">
          <Image
            src={moodboardPhoto}
            alt="Interior design mood board with warm materials, organic textures, and elevated finishes"
            widths={[500, 995]}
            sizes="(max-width: 900px) 100vw, 500px"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <p class="moodboard-caption">Sample mood board</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ HOW IT WORKS -->
  <section class="how-it-works">
    <div class="how-inner">
      <p class="eyebrow">How It Works</p>
      <h2>An actionable plan, ready before you break ground.</h2>
      <p>Your style profile is a real design plan: a proven aesthetic, a defined material palette, and the specific finishes that make it work. We refine it to your exact space, budget, and what is available, but you are never starting from a blank page.</p>
      <div class="how-steps">
        <div class="how-step">
          <span class="how-num">01</span>
          <h3>Take the photo quiz</h3>
          <p>Seven photo-based questions about the spaces and styles that speak to you. No right or wrong answers. Just what resonates.</p>
        </div>
        <div class="how-step">
          <span class="how-num">02</span>
          <h3>See your style profile</h3>
          <p>Get your full profile: palette, design DNA, and the guardrail questions that filter every purchase decision you will ever make.</p>
        </div>
        <div class="how-step">
          <span class="how-num">03</span>
          <h3>Build with confidence</h3>
          <p>Walk into every contractor meeting with a real plan already in hand. Fewer surprises, faster decisions, and a finished home that actually reflects you.</p>
        </div>
      </div>
    </div>
  </section>

  <div id="selector-app" class="selector-app">

    <!-- ══════════════════════════════════════════════════ PHASE: QUIZ -->
    <div id="phase-quiz">

      <div class="quiz-section-header">
        <div class="quiz-section-header-inner">
          <p class="eyebrow">Style Quiz</p>
          <h2>Find your style in seven photos.</h2>
          <p>Each question shows real rooms in the three design styles Stronghold specializes in. Pick the space that feels like home, not what you think you should want.</p>
        </div>
      </div>

      <div class="progress-bar-wrap">
        <div class="progress-bar-inner">
          <div class="progress-fill" id="quiz-progress-fill" style="width:0%"></div>
        </div>
        <span class="progress-label" id="quiz-progress-label">Question 1 of 7</span>
      </div>

      <div id="quiz-questions-container">
        {quizQuestions.map((q, qi) => (
          <div
            class={`question-block ${qi === 0 ? 'question-block--active' : ''}`}
            id={`question-${q.id}`}
            data-step={q.step}
          >
            <div class="question-inner">
              <p class="question-num">Question {q.step} / {quizQuestions.length}</p>
              <h2 class="question-text">{q.question}</h2>
              <div class={`answers-grid ${q.type === 'image' ? 'answers-grid--image' : 'answers-grid--text'}`}>
                {q.answers.map((a, ai) => (
                  <button
                    class={`answer-btn ${q.type === 'image' ? 'answer-btn--image' : ''}`}
                    data-question={q.id}
                    data-answer={ai}
                    data-weights={JSON.stringify(a.weights)}
                  >
                    {q.type === 'image' && 'image' in a && (
                      <div class="answer-img-wrap">
                        <Image
                          src={designImg((a as any).image)}
                          alt={a.label}
                          widths={[240, 480]}
                          sizes="(max-width: 700px) 45vw, 260px"
                          loading="lazy"
                        />
                      </div>
                    )}
                    <span class="answer-label">{a.label}</span>
                  </button>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ════════════════════════════════════════════════ PHASE: REVEAL -->
    <div id="phase-reveal" style="display:none">
      <div class="reveal-inner">
        <p class="eyebrow">Your Design Plan</p>
        <h2 id="reveal-name" class="reveal-name">—</h2>
        <p id="reveal-tagline" class="reveal-tagline">—</p>
        <div class="reveal-cover-wrap">
          <img id="reveal-cover" class="reveal-cover" src="" alt="" width="1000" height="745" loading="eager" />
        </div>
        <div class="reveal-palette-wrap">
          <div class="reveal-palette" id="reveal-palette"></div>
        </div>
        <p id="reveal-description" class="reveal-description">—</p>
        <div class="reveal-dna-wrap">
          <p class="reveal-dna-title">Your Style DNA</p>
          <ul id="reveal-dna" class="reveal-dna"></ul>
        </div>
        <div class="reveal-guardrails-wrap">
          <p class="reveal-guardrails-title">Your Decision Filter</p>
          <ul id="reveal-guardrails" class="reveal-guardrails"></ul>
        </div>
        <div class="reveal-cta-callout">
          <p class="reveal-cta-callout-text">
            You now have a complete design plan: your style, your palette, and the material
            principles that define it. Bring this to your first conversation with Stronghold
            and we will know exactly how to build it.
          </p>
        </div>
        <div class="reveal-actions">
          <a id="contact-cta-btn" href="/quote/?ref=design-quiz" class="btn-primary">Get a Quote &rarr;</a>
          <button id="retake-quiz-btn" class="btn-outline">Retake Quiz</button>
        </div>
      </div>
    </div>

  </div>

</Layout>

<script define:vars={{ styles: stylesWithCovers, quizQuestions }}>
  // ─── State ────────────────────────────────────────────────────────────────
  const state = {
    quizStep: 1,
    scores: { 'organic-modern': 0, 'european-modern': 0, 'transitional-modern': 0 },
    selectedStyle: null,
  };

  const TOTAL_QUIZ = quizQuestions.length;

  // ─── Element refs ─────────────────────────────────────────────────────────
  const phaseQuiz   = document.getElementById('phase-quiz');
  const phaseReveal = document.getElementById('phase-reveal');

  // ─── Phase transitions ────────────────────────────────────────────────────
  function showPhase(phase) {
    [phaseQuiz, phaseReveal].forEach(el => {
      if (el) el.style.display = 'none';
    });
    if (phase === 'quiz')   { phaseQuiz.style.display   = 'block'; }
    if (phase === 'reveal') { phaseReveal.style.display = 'block'; }
    document.getElementById('selector-app').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // ─── QUIZ ─────────────────────────────────────────────────────────────────
  function updateQuizProgress(step) {
    const pct = ((step - 1) / TOTAL_QUIZ) * 100;
    document.getElementById('quiz-progress-fill').style.width = pct + '%';
    document.getElementById('quiz-progress-label').textContent =
      step <= TOTAL_QUIZ ? `Question ${step} of ${TOTAL_QUIZ}` : 'Complete';
  }

  function showQuizQuestion(step) {
    document.querySelectorAll('.question-block').forEach(el => el.classList.remove('question-block--active'));
    const target = document.querySelector(`#quiz-questions-container [data-step="${step}"]`);
    if (target) {
      target.classList.add('question-block--active');
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function finishQuiz() {
    const best = Object.entries(state.scores).sort((a, b) => b[1] - a[1])[0][0];
    state.selectedStyle = best;
    showReveal(best);
  }

  document.querySelectorAll('.answer-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const questionId = btn.dataset.question;
      const weights = JSON.parse(btn.dataset.weights);

      document.querySelectorAll(`[data-question="${questionId}"]`).forEach(b => b.classList.remove('answer-btn--selected'));
      btn.classList.add('answer-btn--selected');

      Object.entries(weights).forEach(([id, w]) => {
        state.scores[id] = (state.scores[id] || 0) + Number(w);
      });

      setTimeout(() => {
        if (state.quizStep < TOTAL_QUIZ) {
          state.quizStep++;
          updateQuizProgress(state.quizStep);
          showQuizQuestion(state.quizStep);
        } else {
          document.getElementById('quiz-progress-fill').style.width = '100%';
          document.getElementById('quiz-progress-label').textContent = 'Complete';
          setTimeout(finishQuiz, 300);
        }
      }, 280);
    });
  });

  updateQuizProgress(1);

  // ─── REVEAL ───────────────────────────────────────────────────────────────
  function showReveal(styleId) {
    const profile = styles.find(s => s.id === styleId);
    if (!profile) return;

    document.getElementById('reveal-name').textContent = profile.name;
    document.getElementById('reveal-tagline').textContent = profile.tagline;
    document.getElementById('reveal-description').textContent = profile.description;

    const coverEl = document.getElementById('reveal-cover');
    coverEl.src = profile.coverSrc;
    coverEl.alt = `${profile.name} mood board: room photos and paint palette`;

    const paletteEl = document.getElementById('reveal-palette');
    paletteEl.innerHTML = profile.palette.map((c, i) => `
      <div class="palette-swatch-wrap">
        <span class="palette-swatch" style="background:${c}"></span>
        <span class="palette-swatch-name">${profile.paletteNames[i]}</span>
      </div>
    `).join('');

    const dnaEl = document.getElementById('reveal-dna');
    dnaEl.innerHTML = profile.dna.map(d => `<li>${d}</li>`).join('');

    const guardrailsEl = document.getElementById('reveal-guardrails');
    guardrailsEl.innerHTML = profile.guardrails.map(g => `<li>${g}</li>`).join('');

    showPhase('reveal');
  }

  document.getElementById('retake-quiz-btn')?.addEventListener('click', () => {
    state.scores = { 'organic-modern': 0, 'european-modern': 0, 'transitional-modern': 0 };
    state.quizStep = 1;
    state.selectedStyle = null;
    document.querySelectorAll('.answer-btn').forEach(b => b.classList.remove('answer-btn--selected'));
    document.querySelectorAll('.question-block').forEach(el => el.classList.remove('question-block--active'));
    updateQuizProgress(1);
    showQuizQuestion(1);
    showPhase('quiz');
  });
</script>

<style>
  /* ─── Hero ─────────────────────────────────────────────────────────────── */
  .selector-hero {
    padding: 6rem 1.5rem 5rem;
    border-bottom: 2px solid var(--color-border);
  }
  .selector-hero-inner { max-width: 1200px; margin: 0 auto; }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 4rem;
    align-items: start;
  }

  .hero-moodboard {
    position: sticky;
    top: 88px;
  }
  .hero-moodboard picture { display: block; }
  .hero-moodboard img {
    width: 100%;
    height: auto;
    display: block;
    border: 2px solid var(--color-border);
    box-shadow: 8px 8px 0 var(--color-border);
  }
  .moodboard-caption {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.35;
    margin-top: 0.75rem;
    text-align: right;
  }

  .eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 1rem;
  }
  .selector-hero h1 { font-size: var(--font-size-h1); margin-bottom: 1.25rem; }
  .accent { color: var(--color-brand-red); }
  .hero-sub {
    font-size: 1.1rem;
    opacity: 0.7;
    max-width: 620px;
    line-height: 1.7;
    margin-bottom: 3rem;
  }

  .hero-value-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 2px solid var(--color-border);
  }
  .hero-value-item {
    padding: 1.5rem 2rem;
    border-bottom: 2px solid var(--color-border);
  }
  .hero-value-item:last-child { border-bottom: none; }
  .hero-value-num {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    display: block;
    margin-bottom: 0.75rem;
  }
  .hero-value-heading {
    font-size: var(--font-size-h3);
    margin: 2.5rem 0 1.25rem;
  }

  .hero-value-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }
  .hero-value-desc {
    font-size: 0.875rem;
    line-height: 1.65;
    opacity: 0.7;
    margin: 0;
  }

