        weights: { 'transitional-modern': 3 },
      },
    ],
  },
  {
    id: 'q4',
    step: 4,
    type: 'image',
    question: 'Which bedroom resonates with you?',
    answers: [
      {
        label: 'Linen bedding, oak tones, natural textures — warm and effortlessly calm',
        image: 'https://images.unsplash.com/photo-1616594039964-ae9021a400a0?w=600&auto=format&fit=crop&q=80',
