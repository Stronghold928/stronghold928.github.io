---
import Layout from '../../layouts/Layout.astro';

const faqItems = [
  {
    question: "How long does a bathroom remodel take?",
    answer: "A standard bathroom typically takes 3–5 weeks. A larger master suite with custom tile and radiant floor heating can take 6–8 weeks."
  },
  {
    question: "Can you expand a bathroom by absorbing a closet or hallway?",
    answer: "Yes. We handle the structural and plumbing work required to expand a footprint. We'll tell you upfront what it adds to the scope."
  },
  {
    question: "Do you use Schluter waterproofing systems?",
    answer: "Yes. For wet areas we use either Schluter KERDI or RedGard, both are industry-standard and far more reliable than felt paper or plastic sheet."
  },
  {
    question: "Do bathroom remodels require permits?",
    answer: "Electrical and plumbing work requires permits. We pull them and handle the inspections."
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Bathroom Remodel in Flagstaff, AZ",
  "provider": {
    "@type": "GeneralContractor",
    "name": "Stronghold Construction",
    "url": "https://builtstronghold.com"
  },
  "areaServed": "Flagstaff, AZ and Northern Arizona",
  "description": "Custom bathroom remodeling in Flagstaff, AZ by Stronghold Construction. Walk-in showers, soaking tubs, dual vanities. Full scope, licensed work, honest pricing across northern Arizona."
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Layout
  title="Bathroom Remodel in Flagstaff, AZ | Stronghold Construction"
  description="Custom bathroom remodeling in Flagstaff, AZ by Stronghold Construction. Walk-in showers, soaking tubs, dual vanities. Full scope, licensed work, honest pricing across northern Arizona."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Bathroom Remodeling</p>
      <h1>Bathroom Remodel in Flagstaff, AZ</h1>
      <p class="hero-desc">Bathroom remodels are where design vision meets technical complexity. Waterproofing, tile work, plumbing, and electrical all have to be done right, not just look right. We do the whole project.</p>
      <div class="hero-actions">
        <a href="/contact" class="btn-primary">Get a Free Quote &rarr;</a>
        <a href="/quote" class="btn-outline">Start Your Project &rarr;</a>
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="includes-section">
    <div class="section-inner">
      <div class="includes-content">
        <div class="includes-text">
          <p class="eyebrow">Scope of Work</p>
          <h2>What a bathroom remodel includes</h2>
          <p class="section-desc">From waterproofing substrate to finish tile and fixtures, we handle the full scope. No gaps, no subcontracting the hard parts.</p>
        </div>
        <ul class="includes-list">
          <li>Waterproofing substrate (Schluter KERDI, RedGard, or cement board)</li>
          <li>Shower/tub demolition and build</li>
          <li>Curbless or curbed shower construction</li>
          <li>Walk-in shower and linear drain options</li>
          <li>Freestanding or alcove tub installation</li>
          <li>Tile: floor and wall</li>
          <li>Custom niches and built-ins</li>
          <li>Vanity and sink installation</li>
          <li>Mirror and lighting</li>
          <li>Radiant floor heating (Schluter Ditra-Heat or equivalent)</li>
          <li>Ventilation</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="process-section">
    <div class="section-inner">
      <p class="eyebrow">Our Process</p>
      <h2>How it works with Stronghold</h2>
      <div class="steps-grid">
        <div class="step">
          <span class="step-num">1</span>
          <div class="step-body">
            <h3 class="step-title">Discovery & Design</h3>
            <p class="step-desc">We walk the space, talk budget, and figure out what you actually want.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">2</span>
          <div class="step-body">
            <h3 class="step-title">Detailed Quote</h3>
            <p class="step-desc">Line-itemized, written before any work starts.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">3</span>
          <div class="step-body">
            <h3 class="step-title">Permitted Build</h3>
            <p class="step-desc">Permits pulled, inspections scheduled. Crew shows up on time.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">4</span>
          <div class="step-body">
            <h3 class="step-title">Walkthrough & Punch</h3>
            <p class="step-desc">We go through every item together before we call it done.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cost Guidance -->
  <section class="cost-section">
    <div class="section-inner">
      <div class="cost-inner">
        <div class="cost-text">
          <p class="eyebrow">Cost Guidance</p>
          <h2>What does a bathroom remodel cost in Flagstaff?</h2>
          <p>A basic bathroom remodel in Flagstaff (tile replacement, new fixtures, same footprint) runs $12,000–$22,000. A full master bath suite with walk-in shower, soaking tub, dual vanity, and radiant heat typically runs $28,000–$55,000.</p>
          <p>We've done both. Real numbers come after the site walk.</p>
        </div>
        <div class="cost-note">
          <p class="note-label">These are ranges, not quotes.</p>
          <p>Every bathroom is different. The only way to get a real number is a site walk. We don't charge for that.</p>
          <a href="/contact" class="btn-primary">Schedule a Site Walk &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <div class="section-inner">
      <p class="eyebrow">Common Questions</p>
      <h2>Bathroom remodel FAQ</h2>
      <div class="faq-list">
        {faqItems.map(item => (
          <div class="faq-item">
            <h3 class="faq-q">{item.question}</h3>
            <p class="faq-a">{item.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="section-inner cta-inner">
      <div class="cta-text">
        <p class="eyebrow eyebrow--light">Get Started</p>
        <h2>Ready for an honest quote on your bathroom?</h2>
        <p class="cta-sub">We'll do a site walk, look at what's actually needed, and put together an itemized written quote. No lump sums, no surprises. We respond within one business day.</p>
      </div>
      <div class="cta-actions">
        <a href="tel:+19283007345" class="btn-phone">
          <span class="btn-phone-label">Call us directly</span>
          <span class="btn-phone-number">(928) 300-7345</span>
        </a>
        <a href="/contact" class="btn-quote">Request a Written Quote &rarr;</a>
        <p class="cta-note">No obligation. Mon–Fri 9am–4pm.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    border-bottom: 2px solid var(--color-border);
    background-color: var(--color-dark);
    color: var(--color-brand-white);
  }
  .hero-inner {
    max-width: 780px;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }
  .hero h1 {
    font-size: var(--font-size-h1);
    line-height: 1.1;
    margin: 0.75rem 0 1.25rem;
    color: var(--color-brand-white);
  }
  .hero-desc {
    font-size: 1.05rem;
    line-height: 1.75;
    opacity: 0.75;
    max-width: 620px;
    margin-bottom: 2rem;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Shared */
  .eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
  }
  .eyebrow--light {
    color: rgba(255,255,255,0.6);
  }
  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
  }

  /* Includes */
  .includes-section {
    border-bottom: 2px solid var(--color-border);
    background-color: var(--color-surface);
  }
  .includes-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  .includes-text h2 {
    font-size: var(--font-size-h2);
    margin: 0.75rem 0 1rem;
  }
  .section-desc {
    font-size: 0.95rem;
    line-height: 1.7;
    opacity: 0.7;
  }
  .includes-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 2px solid var(--color-border);
  }
  .includes-list li {
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.95rem;
    position: relative;
    padding-left: 2rem;
  }
  .includes-list li:last-child {
    border-bottom: none;
  }
  .includes-list li::before {
    content: '→';
    position: absolute;
    left: 0.75rem;
    color: var(--color-brand-red);
    font-weight: 700;
  }

  /* Process */
  .process-section {
    border-bottom: 2px solid var(--color-border);
  }
  .process-section h2 {
    font-size: var(--font-size-h2);
    margin: 0.75rem 0 3rem;
  }
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
  }
  .step {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .step-num {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-brand-red);
    line-height: 1;
    flex-shrink: 0;
  }
  .step-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }
  .step-desc {
    font-size: 0.85rem;
    opacity: 0.65;
    line-height: 1.55;
  }

  /* Cost */
  .cost-section {
    border-bottom: 2px solid var(--color-border);
    background-color: var(--color-surface);
  }
  .cost-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: start;
  }
  .cost-text h2 {
    font-size: var(--font-size-h2);
    margin: 0.75rem 0 1.25rem;
  }
  .cost-text p {
    font-size: 0.975rem;
    line-height: 1.75;
    margin-bottom: 1rem;
    opacity: 0.8;
  }
  .cost-note {
    background-color: var(--color-brand-white);
    border: 2px solid var(--color-border);
    padding: 2rem;
    min-width: 280px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .note-label {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-red);
  }
  .cost-note p:not(.note-label) {
    font-size: 0.875rem;
    line-height: 1.6;
    opacity: 0.7;
  }

  /* FAQ */
  .faq-section {
    border-bottom: 2px solid var(--color-border);
  }
  .faq-section h2 {
    font-size: var(--font-size-h2);
    margin: 0.75rem 0 2.5rem;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 2px solid var(--color-border);
  }
  .faq-item {
    padding: 1.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .faq-item:last-child {
    border-bottom: none;
  }
  .faq-q {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
  }
  .faq-a {
    font-size: 0.925rem;
    line-height: 1.7;
    opacity: 0.72;
  }

  /* CTA */
  .cta-section {
    background-color: var(--color-brand-red);
    border-top: 3px solid var(--color-brand-black);
    border-bottom: 3px solid var(--color-brand-black);
    color: var(--color-brand-white);
  }
  .cta-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
  }
  .cta-text h2 {
    font-size: var(--font-size-h2);
    color: var(--color-brand-white);
    margin: 0.75rem 0 1rem;
  }
  .cta-sub {
    color: rgba(255,255,255,0.8);
    font-size: 0.95rem;
    line-height: 1.65;
    max-width: 540px;
  }
  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    min-width: 260px;
  }
  .btn-phone {
    display: flex;
    flex-direction: column;
    background-color: var(--color-brand-white);
    color: var(--color-brand-black);
    padding: 1rem 1.5rem;
    border: 2px solid var(--color-brand-white);
    box-shadow: 4px 4px 0 rgba(0,0,0,0.25);
    transition: box-shadow 0.1s, transform 0.1s;
    width: 100%;
  }
  .btn-phone:hover {
    box-shadow: 2px 2px 0 rgba(0,0,0,0.25);
    transform: translate(2px, 2px);
  }
  .btn-phone-label {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.5;
  }
  .btn-phone-number {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .btn-quote {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.5rem;
    background-color: transparent;
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-white);
    box-shadow: 4px 4px 0 rgba(0,0,0,0.2);
    transition: background-color 0.15s, color 0.15s, box-shadow 0.1s, transform 0.1s;
    width: 100%;
    text-align: center;
  }
  .btn-quote:hover {
    background-color: var(--color-brand-white);
    color: var(--color-brand-red);
    box-shadow: 2px 2px 0 rgba(0,0,0,0.2);
    transform: translate(2px, 2px);
  }
  .cta-note {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.55);
    line-height: 1.4;
  }

  /* Buttons */
  .btn-primary {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: var(--color-brand-red);
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-red);
    box-shadow: 4px 4px 0 var(--color-dark);
    transition: box-shadow 0.1s, transform 0.1s;
  }
  .btn-primary:hover {
    box-shadow: 2px 2px 0 var(--color-dark);
    transform: translate(2px, 2px);
  }
  .btn-outline {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: transparent;
    color: var(--color-brand-white);
    border: 2px solid rgba(255,255,255,0.4);
    transition: border-color 0.15s, background-color 0.15s;
  }
  .btn-outline:hover {
    border-color: var(--color-brand-white);
    background-color: rgba(255,255,255,0.1);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .includes-content {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .cost-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .cost-note {
      min-width: auto;
      width: 100%;
    }
    .cta-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .cta-actions {
      min-width: auto;
      width: 100%;
    }
  }

  @media (max-width: 600px) {
    .hero-actions {
      flex-direction: column;
    }
    .hero-actions .btn-primary,
    .hero-actions .btn-outline {
      width: 100%;
      text-align: center;
    }
    .steps-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
