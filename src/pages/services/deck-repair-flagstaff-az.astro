---
import Layout from '../../layouts/Layout.astro';

const faqItems = [
  {
    question: "Does deck repair or replacement require a permit in Flagstaff?",
    answer: "Structural repairs and new deck construction above 30 inches from grade require permits. We pull them when required."
  },
  {
    question: "How do I know if my deck needs repair or full replacement?",
    answer: "If the ledger, posts, or footings are compromised, replacement is usually more cost-effective than extensive repair. We'll give you an honest condition report before recommending either."
  },
  {
    question: "What decking material do you recommend for Flagstaff's climate?",
    answer: "Composite decking (Trex, TimberTech, or equivalent) holds up better than untreated pine at altitude. Pressure-treated lumber is viable if properly maintained. We'll discuss the tradeoffs with you."
  },
  {
    question: "Do you build new decks from scratch?",
    answer: "Yes. New deck construction is part of our scope. We handle design, permitting, footings, framing, and finish."
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Deck Repair & Construction in Flagstaff, AZ",
  "provider": {
    "@type": "GeneralContractor",
    "name": "Stronghold Construction",
    "url": "https://builtstronghold.com"
  },
  "areaServed": "Flagstaff, AZ and Northern Arizona",
  "description": "Licensed deck repair, replacement, and new deck construction in Flagstaff, AZ by Stronghold Construction. Structural diagnosis, permitted work, real fixes across northern Arizona."
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Layout
  title="Deck Repair & Construction in Flagstaff, AZ"
  description="Licensed deck repair, replacement, and new deck construction in Flagstaff, AZ. Structural diagnosis, permitted work, real fixes."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Deck Repair & Construction</p>
      <h1>Deck Repair & Construction in Flagstaff, AZ</h1>
      <p class="hero-desc">Flagstaff's altitude and winter conditions are hard on decks. Freeze-thaw cycles attack ledger connections, post footings, and deck boards. Most decks we're called to "repair" actually have a structural story worth understanding before patching the visible symptom.</p>
      <div class="hero-actions">
        <a href="/contact" class="btn-primary">Get a Free Assessment &rarr;</a>
        <a href="/quote" class="btn-outline">Start Your Project &rarr;</a>
      </div>
    </div>
  </section>

  <!-- What We Handle -->
  <section class="includes-section">
    <div class="section-inner">
      <div class="includes-content">
        <div class="includes-text">
          <p class="eyebrow">Scope of Work</p>
          <h2>What we handle</h2>
          <p class="section-desc">We start with an honest structural assessment, then recommend repair or replacement based on what we actually find, not what's easiest to sell.</p>
        </div>
        <ul class="includes-list">
          <li>Structural assessment and written condition report</li>
          <li>Ledger board repair and through-bolting</li>
          <li>Post and footing replacement</li>
          <li>Joist and beam replacement</li>
          <li>Decking board replacement (composite or treated lumber)</li>
          <li>Railing replacement and code compliance</li>
          <li>Full deck replacement</li>
          <li>New deck construction</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Flagstaff-Specific Considerations -->
  <section class="local-section">
    <div class="section-inner">
      <div class="local-inner">
        <p class="eyebrow">Flagstaff Climate Factors</p>
        <h2>Why Flagstaff decks fail, and what we do about it</h2>
        <div class="local-content">
          <p>At Flagstaff's elevation, deck footings must go below the 24-inch frost line. Ledger connections to the house must be flashed and sealed against ice and snow. We also see accelerated UV degradation. Flagstaff's sun at altitude is hard on untreated wood and lower-grade composites.</p>
          <p>When we assess a deck, we're looking at the full picture: footing depth, ledger attachment, post condition, and material quality. A surface-level board replacement on a structurally compromised deck is money wasted. We'll tell you which situation you're in before any work starts.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="process-section">
    <div class="section-inner">
      <p class="eyebrow">Our Process</p>
      <h2>How it works with Stronghold</h2>
      <div class="steps-grid">
        <div class="step">
          <span class="step-num">1</span>
          <div class="step-body">
            <h3 class="step-title">Structural Assessment</h3>
            <p class="step-desc">We look at the full structure: footings, ledger, posts, joists, and surface. Written condition report included.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">2</span>
          <div class="step-body">
            <h3 class="step-title">Honest Recommendation</h3>
            <p class="step-desc">Repair or replace, we tell you which makes sense and why, with a line-itemized quote either way.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">3</span>
          <div class="step-body">
            <h3 class="step-title">Permitted Build</h3>
            <p class="step-desc">Permits pulled when required. Inspections scheduled. Work done to code.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">4</span>
          <div class="step-body">
            <h3 class="step-title">Walkthrough & Punch</h3>
            <p class="step-desc">We go through every item together before we call it done.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cost Guidance -->
  <section class="cost-section">
    <div class="section-inner">
      <div class="cost-inner">
        <div class="cost-text">
          <p class="eyebrow">Cost Guidance</p>
          <h2>What does deck repair or replacement cost in Flagstaff?</h2>
          <p>Deck repairs range widely. A straightforward ledger repair and board replacement might run $3,000–$8,000. A full deck replacement typically runs $18,000–$35,000 depending on size and materials.</p>
          <p>A new deck build on a complex lot can exceed that. We'll give you a real number after looking at the structure.</p>
        </div>
        <div class="cost-note">
          <p class="note-label">These are ranges, not quotes.</p>
          <p>The only way to get a real number is to look at the deck. We don't charge for the assessment or the quote.</p>
          <a href="/contact" class="btn-primary">Schedule an Assessment &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <div class="section-inner">
      <p class="eyebrow">Common Questions</p>
      <h2>Deck repair & construction FAQ</h2>
      <div class="faq-list">
        {faqItems.map(item => (
          <div class="faq-item">
            <h3 class="faq-q">{item.question}</h3>
            <p class="faq-a">{item.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="section-inner cta-inner">
      <div class="cta-text">
        <p class="eyebrow eyebrow--light">Get Started</p>
        <h2>Ready for an honest assessment of your deck?</h2>
        <p class="cta-sub">We'll look at the full structure, give you a written condition report, and put together an itemized quote. No lump sums, no surprises. We respond within one business day.</p>
      </div>
      <div class="cta-actions">
        <a href="tel:+19289627535" class="btn-phone">
          <span class="btn-phone-label">Call us directly</span>
          <span class="btn-phone-number">(928) 962-7535</span>
        </a>
        <a href="/contact" class="btn-quote">Request a Written Quote &rarr;</a>
        <p class="cta-note">No obligation. Mon–Fri 9am–4pm.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    border-bottom: 2px solid var(--color-border);
    background-color: var(--color-dark);
    color: var(--color-brand-white);
  }
  .hero-inner {
    max-width: 780px;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }
  .hero h1 {
    font-size: var(--font-size-h1);
    line-height: 1.1;
    margin: 0.75rem 0 1.25rem;
    color: var(--color-brand-white);
  }
  .hero-desc {
    font-size: 1.05rem;
    line-height: 1.75;
    opacity: 0.75;
    max-width: 620px;
    margin-bottom: 2rem;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Shared */
  .eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
  }
  .eyebrow--light {
    color: rgba(255,255,255,0.6);
  }
  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
  }

  /* Includes */
  .includes-section {
    border-bottom: 2px solid var(--color-border);
    background-color: var(--color-surface);
  }
  .includes-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  .includes-text h2 {
    font-size: var(--font-size-h2);
    margin: 0.75rem 0 1rem;
  }
  .section-desc {
    font-size: 0.95rem;
    line-height: 1.7;
    opacity: 0.7;
  }
  .includes-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 2px solid var(--color-border);
  }
  .includes-list li {
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.95rem;
    position: relative;
    padding-left: 2rem;
  }
  .includes-list li:last-child {
    border-bottom: none;
  }
  .includes-list li::before {
    content: '→';
    position: absolute;
    left: 0.75rem;
    color: var(--color-brand-red);
    font-weight: 700;
  }

  /* Local considerations */
  .local-section {
    border-bottom: 2px solid var(--color-border);
  }
  .local-inner h2 {
    font-size: var(--font-size-h2);
    margin: 0.75rem 0 2rem;
    max-width: 700px;
  }
  .local-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    border-left: 4px solid var(--color-brand-red);
    padding-left: 1.5rem;
  }
  .local-content p {
    font-size: 0.975rem;
    line-height: 1.75;
    opacity: 0.78;
  }

  /* Process */
  .process-section {
    border-bottom: 2px solid var(--color-border);
    background-color: var(--color-surface);
  }
  .process-section h2 {
    font-size: var(--font-size-h2);
    margin: 0.75rem 0 3rem;
  }
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
  }
  .step {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .step-num {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-brand-red);
    line-height: 1;
    flex-shrink: 0;
  }
  .step-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }
  .step-desc {
    font-size: 0.85rem;
    opacity: 0.65;
    line-height: 1.55;
  }

  /* Cost */
  .cost-section {
    border-bottom: 2px solid var(--color-border);
  }
  .cost-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: start;
  }
  .cost-text h2 {
    font-size: var(--font-size-h2);
    margin: 0.75rem 0 1.25rem;
  }
  .cost-text p {
    font-size: 0.975rem;
    line-height: 1.75;
    margin-bottom: 1rem;
    opacity: 0.8;
  }
  .cost-note {
    background-color: var(--color-surface);
    border: 2px solid var(--color-border);
    padding: 2rem;
    min-width: 280px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .note-label {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-red);
  }
  .cost-note p:not(.note-label) {
    font-size: 0.875rem;
    line-height: 1.6;
    opacity: 0.7;
  }

  /* FAQ */
  .faq-section {
    border-bottom: 2px solid var(--color-border);
    background-color: var(--color-surface);
  }
  .faq-section h2 {
    font-size: var(--font-size-h2);
    margin: 0.75rem 0 2.5rem;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 2px solid var(--color-border);
  }
  .faq-item {
    padding: 1.75rem;
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-brand-white);
  }
  .faq-item:last-child {
    border-bottom: none;
  }
  .faq-q {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
  }
  .faq-a {
    font-size: 0.925rem;
    line-height: 1.7;
    opacity: 0.72;
  }

  /* CTA */
  .cta-section {
    background-color: var(--color-brand-red);
    border-top: 3px solid var(--color-brand-black);
    border-bottom: 3px solid var(--color-brand-black);
    color: var(--color-brand-white);
  }
  .cta-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
  }
  .cta-text h2 {
    font-size: var(--font-size-h2);
    color: var(--color-brand-white);
    margin: 0.75rem 0 1rem;
  }
  .cta-sub {
    color: rgba(255,255,255,0.8);
    font-size: 0.95rem;
    line-height: 1.65;
    max-width: 540px;
  }
  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    min-width: 260px;
  }
  .btn-phone {
    display: flex;
    flex-direction: column;
    background-color: var(--color-brand-white);
    color: var(--color-brand-black);
    padding: 1rem 1.5rem;
    border: 2px solid var(--color-brand-white);
    box-shadow: 4px 4px 0 rgba(0,0,0,0.25);
    transition: box-shadow 0.1s, transform 0.1s;
    width: 100%;
  }
  .btn-phone:hover {
    box-shadow: 2px 2px 0 rgba(0,0,0,0.25);
    transform: translate(2px, 2px);
  }
  .btn-phone-label {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.5;
  }
  .btn-phone-number {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .btn-quote {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.5rem;
    background-color: transparent;
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-white);
    box-shadow: 4px 4px 0 rgba(0,0,0,0.2);
    transition: background-color 0.15s, color 0.15s, box-shadow 0.1s, transform 0.1s;
    width: 100%;
    text-align: center;
  }
  .btn-quote:hover {
    background-color: var(--color-brand-white);
    color: var(--color-brand-red);
    box-shadow: 2px 2px 0 rgba(0,0,0,0.2);
    transform: translate(2px, 2px);
  }
  .cta-note {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.55);
    line-height: 1.4;
  }

  /* Buttons */
  .btn-primary {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: var(--color-brand-red);
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-red);
    box-shadow: 4px 4px 0 var(--color-dark);
    transition: box-shadow 0.1s, transform 0.1s;
  }
  .btn-primary:hover {
    box-shadow: 2px 2px 0 var(--color-dark);
    transform: translate(2px, 2px);
  }
  .btn-outline {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: transparent;
    color: var(--color-brand-white);
    border: 2px solid rgba(255,255,255,0.4);
    transition: border-color 0.15s, background-color 0.15s;
  }
  .btn-outline:hover {
    border-color: var(--color-brand-white);
    background-color: rgba(255,255,255,0.1);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .includes-content {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .local-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .cost-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .cost-note {
      min-width: auto;
      width: 100%;
    }
    .cta-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .cta-actions {
      min-width: auto;
      width: 100%;
    }
  }

  @media (max-width: 600px) {
    .hero-actions {
      flex-direction: column;
    }
    .hero-actions .btn-primary,
    .hero-actions .btn-outline {
      width: 100%;
      text-align: center;
    }
    .steps-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
