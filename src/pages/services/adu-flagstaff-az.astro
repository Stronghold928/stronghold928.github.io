---
import Layout from '../../layouts/Layout.astro';

/**
 * Answers only Derek has. Held as string constants because a literal `{{ }}` in
 * markup is parsed as a JSX expression and fails the build — and because keeping
 * them in one object makes it obvious at the top of the file that the page is
 * not finished. Every one of these has to be replaced before the `noindex` prop
 * comes off and the nav entry in `services.ts` is uncommented.
 */
const TODO = {
  experience:
    '{{TODO-DEREK: Has Stronghold completed any ADUs in Coconino County? How many, what type (detached, garage conversion, above-garage, attached), and is there one we can name or photograph? If the answer is none, say so and this paragraph gets rewritten around the addition and new-construction work instead.}}',
  types:
    '{{TODO-DEREK: Which of these do we actually take on? Detached ground-up ADUs specifically — yes or no? The home addition page already claims attached ADUs, so that one is settled; the rest of this list is unconfirmed.}}',
  design:
    '{{TODO-DEREK: Do we produce the ADU plan set in-house, or does the homeowner need an architect or designer first? New construction says we can work from an architect drawings or refer out. Same answer here?}}',
  zoning:
    '{{TODO-DEREK: Flagstaff ADU ordinance — need the real specifics before any of this goes in writing: are detached ADUs allowed by right in the zones we work in, what is the maximum size, is there an owner-occupancy requirement, and is there a parking requirement? Do not paraphrase the ordinance from memory.}}',
  county:
    '{{TODO-DEREK: Unincorporated Coconino County is a different rulebook from the City of Flagstaff. What applies on county parcels — guest house vs. ADU definitions, septic capacity, well sharing? Which of the two do we get asked about more?}}',
  rental:
    '{{TODO-DEREK: Can a Flagstaff ADU be rented, and does the city restrict short-term rental of one? This is the first question most owners ask and the one we can least afford to get wrong.}}',
  cost:
    '{{TODO-DEREK: Cost ranges. Need a per-square-foot range for a detached ADU and for a garage conversion, plus the big swing factors (utility runs, site access, whether the existing electrical service has headroom). The kitchen and addition pages both carry ranges, so this section looks broken without one.}}',
  timeline:
    '{{TODO-DEREK: Realistic schedule from permit application to certificate of occupancy for a detached ADU, and separately for a garage conversion.}}',
};

const faqItems = [
  {
    question: "What is an ADU?",
    answer: "An accessory dwelling unit is a second, self-contained home on a lot that already has one. It has its own kitchen, bathroom, and entrance, which is what separates it from a spare bedroom or a finished basement. Detached casitas, garage conversions, and above-garage units are all ADUs."
  },
  {
    question: "Can I build an ADU on my lot in Flagstaff?",
    answer: `That depends on your zoning, your lot, and your existing utilities. ${TODO.zoning}`
  },
  {
    question: "Do you build detached ADUs, or only attached ones?",
    answer: TODO.types
  },
  {
    question: "Do ADUs require permits?",
    answer: "Yes. An ADU is a dwelling, so it pulls a full permit set: structural, electrical, plumbing, and mechanical, plus the utility connections. We pull the permits and manage the inspection schedule the same way we do on an addition or a new build."
  },
  {
    question: "What does an ADU cost to build in Flagstaff?",
    answer: TODO.cost
  },
  {
    question: "Can I rent out an ADU once it's built?",
    answer: TODO.rental
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "ADU Construction in Flagstaff, AZ",
  "@id": "https://builtstronghold.com/services/adu-flagstaff-az/#service",
  "provider": { "@id": "https://builtstronghold.com/#organization" },
  "areaServed": "Flagstaff, AZ and Northern Arizona",
  "description": "Accessory dwelling unit construction in Flagstaff, AZ by Stronghold Construction. Detached units, garage conversions, and attached ADUs: foundation, framing, envelope, utility connections, and permitting."
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://builtstronghold.com/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://builtstronghold.com/services/" },
    { "@type": "ListItem", "position": 3, "name": "ADU Construction in Flagstaff, AZ", "item": "https://builtstronghold.com/services/adu-flagstaff-az/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Layout
  title="ADU Construction in Flagstaff, AZ"
  description="Accessory dwelling unit construction in Flagstaff, AZ. Licensed general contractor handling foundation, framing, utilities, and permitting across northern Arizona."
  noindex
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Accessory Dwelling Units</p>
      <h1>ADU Construction in Flagstaff, AZ</h1>
      <p class="hero-desc">An ADU is a second, self-contained home on a lot that already has one: a detached casita, a garage conversion, a unit above the garage. Its own kitchen, its own bathroom, its own entrance. That makes it a dwelling rather than an addition, and it gets built, permitted, and inspected like one.</p>
      <p class="hero-desc">{TODO.experience}</p>
      <div class="hero-actions">
        <a href="/quote/" class="btn-primary">Get a Free Quote &rarr;</a>
        <a href="/design/" class="btn-outline">Start Your Design &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Types & Scope -->
  <section class="includes-section">
    <div class="section-inner">
      <div class="includes-content">
        <div class="includes-text">
          <p class="eyebrow">Types of ADU</p>
          <h2>What we handle</h2>
          <p class="section-desc">An ADU sits between a <a href="/services/home-addition-flagstaff-az/">home addition</a> and a <a href="/services/new-construction/">ground-up build</a>. It carries the structural work of the second and the tie-in problems of the first, which is why the utility side usually drives the schedule.</p>
          <p class="section-desc">{TODO.types}</p>
        </div>
        <div class="two-col-lists">
          <div>
            <p class="list-label">ADU types</p>
            <ul class="includes-list">
              <li>Detached ADUs and casitas</li>
              <li>Garage conversions</li>
              <li>Above-garage units</li>
              <li>Attached ADUs built as an addition</li>
              <li>Basement conversions with a separate entrance</li>
            </ul>
          </div>
          <div>
            <p class="list-label">Scope of work</p>
            <ul class="includes-list">
              <li>Site work and foundation</li>
              <li>Framing, envelope, and roofing</li>
              <li>Electrical service and subpanel</li>
              <li>Water and sewer or septic connection</li>
              <li>HVAC and insulation to Arizona Energy Code</li>
              <li>Kitchen and bathroom fit-out</li>
              <li>Exterior materials matched to the main house</li>
              <li>Permits and the full inspection schedule</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Zoning & Permitting -->
  <section class="zoning-section">
    <div class="section-inner">
      <div class="zoning-inner">
        <div class="zoning-text">
          <p class="eyebrow">Zoning &amp; Permitting</p>
          <h2>Whether you can build one comes first</h2>
          <p>Every other question about an ADU depends on this one. Lot size, zoning district, setbacks, and whether your existing water, sewer, and electrical service have the headroom to carry a second dwelling all decide the answer before anything gets designed.</p>
          <p>City of Flagstaff parcels and unincorporated Coconino County parcels are governed separately, and the answer can differ across a street.</p>
        </div>
        <div class="zoning-note">
          <p class="note-label">Needs confirming</p>
          <p>{TODO.zoning}</p>
          <p>{TODO.county}</p>
          <p>{TODO.design}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="process-section">
    <div class="section-inner">
      <p class="eyebrow">Our Process</p>
      <h2>How it works with Stronghold</h2>
      <div class="steps-grid">
        <div class="step">
          <span class="step-num">1</span>
          <div class="step-body">
            <h3 class="step-title">Feasibility Walk</h3>
            <p class="step-desc">We look at the lot, the zoning, and what your existing utilities can carry.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">2</span>
          <div class="step-body">
            <h3 class="step-title">Detailed Quote</h3>
            <p class="step-desc">Line-itemized, written before any work starts.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">3</span>
          <div class="step-body">
            <h3 class="step-title">Permitted Build</h3>
            <p class="step-desc">Permits pulled, inspections scheduled. Crew shows up on time.</p>
          </div>
        </div>
        <div class="step">
          <span class="step-num">4</span>
          <div class="step-body">
            <h3 class="step-title">Walkthrough &amp; Punch</h3>
            <p class="step-desc">We go through every item together before we call it done.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cost Guidance -->
  <section class="cost-section">
    <div class="section-inner">
      <div class="cost-inner">
        <div class="cost-text">
          <p class="eyebrow">Cost Guidance</p>
          <h2>What does an ADU cost in Flagstaff?</h2>
          <p>{TODO.cost}</p>
          <p>{TODO.timeline}</p>
        </div>
        <div class="cost-note">
          <p class="note-label">These are ranges, not quotes.</p>
          <p>Every lot is different, and on an ADU the utility runs move the number more than the finishes do. The only way to get a real one is a site walk. We don't charge for that.</p>
          <a href="/contact/" class="btn-primary">Schedule a Site Walk &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <div class="section-inner">
      <p class="eyebrow">Common Questions</p>
      <h2>ADU FAQ</h2>
      <div class="faq-list">
        {faqItems.map(item => (
          <div class="faq-item">
            <h3 class="faq-q">{item.question}</h3>
            <p class="faq-a">{item.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="section-inner cta-inner">
      <div class="cta-text">
        <p class="eyebrow eyebrow--light">Get Started</p>
        <h2>Thinking about an ADU? Start with the feasibility walk.</h2>
        <p class="cta-sub">We'll look at the lot, the zoning, and what your utilities can carry, then tell you whether it works before you spend anything on design. We respond within one business day.</p>
      </div>
      <div class="cta-actions">
        <a href="tel:+19289627535" class="btn-phone">
          <span class="btn-phone-label">Call us directly</span>
          <span class="btn-phone-number">(928) 962-7535</span>
        </a>
        <a href="/contact/" class="btn-quote">Request a Written Quote &rarr;</a>
        <p class="cta-note">No obligation. Mon&ndash;Fri 9am&ndash;4pm.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    border-bottom: 2px solid var(--color-border);
    background-color: var(--color-dark);
    color: var(--color-brand-white);
  }
  .hero-inner {
    max-width: 780px;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }
  .hero h1 {
    font-size: var(--font-size-h1);
    line-height: 1.1;
    margin: 0.75rem 0 1.25rem;
    color: var(--color-brand-white);
  }
  .hero-desc {
    font-size: 1.05rem;
    line-height: 1.75;
    opacity: 0.75;
    max-width: 620px;
    margin-bottom: 2rem;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Shared */
  .eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
  }
  .eyebrow--light {
    color: rgba(255,255,255,0.6);
  }
  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
  }

  /* Includes */
  .includes-section {
    border-bottom: 2px solid var(--color-border);
    background-color: var(--color-surface);
  }
  .includes-content {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .includes-text {
    max-width: 720px;
  }
  .includes-text h2 {
    font-size: var(--font-size-h2);
    margin: 0.75rem 0 1rem;
  }
  .section-desc {
    font-size: 0.95rem;
    line-height: 1.7;
    opacity: 0.7;
  }
  .two-col-lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  .list-label {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.5;
    margin-bottom: 0.75rem;
  }
  .includes-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    border: 2px solid var(--color-border);
  }
  .includes-list li {
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.95rem;
    position: relative;
    padding-left: 2rem;
  }
  .includes-list li:last-child {
    border-bottom: none;
  }
  .includes-list li::before {
    content: '→';
    position: absolute;
    left: 0.75rem;
    color: var(--color-brand-red);
    font-weight: 700;
  }

  /* Zoning */
  .zoning-section {
    border-bottom: 2px solid var(--color-border);
  }
  /* Same stacked shape as the cost section. The note block sits on surface
     rather than white because this section keeps the default background. */
  .zoning-inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    align-items: flex-start;
  }
  .zoning-text {
    max-width: 780px;
  }
  .zoning-text h2 {
    font-size: var(--font-size-h2);
    margin: 0.75rem 0 1.25rem;
  }
  .zoning-text p {
    font-size: 0.975rem;
    line-height: 1.75;
    margin-bottom: 1rem;
    opacity: 0.8;
  }
  .zoning-note {
    background-color: var(--color-surface);
    border: 2px solid var(--color-border);
    padding: 2rem;
    max-width: 780px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .zoning-note p:not(.note-label) {
    font-size: 0.875rem;
    line-height: 1.6;
    opacity: 0.7;
  }

  /* Process */
  .process-section {
    border-bottom: 2px solid var(--color-border);
  }
  .process-section h2 {
    font-size: var(--font-size-h2);
    margin: 0.75rem 0 3rem;
  }
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
  }
  .step {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .step-num {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-brand-red);
    line-height: 1;
    flex-shrink: 0;
  }
  .step-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }
  .step-desc {
    font-size: 0.85rem;
    opacity: 0.65;
    line-height: 1.55;
  }

  /* Cost */
  .cost-section {
    border-bottom: 2px solid var(--color-border);
    background-color: var(--color-surface);
  }
  /* Cost copy runs full measure with the CTA block underneath it. */
  .cost-inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    align-items: flex-start;
  }
  .cost-text {
    max-width: 780px;
  }
  .cost-text h2 {
    font-size: var(--font-size-h2);
    margin: 0.75rem 0 1.25rem;
  }
  .cost-text p {
    font-size: 0.975rem;
    line-height: 1.75;
    margin-bottom: 1rem;
    opacity: 0.8;
  }
  .cost-note {
    background-color: var(--color-brand-white);
    border: 2px solid var(--color-border);
    padding: 2rem;
    max-width: 780px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .note-label {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-red);
  }
  .cost-note p:not(.note-label) {
    font-size: 0.875rem;
    line-height: 1.6;
    opacity: 0.7;
  }

  /* FAQ */
  .faq-section {
    border-bottom: 2px solid var(--color-border);
  }
  .faq-section h2 {
    font-size: var(--font-size-h2);
    margin: 0.75rem 0 2.5rem;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 2px solid var(--color-border);
  }
  .faq-item {
    padding: 1.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .faq-item:last-child {
    border-bottom: none;
  }
  .faq-q {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
  }
  .faq-a {
    font-size: 0.925rem;
    line-height: 1.7;
    opacity: 0.72;
  }

  /* CTA */
  .cta-section {
    background-color: var(--color-brand-red);
    border-top: 3px solid var(--color-brand-black);
    border-bottom: 3px solid var(--color-brand-black);
    color: var(--color-brand-white);
  }
  .cta-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
  }
  .cta-text h2 {
    font-size: var(--font-size-h2);
    color: var(--color-brand-white);
    margin: 0.75rem 0 1rem;
  }
  .cta-sub {
    color: rgba(255,255,255,0.8);
    font-size: 0.95rem;
    line-height: 1.65;
    max-width: 540px;
  }
  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    min-width: 260px;
  }
  .btn-phone {
    display: flex;
    flex-direction: column;
    background-color: var(--color-brand-white);
    color: var(--color-brand-black);
    padding: 1rem 1.5rem;
    border: 2px solid var(--color-brand-white);
    box-shadow: 4px 4px 0 rgba(0,0,0,0.25);
    transition: box-shadow 0.1s, transform 0.1s;
    width: 100%;
  }
  .btn-phone:hover {
    box-shadow: 2px 2px 0 rgba(0,0,0,0.25);
    transform: translate(2px, 2px);
  }
  .btn-phone-label {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.5;
  }
  .btn-phone-number {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .btn-quote {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.5rem;
    background-color: transparent;
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-white);
    box-shadow: 4px 4px 0 rgba(0,0,0,0.2);
    transition: background-color 0.15s, color 0.15s, box-shadow 0.1s, transform 0.1s;
    width: 100%;
    text-align: center;
  }
  .btn-quote:hover {
    background-color: var(--color-brand-white);
    color: var(--color-brand-red);
    box-shadow: 2px 2px 0 rgba(0,0,0,0.2);
    transform: translate(2px, 2px);
  }
  .cta-note {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.55);
    line-height: 1.4;
  }

  /* Buttons */
  .btn-primary {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: var(--color-brand-red);
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-red);
    box-shadow: 4px 4px 0 var(--color-dark);
    transition: box-shadow 0.1s, transform 0.1s;
  }
  .btn-primary:hover {
    box-shadow: 2px 2px 0 var(--color-dark);
    transform: translate(2px, 2px);
  }
  .btn-outline {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: transparent;
    color: var(--color-brand-white);
    border: 2px solid rgba(255,255,255,0.4);
    transition: border-color 0.15s, background-color 0.15s;
  }
  .btn-outline:hover {
    border-color: var(--color-brand-white);
    background-color: rgba(255,255,255,0.1);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .two-col-lists {
      grid-template-columns: 1fr;
    }
    .cta-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .cta-actions {
      min-width: auto;
      width: 100%;
    }
  }

  @media (max-width: 600px) {
    .hero-actions {
      flex-direction: column;
    }
    .hero-actions .btn-primary,
    .hero-actions .btn-outline {
      width: 100%;
      text-align: center;
    }
    .steps-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
