---
import Layout from '../../layouts/Layout.astro';
import { commercialServices, commercialSectors, capabilities } from '../../data/commercial';

export function getStaticPaths() {
  return commercialServices.map(s => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service: s } = Astro.props;

// Sectors only belong on the tenant improvement page. On renovation work the
// question is whether the building can stay open, not what trade the tenant is in.
const showSectors = s.slug === 'tenant-improvement-flagstaff-az';

// The other two lines, for lateral links at the foot of the page.
const siblings = commercialServices.filter(o => o.slug !== s.slug);

const licence = capabilities.find(c => c.label === 'License');

const base = 'https://builtstronghold.com';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${base}/commercial/${s.slug}/#service`,
  name: s.label,
  description: s.metaDescription,
  provider: { '@id': `${base}/#organization` },
  areaServed: 'Flagstaff, AZ and Northern Arizona',
  serviceType: s.navLabel,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${base}/` },
    { '@type': 'ListItem', position: 2, name: 'Commercial', item: `${base}/commercial/` },
    { '@type': 'ListItem', position: 3, name: s.label, item: `${base}/commercial/${s.slug}/` },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: s.faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title={s.metaTitle} description={s.metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Commercial &middot; {s.navLabel}</p>
      <h1>{s.tagline}</h1>
      <p class="hero-desc">{s.intro}</p>
      <p class="hero-desc">{s.introDetail}</p>
      <div class="hero-actions">
        <a href="/commercial/bid-request/" class="btn-primary">{s.ctaLabel} &rarr;</a>
        <a href="tel:+19289627535" class="btn-outline">Call or Text (928) 962-7535</a>
      </div>
    </div>
  </section>

  <!-- Scope -->
  <section class="scope-section">
    <div class="section-inner">
      <div class="scope-content">
        <div class="scope-text">
          <p class="eyebrow">{s.scopeEyebrow}</p>
          <h2>{s.scopeHeading}</h2>
          <p class="section-desc">{s.scopeIntro}</p>
        </div>
        <ul class="scope-list">
          {s.scope.map(item => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Sectors -->
  {showSectors && (
    <section class="sectors-section">
      <div class="section-inner">
        <p class="eyebrow">Who We Build For</p>
        <h2>Space types we have finished</h2>
        <p class="section-desc section-desc--wide">These are the spaces we have actually built out. If yours is not on the list, ask &mdash; we will tell you honestly whether it is work we should be bidding.</p>
        <div class="sectors-grid">
          {commercialSectors.map(sector => (
            <div class="sector-card">
              <h3 class="sector-name">{sector.name}</h3>
              <p class="sector-body">{sector.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Process -->
  <section class="process-section">
    <div class="section-inner">
      <p class="eyebrow">How It Runs</p>
      <h2>From first walk to close out</h2>
      <div class="steps-grid">
        {s.steps.map(step => (
          <div class="step">
            <span class="step-num">{step.n}</span>
            <div class="step-body">
              <h3 class="step-title">{step.title}</h3>
              <p class="step-desc">{step.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Credentials strip -->
  <section class="creds-section">
    <div class="section-inner creds-inner">
      <div class="creds-text">
        <p class="eyebrow">Before You Ask</p>
        <h2>Licensed for commercial work at any size</h2>
        <p>{licence?.note}</p>
      </div>
      <div class="creds-aside">
        <p class="creds-num">{licence?.value}</p>
        <a href="/commercial/capabilities/" class="btn-outline btn-outline--dark">Bonding &amp; insurance detail &rarr;</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <div class="section-inner">
      <p class="eyebrow">Common Questions</p>
      <h2>{s.navLabel} FAQ</h2>
      <div class="faq-list">
        {s.faqs.map(f => (
          <details class="faq-item">
            <summary class="faq-q">{f.q}</summary>
            <p class="faq-a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Siblings -->
  <section class="siblings-section">
    <div class="section-inner">
      <p class="eyebrow">Also Commercial</p>
      <div class="siblings-grid">
        {siblings.map(o => (
          <a href={`/commercial/${o.slug}/`} class="sibling-card">
            <span class="sibling-label">{o.navLabel}</span>
            <span class="sibling-blurb">{o.hubSummary}</span>
            <span class="sibling-arrow">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="section-inner cta-inner">
      <div class="cta-text">
        <p class="eyebrow eyebrow--light">Get Started</p>
        <h2>Tell us about the space.</h2>
        <p class="cta-sub">Send us what you have &mdash; an address, a floor plan, a lease you are about to sign. We will walk it, tell you what it involves, and put a written itemized number in front of you. We respond within one business day.</p>
      </div>
      <div class="cta-actions">
        <a href="tel:+19289627535" class="btn-phone">
          <span class="btn-phone-label">Call or text</span>
          <span class="btn-phone-number">(928) 962-7535</span>
        </a>
        <a href="/commercial/bid-request/" class="btn-quote">{s.ctaLabel} &rarr;</a>
        <p class="cta-note">Mon&ndash;Fri 9am&ndash;4pm. After-hours work scheduled as needed.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    border-bottom: 2px solid var(--color-border);
    background-color: var(--color-dark);
    color: var(--color-brand-white);
  }
  .hero-inner {
    max-width: 820px;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }
  .hero h1 {
    font-size: var(--font-size-h1);
    line-height: 1.1;
    margin: 0.75rem 0 1.25rem;
    color: var(--color-brand-white);
  }
  .hero-desc {
    font-size: 1.05rem;
    line-height: 1.75;
    opacity: 0.75;
    max-width: 660px;
    margin-bottom: 1.25rem;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  /* Shared */
  .eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
  }
  .eyebrow--light { color: rgba(255, 255, 255, 0.6); }
  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
  }
  .section-desc {
    font-size: 0.95rem;
    line-height: 1.7;
    opacity: 0.7;
  }
  .section-desc--wide { max-width: 720px; margin-bottom: 2.5rem; }

  /* Scope */
  .scope-section {
    border-bottom: 2px solid var(--color-border);
    background-color: var(--color-surface);
  }
  .scope-content {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .scope-text { max-width: 720px; }
  .scope-text h2 {
    font-size: var(--font-size-h2);
    margin: 0.75rem 0 1rem;
  }
  .scope-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    border: 2px solid var(--color-border);
  }
  .scope-list li {
    padding: 0.875rem 1.25rem 0.875rem 2rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.95rem;
    position: relative;
  }
  .scope-list li:last-child { border-bottom: none; }
  .scope-list li::before {
    content: '→';
    position: absolute;
    left: 0.75rem;
    color: var(--color-brand-red);
    font-weight: 700;
  }
  /* Two columns once there is room. Clearing the bottom hairline on the last two
     cells drops the trailing rule for both odd and even item counts. */
  @media (min-width: 760px) {
    .scope-list { grid-template-columns: 1fr 1fr; }
    .scope-list li:nth-child(odd) {
      border-right: 1px solid var(--color-border);
    }
    .scope-list li:last-child,
    .scope-list li:nth-last-child(2) {
      border-bottom: none;
    }
    .scope-list li:last-child:nth-child(odd) {
      border-right: none;
    }
  }

  /* Sectors */
  .sectors-section { border-bottom: 2px solid var(--color-border); }
  .sectors-section h2 {
    font-size: var(--font-size-h2);
    margin: 0.75rem 0 1rem;
  }
  .sectors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }
  .sector-card {
    border-top: 3px solid var(--color-brand-red);
    padding-top: 1.25rem;
  }
  .sector-name {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .sector-body {
    font-size: 0.9rem;
    line-height: 1.65;
    opacity: 0.72;
  }

  /* Process */
  .process-section {
    border-bottom: 2px solid var(--color-border);
    background-color: var(--color-surface);
  }
  .process-section h2 {
    font-size: var(--font-size-h2);
    margin: 0.75rem 0 3rem;
  }
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
  }
  .step {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .step-num {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-brand-red);
    line-height: 1;
    flex-shrink: 0;
  }
  .step-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }
  .step-desc {
    font-size: 0.85rem;
    opacity: 0.65;
    line-height: 1.55;
  }

  /* Credentials */
  .creds-section {
    background-color: var(--color-dark);
    color: var(--color-brand-white);
    border-bottom: 2px solid var(--color-border);
  }
  .creds-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
  }
  .creds-text h2 {
    font-size: var(--font-size-h3);
    color: var(--color-brand-white);
    margin: 0.75rem 0 0.9rem;
  }
  .creds-text p {
    font-size: 0.95rem;
    line-height: 1.7;
    opacity: 0.72;
    max-width: 620px;
  }
  .creds-aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .creds-num {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-brand-white);
    white-space: nowrap;
  }

  /* FAQ */
  .faq-section { border-bottom: 2px solid var(--color-border); }
  .faq-section h2 {
    font-size: var(--font-size-h2);
    margin: 0.75rem 0 2.5rem;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    border: 2px solid var(--color-border);
  }
  .faq-item { border-bottom: 1px solid var(--color-border); }
  .faq-item:last-child { border-bottom: none; }
  .faq-q {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    padding: 1.5rem 1.75rem;
    cursor: pointer;
    list-style: none;
    position: relative;
    padding-right: 3.5rem;
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q::after {
    content: '+';
    position: absolute;
    right: 1.75rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-brand-red);
    font-size: 1.4rem;
    line-height: 1;
  }
  .faq-item[open] .faq-q::after { content: '–'; }
  .faq-a {
    font-size: 0.925rem;
    line-height: 1.7;
    opacity: 0.72;
    padding: 0 1.75rem 1.5rem;
    max-width: 70ch;
  }

  /* Siblings */
  .siblings-section {
    border-bottom: 2px solid var(--color-border);
    background-color: var(--color-surface);
  }
  .siblings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .sibling-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.75rem;
    background-color: var(--color-brand-white);
    border: 2px solid var(--color-border);
    transition: border-color 0.15s, box-shadow 0.1s, transform 0.1s;
  }
  .sibling-card:hover {
    border-color: var(--color-brand-red);
    box-shadow: 4px 4px 0 var(--color-brand-red);
    transform: translate(-2px, -2px);
  }
  .sibling-label {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
  }
  .sibling-blurb {
    font-size: 0.875rem;
    line-height: 1.6;
    opacity: 0.7;
  }
  .sibling-arrow {
    color: var(--color-brand-red);
    font-weight: 700;
  }

  /* CTA */
  .cta-section {
    background-color: var(--color-brand-red);
    border-top: 3px solid var(--color-brand-black);
    border-bottom: 3px solid var(--color-brand-black);
    color: var(--color-brand-white);
  }
  .cta-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
  }
  .cta-text h2 {
    font-size: var(--font-size-h2);
    color: var(--color-brand-white);
    margin: 0.75rem 0 1rem;
  }
  .cta-sub {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.95rem;
    line-height: 1.65;
    max-width: 540px;
  }
  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    min-width: 260px;
  }
  .btn-phone {
    display: flex;
    flex-direction: column;
    background-color: var(--color-brand-white);
    color: var(--color-brand-black);
    padding: 1rem 1.5rem;
    border: 2px solid var(--color-brand-white);
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.25);
    transition: box-shadow 0.1s, transform 0.1s;
    width: 100%;
  }
  .btn-phone:hover {
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.25);
    transform: translate(2px, 2px);
  }
  .btn-phone-label {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.5;
  }
  .btn-phone-number {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .btn-quote {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.5rem;
    background-color: transparent;
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-white);
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.2);
    transition: background-color 0.15s, color 0.15s, box-shadow 0.1s, transform 0.1s;
    width: 100%;
    text-align: center;
  }
  .btn-quote:hover {
    background-color: var(--color-brand-white);
    color: var(--color-brand-red);
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.2);
    transform: translate(2px, 2px);
  }
  .cta-note {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.4;
  }

  /* Buttons */
  .btn-primary {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: var(--color-brand-red);
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-red);
    box-shadow: 4px 4px 0 var(--color-brand-white);
    transition: box-shadow 0.1s, transform 0.1s;
  }
  .btn-primary:hover {
    box-shadow: 2px 2px 0 var(--color-brand-white);
    transform: translate(2px, 2px);
  }
  .btn-outline {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: transparent;
    color: var(--color-brand-white);
    border: 2px solid rgba(255, 255, 255, 0.4);
    transition: border-color 0.15s, background-color 0.15s;
  }
  .btn-outline:hover {
    border-color: var(--color-brand-white);
    background-color: rgba(255, 255, 255, 0.1);
  }
  .btn-outline--dark { white-space: nowrap; }

  /* Responsive */
  @media (max-width: 900px) {
    .creds-inner { grid-template-columns: 1fr; gap: 2rem; }
    .cta-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .cta-actions { min-width: auto; width: 100%; }
  }

  @media (max-width: 600px) {
    .hero-actions { flex-direction: column; }
    .hero-actions .btn-primary,
    .hero-actions .btn-outline {
      width: 100%;
      text-align: center;
    }
    .steps-grid { grid-template-columns: 1fr; }
    .creds-aside { width: 100%; }
    .btn-outline--dark { width: 100%; text-align: center; white-space: normal; }
  }
</style>
