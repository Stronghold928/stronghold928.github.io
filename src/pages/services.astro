---
import Layout from '../layouts/Layout.astro';
import { services } from '../data/services';
---

<Layout
  title="Construction & Remodeling Services in Flagstaff AZ | Stronghold"
  description="Stronghold Construction offers remodeling, historic restoration, new home builds, and repairs across northern Arizona. Based in Flagstaff, serving Williams, Sedona, Show Low, and beyond."
>
  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="eyebrow">What We Do</p>
      <h1>What we do,<br /><span class="accent">and how we do it.</span></h1>
      <p class="hero-sub">Every project starts with an honest conversation about what you actually need. From there you get a real quote, a real crew, and someone you can reach when you have questions.</p>
    </div>
  </section>

  <nav class="service-nav" aria-label="Jump to service">
    {services.map(s => (
      <a href={`#${s.slug}`} class="service-nav-link">{s.label}</a>
    ))}
  </nav>

  {services.map((s, i) => (
    <>
    <section id={s.slug} class={`service-section ${i % 2 === 1 ? 'service-section--alt' : ''}`}>
      <div class="service-inner">
        <div class="service-photo-col">
          <div class="service-photo-wrap">
            <img src={s.photo} alt={s.photoAlt} loading="lazy" />
          </div>
        </div>
        <div class="service-content-col">
          <p class="eyebrow">{s.label}</p>
          <h2>{s.tagline}</h2>
          <p class="service-desc">{s.description}</p>
          <p class="service-detail">{s.detail}</p>
          <div class="service-cta-row">
            <a href={`/services/${s.slug}`} class="btn-primary">Learn More &rarr;</a>
            {s.designCta && (
              <a href={s.designCta.href} class="btn-outline">{s.designCta.label}</a>
            )}
          </div>
        </div>
      </div>
      <div class="service-process">
        <div class="service-process-inner">
          <h3 class="process-title">Our Process</h3>
          <div class="process-steps">
            {s.steps.map(step => (
              <div class="process-step">
                <span class="step-num">{step.n}</span>
                <div>
                  <h4 class="step-title">{step.title}</h4>
                  <p class="step-body">{step.body}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
    {s.faqs && s.faqs.length > 0 && (
      <section class="service-faq" id={`${s.slug}-faq`}>
        <div class="service-faq-inner">
          <h3 class="faq-title">{s.label} — Common Questions</h3>
          <div class="faq-list">
            {s.faqs.map(faq => (
              <details class="faq-item" name={`faq-${s.slug}`}>
                <summary class="faq-question">{faq.q}</summary>
                <p class="faq-answer">{faq.a}</p>
              </details>
            ))}
          </div>
          <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": s.faqs.map(faq => ({
              "@type": "Question",
              "name": faq.q,
              "acceptedAnswer": {
                "@type": "Answer",
                "text": faq.a
              }
            }))
          })} />
        </div>
      </section>
    )}
    </>
  ))}

  <section class="service-area">
    <div class="service-area-inner">
      <p class="eyebrow">Where We Work</p>
      <h2>We work all over<br />northern Arizona.</h2>
      <p>Flagstaff is home base, but we regularly work in Williams, Sedona, Winslow, Show Low, Camp Verde, and the communities in between. If you're in the region and wondering whether we travel to you, just ask.</p>
      <a href="/contact" class="btn-primary">Get in Touch &rarr;</a>
    </div>
  </section>
</Layout>

<style>
  /* Page hero */
  .page-hero {
    padding: 6rem 1.5rem 4rem;
    border-bottom: 2px solid var(--color-brand-gray);
  }
  .page-hero-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 1rem;
  }
  .page-hero h1 {
    font-size: var(--font-size-h1);
    margin-bottom: 1.25rem;
  }
  .accent { color: var(--color-brand-red); }
  .hero-sub {
    font-size: 1.1rem;
    opacity: 0.7;
    max-width: 540px;
    line-height: 1.6;
  }

  /* Service nav */
  .service-nav {
    display: flex;
    background-color: var(--color-surface);
    border-bottom: 2px solid var(--color-border);
    overflow-x: auto;
  }
  .service-nav-link {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 1rem 1.5rem;
    color: var(--color-text);
    opacity: 0.6;
    white-space: nowrap;
    border-right: 1px solid var(--color-border);
    transition: opacity 0.15s, background-color 0.15s;
  }
  .service-nav-link:hover {
    opacity: 1;
    background-color: var(--color-surface-2);
  }

  /* Service sections */
  .service-section {
    border-bottom: 2px solid var(--color-border);
  }
  .service-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }
  .service-section--alt .service-inner {
    direction: rtl;
  }
  .service-section--alt .service-content-col {
    direction: ltr;
  }
  .service-section--alt .service-photo-col {
    direction: ltr;
  }
  .service-photo-wrap {
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    border: 2px solid var(--color-border);
    box-shadow: 6px 6px 0 var(--color-brand-red);
  }
  .service-photo-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .service-photo-wrap:hover img {
    transform: scale(1.03);
  }
  .service-content-col h2 {
    font-size: var(--font-size-h2);
    margin-bottom: 1.25rem;
  }
  .service-desc {
    font-size: 1rem;
    line-height: 1.7;
    opacity: 0.8;
    margin-bottom: 1rem;
  }
  .service-detail {
    font-size: 0.9rem;
    line-height: 1.7;
    opacity: 0.6;
    margin-bottom: 1.75rem;
    border-left: 3px solid var(--color-brand-red);
    padding-left: 1rem;
  }
  .service-cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }

  /* Process strip */
  .service-process {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }
  .service-process-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }
  .process-title {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 1.75rem;
  }
  .process-steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }
  .process-step {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .step-num {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-brand-red);
    line-height: 1;
    flex-shrink: 0;
  }
  .step-title {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }
  .step-body {
    font-size: 0.8rem;
    opacity: 0.65;
    line-height: 1.5;
  }

  /* FAQ sections */
  .service-faq {
    background-color: var(--color-surface);
    border-bottom: 2px solid var(--color-border);
  }
  .service-faq-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }
  .faq-title {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 1.5rem;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--color-border);
  }
  .faq-item {
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-brand-white);
  }
  .faq-item:last-child { border-bottom: none; }
  .faq-question {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-question::after {
    content: '+';
    color: var(--color-brand-red);
    font-size: 1.25rem;
    font-weight: 700;
    flex-shrink: 0;
    margin-left: 1rem;
  }
  details[open] .faq-question::after { content: '−'; }
  .faq-answer {
    font-size: 0.9rem;
    line-height: 1.7;
    opacity: 0.75;
    padding: 0 1.5rem 1.25rem;
  }

  /* Service area */
  .service-area {
    background-color: var(--color-brand-red);
    border-top: 3px solid var(--color-brand-black);
  }
  .service-area-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
  }
  .service-area h2 {
    font-size: var(--font-size-h2);
    margin-bottom: 1.25rem;
  }
  .service-area p {
    opacity: 0.85;
    max-width: 560px;
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .service-area .btn-primary {
    background-color: var(--color-dark);
    border-color: var(--color-dark);
    box-shadow: 4px 4px 0 rgba(255,255,255,0.5);
  }
  .service-area .btn-primary:hover {
    box-shadow: 2px 2px 0 rgba(255,255,255,0.5);
    transform: translate(2px, 2px);
  }

  /* Buttons */
  .btn-primary {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: var(--color-brand-red);
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-red);
    box-shadow: 4px 4px 0 var(--color-dark);
    transition: box-shadow 0.1s, transform 0.1s;
  }
  .btn-primary:hover {
    box-shadow: 2px 2px 0 var(--color-dark);
    transform: translate(2px, 2px);
  }
  .btn-outline {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.75rem 1.25rem;
    background-color: transparent;
    color: var(--color-text);
    border: 2px solid var(--color-border);
    transition: border-color 0.15s;
  }
  .btn-outline:hover {
    border-color: var(--color-brand-red);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .service-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .service-section--alt .service-inner {
      direction: ltr;
    }
  }
</style>
