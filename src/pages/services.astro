---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { services, landingPages } from '../data/services';
import { serviceAreas } from '../data/service-areas';

const site = 'https://builtstronghold.com';

// Hub page: an ItemList pointing at the child service pages. The full copy,
// process steps, and FAQs live on those pages — duplicating them here put five
// URLs in competition for the same terms.
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Construction and remodeling services in Flagstaff, AZ',
  itemListElement: [
    ...services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.label,
      url: `${site}/services/${s.slug}/`,
    })),
    ...landingPages.map((l, i) => ({
      '@type': 'ListItem',
      position: services.length + i + 1,
      name: l.label,
      url: `${site}/services/${l.slug}/`,
    })),
  ],
};
---

<Layout
  title="Construction & Remodeling Services in Flagstaff AZ"
  description="Remodeling, historic restoration, new home builds, and handyman services from Stronghold Construction, based in Flagstaff, serving all of northern Arizona."
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="eyebrow">What We Do</p>
      <h1>What we do, <br /><span class="accent">and how we do it.</span></h1>
      <p class="hero-sub">Every project starts with an honest conversation about what you actually need. From there you get a real quote, a real crew, and someone you can reach when you have questions.</p>
    </div>
  </section>

  <nav class="service-nav" aria-label="Services">
    <div class="service-nav-inner">
      {services.map(s => (
        <a href={`/services/${s.slug}/`} class="service-nav-link">{s.label}</a>
      ))}
    </div>
  </nav>

  {services.map((s, i) => (
    <section id={s.slug} class={`service-section ${i % 2 === 1 ? 'service-section--alt' : ''}`}>
      <div class="service-inner">
        <div class="service-photo-col">
          <a href={`/services/${s.slug}/`} class="service-photo-wrap">
            <Image
              src={s.photo}
              alt={s.photoAlt}
              widths={[400, 800, 1200]}
              sizes="(max-width: 900px) 100vw, 600px"
              loading="lazy"
            />
          </a>
        </div>
        <div class="service-content-col">
          <p class="eyebrow">{s.label}</p>
          <h2><a href={`/services/${s.slug}/`}>{s.tagline}</a></h2>
          <p class="service-desc">{s.hubSummary}</p>
          <ul class="service-sublinks">
            {landingPages.filter(l => l.parentService === s.slug).map(l => (
              <li>
                <a href={`/services/${l.slug}/`}>{l.label}</a>
              </li>
            ))}
          </ul>
          <div class="service-cta-row">
            <a href={`/services/${s.slug}/`} class="btn-primary">{s.label} Details &rarr;</a>
            {s.designCta && (
              <a href={s.designCta.href} class="btn-outline">{s.designCta.label}</a>
            )}
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="popular-section">
    <div class="popular-inner">
      <p class="eyebrow">Most Requested</p>
      <h2>The projects we get called about most.</h2>
      <div class="popular-grid">
        {landingPages.map(l => (
          <a href={`/services/${l.slug}/`} class="popular-card">
            <span class="popular-label">{l.label}</span>
            <span class="popular-blurb">{l.blurb}</span>
            <span class="popular-arrow">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="service-area">
    <div class="service-area-inner">
      <p class="eyebrow">Where We Work</p>
      <h2>We work all over <br />northern Arizona.</h2>
      <p>Flagstaff is home base, but we regularly work in the communities below. If you're in the region and wondering whether we travel to you, just ask.</p>
      <ul class="area-links">
        {serviceAreas.map(a => (
          <li><a href={`/service-areas/${a.slug}/`}>{a.cityName}, {a.stateAbbr}</a></li>
        ))}
      </ul>
      <a href="/contact/" class="btn-primary">Get in Touch &rarr;</a>
    </div>
  </section>
</Layout>

<style>
  /* Page hero */
  .page-hero {
    padding: 6rem 1.5rem 4rem;
    border-bottom: 2px solid var(--color-brand-gray);
  }
  .page-hero-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 1rem;
  }
  .page-hero h1 {
    font-size: var(--font-size-h1);
    margin-bottom: 1.25rem;
  }
  .accent { color: var(--color-brand-red); }
  .hero-sub {
    font-size: 1.1rem;
    opacity: 0.7;
    max-width: 540px;
    line-height: 1.6;
  }

  /* Service nav */
  .service-nav {
    display: flex;
    background-color: var(--color-surface);
    border-bottom: 2px solid var(--color-border);
    overflow-x: auto;
  }
  /* `margin: 0 auto` on an inner flex row centres the links when they fit and
     falls back to a normal left-aligned scroll when they don't. Centring the
     scroll container itself would overflow both edges and put the first link
     out of reach on narrow screens. */
  .service-nav-inner {
    display: flex;
    margin: 0 auto;
  }
  .service-nav-link {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 1rem 1.5rem;
    color: var(--color-text);
    opacity: 0.6;
    white-space: nowrap;
    border-right: 1px solid var(--color-border);
    transition: opacity 0.15s, background-color 0.15s;
  }
  /* Centred, the trailing divider reads as a stray line rather than a column edge. */
  .service-nav-link:first-child {
    border-left: 1px solid var(--color-border);
  }
  .service-nav-link:hover {
    opacity: 1;
    background-color: var(--color-surface-2);
  }

  /* Service sections */
  .service-section {
    border-bottom: 2px solid var(--color-border);
  }
  .service-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }
  .service-section--alt .service-inner {
    direction: rtl;
  }
  .service-section--alt .service-content-col {
    direction: ltr;
  }
  .service-section--alt .service-photo-col {
    direction: ltr;
  }
  /* The wrap is an anchor: without `display: block` it stays inline, which makes
     `aspect-ratio` and the image's `height: 100%` no-ops and lets a portrait
     source stretch the whole section. */
  .service-photo-wrap {
    display: block;
    width: 100%;
    aspect-ratio: 4/3;
    overflow: hidden;
    box-shadow: 6px 6px 0 var(--color-brand-red);
  }
  .service-photo-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .service-photo-wrap:hover img {
    transform: scale(1.03);
  }
  .service-content-col h2 {
    font-size: var(--font-size-h2);
    margin-bottom: 1.25rem;
  }
  .service-desc {
    font-size: 1rem;
    line-height: 1.7;
    opacity: 0.8;
    margin-bottom: 1rem;
  }
  .service-detail {
    font-size: 0.9rem;
    line-height: 1.7;
    opacity: 0.6;
    margin-bottom: 1.75rem;
    border-left: 3px solid var(--color-brand-red);
    padding-left: 1rem;
  }
  .service-cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }

  /* Service area */
  .service-area {
    background-color: var(--color-brand-red);
    border-top: 3px solid var(--color-brand-black);
    color: var(--color-brand-white);
  }
  .service-area-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
  }
  .service-area h2 {
    font-size: var(--font-size-h2);
    margin-bottom: 1.25rem;
  }
  .service-area p {
    opacity: 0.85;
    max-width: 560px;
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .service-area .btn-primary {
    background-color: var(--color-dark);
    border-color: var(--color-dark);
    box-shadow: 4px 4px 0 rgba(255,255,255,0.5);
  }
  .service-area .btn-primary:hover {
    box-shadow: 2px 2px 0 rgba(255,255,255,0.5);
    transform: translate(2px, 2px);
  }

  /* Buttons */
  .btn-primary {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.875rem 1.75rem;
    background-color: var(--color-brand-red);
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-red);
    box-shadow: 4px 4px 0 var(--color-dark);
    transition: box-shadow 0.1s, transform 0.1s;
  }
  .btn-primary:hover {
    box-shadow: 2px 2px 0 var(--color-dark);
    transform: translate(2px, 2px);
  }
  .btn-outline {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.75rem 1.25rem;
    background-color: transparent;
    color: var(--color-text);
    border: 2px solid var(--color-border);
    transition: border-color 0.15s;
  }
  .btn-outline:hover {
    border-color: var(--color-brand-red);
  }

  .service-content-col h2 a {
    color: inherit;
  }
  .service-content-col h2 a:hover {
    color: var(--color-brand-red);
  }
  .service-sublinks {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .service-sublinks a {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    transition: border-color 0.15s, color 0.15s;
  }
  .service-sublinks a:hover {
    border-color: var(--color-brand-red);
    color: var(--color-brand-red);
  }

  /* Most requested */
  .popular-section {
    background-color: var(--color-surface);
    border-bottom: 2px solid var(--color-border);
  }
  .popular-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
  }
  .popular-inner h2 {
    font-size: var(--font-size-h2);
    margin-bottom: 2.5rem;
  }
  .popular-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .popular-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    background-color: var(--color-brand-white);
    border: 2px solid var(--color-border);
    box-shadow: 4px 4px 0 var(--color-dark);
    transition: box-shadow 0.1s, transform 0.1s, border-color 0.15s;
  }
  .popular-card:hover {
    border-color: var(--color-brand-red);
    box-shadow: 2px 2px 0 var(--color-dark);
    transform: translate(2px, 2px);
  }
  .popular-label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.25;
  }
  .popular-blurb {
    font-size: 0.85rem;
    line-height: 1.6;
    opacity: 0.7;
  }
  .popular-arrow {
    color: var(--color-brand-red);
    font-weight: 700;
    margin-top: 0.25rem;
  }

  /* Area links */
  .area-links {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .area-links a {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.5rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    transition: background-color 0.15s;
  }
  .area-links a:hover {
    background-color: rgba(0, 0, 0, 0.2);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .service-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .service-section--alt .service-inner {
      direction: ltr;
    }
  }
</style>
