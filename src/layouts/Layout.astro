---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Stronghold Construction: Licensed general contractor in Flagstaff, AZ. Remodeling, restoration, new home builds, and repairs across northern Arizona.',
  ogImage = '/og-default.svg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Resolve ogImage to an absolute URL so social crawlers can fetch it
const ogImageURL = new URL(ogImage, Astro.site).toString();

// LocalBusiness schema — omit placeholder fields until real values are known
const localBusinessSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  "name": "Stronghold Construction",
  "alternateName": "Stronghold",
  "description": "Licensed general contractor in Flagstaff, AZ specializing in remodeling, restoration, new home builds, and repairs across northern Arizona.",
  "url": Astro.site?.toString().replace(/\/$/, '') ?? "https://builtstronghold.com",
  "logo": new URL('/logo-black.png', Astro.site).toString(),
  "image": new URL('/og-default.svg', Astro.site).toString(),
  "email": "hello@builtstronghold.com",
  // TODO: Uncomment and fill in when real values are available:
  // "telephone": "+1-928-XXX-XXXX",
  // "address": {
  //   "@type": "PostalAddress",
  //   "streetAddress": "123 Main St",
  //   "addressLocality": "Flagstaff",
  //   "addressRegion": "AZ",
  //   "postalCode": "86001",
  //   "addressCountry": "US"
  // },
  // "hasCredential": "AZ ROC License: XXXXXX",
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 35.1983,
    "longitude": -111.6513
  },
  "areaServed": [
    "Flagstaff, AZ",
    "Williams, AZ",
    "Sedona, AZ",
    "Camp Verde, AZ",
    "Winslow, AZ",
    "Show Low, AZ",
    "Payson, AZ",
    "Prescott Valley, AZ",
    "Northern Arizona"
  ],
  "openingHours": ["Mo-Fr 07:00-17:00", "Sa 09:00-13:00"],
  "foundingDate": "2015",
  "knowsAbout": [
    "Residential remodeling",
    "Kitchen remodeling",
    "Bathroom remodeling",
    "Home restoration",
    "Historic home restoration",
    "New home construction",
    "Custom home building",
    "Home repairs",
    "Deck construction and repair",
    "Home additions"
  ],
  "priceRange": "$$",
  "currenciesAccepted": "USD",
  "paymentAccepted": "Check, Bank Transfer",
  "sameAs": []
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} | Stronghold</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Stronghold Construction`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Stronghold Construction`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/logo-black.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/logo-black.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Inter:wght@400;500;600&family=Caveat:wght@600&display=swap"
      rel="stylesheet"
    />

    <!-- TODO: Add telephone, address, and hasCredential to localBusinessSchema in frontmatter when real values are available -->
    <!-- LocalBusiness Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-B3NH363HYC"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-B3NH363HYC');
    </script>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
