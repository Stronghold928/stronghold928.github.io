---
import { Image } from 'astro:assets';
import logoMark from '../assets/logo-white.png';
import { services, landingPages } from '../data/services';
import { serviceAreas } from '../data/service-areas';

// Major service areas in Northern AZ without dedicated pages yet — see TODO.md
const pendingAreas = [
  { cityName: 'Prescott', county: 'Yavapai' },
  { cityName: 'Cottonwood', county: 'Yavapai' },
  { cityName: 'Pinetop-Lakeside', county: 'Navajo' },
  { cityName: 'Chino Valley', county: 'Yavapai' },
];

const otherLinks = [
  { href: '/projects/', label: 'Projects' },
  { href: '/design/', label: 'Design' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const isServicesActive = currentPath.startsWith('/services');
const isAreasActive = currentPath.startsWith('/service-areas');
---

<header class="nav-header">
  <nav class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Stronghold Home">
      <Image
        src={logoMark}
        alt=""
        class="logo-mark"
        aria-hidden="true"
        width={51}
        densities={[1, 2]}
        loading="eager"
      />
      <span class="logo-text">STRONGHOLD</span>
    </a>

    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <ul class="nav-links" id="nav-links">
      <!-- Services dropdown -->
      <li class="nav-item nav-item--dropdown" data-dropdown="services">
        <button
          class={`nav-link nav-link--dropdown-trigger ${isServicesActive ? 'nav-link--active' : ''}`}
          data-dropdown-toggle="services"
          aria-haspopup="true"
          aria-expanded="false"
        >
          Services
          <svg class="chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="dropdown-panel" data-dropdown-panel="services" role="menu">
          <div class="dropdown-services">
            {services.map(s => (
              <a
                href={`/services/${s.slug}/`}
                class={`dropdown-service-link ${currentPath === `/services/${s.slug}/` ? 'dropdown-service-link--active' : ''}`}
                role="menuitem"
              >
                <span class="dropdown-service-label">{s.label}</span>
                <span class="dropdown-service-tagline">{s.tagline}</span>
              </a>
            ))}
          </div>
          <div class="dropdown-popular">
            <p class="dropdown-popular-title">Most Requested</p>
            {landingPages.map(l => (
              <a
                href={`/services/${l.slug}/`}
                class={`dropdown-popular-link ${currentPath === `/services/${l.slug}/` ? 'dropdown-popular-link--active' : ''}`}
                role="menuitem"
              >
                {l.navLabel}
              </a>
            ))}
          </div>
          <div class="dropdown-footer">
            <a href="/services/" class="dropdown-all-link" role="menuitem">
              View All Services &rarr;
            </a>
          </div>
        </div>

        <!-- Mobile sub-links -->
        <ul class="mobile-sub-links" data-mobile-sub="services" aria-label="Service pages">
          {services.map(s => (
            <li>
              <a
                href={`/services/${s.slug}/`}
                class={`mobile-sub-link ${currentPath === `/services/${s.slug}/` ? 'mobile-sub-link--active' : ''}`}
              >
                {s.label}
              </a>
            </li>
          ))}
          {landingPages.map(l => (
            <li>
              <a
                href={`/services/${l.slug}/`}
                class={`mobile-sub-link mobile-sub-link--nested ${currentPath === `/services/${l.slug}/` ? 'mobile-sub-link--active' : ''}`}
              >
                {l.navLabel}
              </a>
            </li>
          ))}
          <li>
            <a href="/services/" class="mobile-sub-link mobile-sub-link--all">All Services &rarr;</a>
          </li>
        </ul>
      </li>

      <!-- Service Areas dropdown -->
      <li class="nav-item nav-item--dropdown" data-dropdown="areas">
        <button
          class={`nav-link nav-link--dropdown-trigger ${isAreasActive ? 'nav-link--active' : ''}`}
          data-dropdown-toggle="areas"
          aria-haspopup="true"
          aria-expanded="false"
        >
          Service Areas
          <svg class="chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="dropdown-panel dropdown-panel--areas" data-dropdown-panel="areas" role="menu">
          <div class="dropdown-areas-grid">
            {serviceAreas.map(a => (
              <a
                href={`/service-areas/${a.slug}/`}
                class={`dropdown-area-link ${currentPath === `/service-areas/${a.slug}/` ? 'dropdown-area-link--active' : ''}`}
                role="menuitem"
              >
                <span class="dropdown-area-city">{a.cityName}</span>
                <span class="dropdown-area-county">{a.county} Co.</span>
              </a>
            ))}
            {pendingAreas.map(a => (
              <span class="dropdown-area-link dropdown-area-link--pending" aria-label={`${a.cityName} — coming soon`}>
                <span class="dropdown-area-city">{a.cityName}</span>
                <span class="dropdown-area-county dropdown-area-county--pending">{a.county} Co. &mdash; Soon</span>
              </span>
            ))}
          </div>
          <div class="dropdown-footer">
            <a href="/service-areas/" class="dropdown-all-link" role="menuitem">
              View All Service Areas &rarr;
            </a>
          </div>
        </div>

        <!-- Mobile sub-links -->
        <ul class="mobile-sub-links" data-mobile-sub="areas" aria-label="Service area pages">
          {serviceAreas.map(a => (
            <li>
              <a
                href={`/service-areas/${a.slug}/`}
                class={`mobile-sub-link ${currentPath === `/service-areas/${a.slug}/` ? 'mobile-sub-link--active' : ''}`}
              >
                {a.cityName}
              </a>
            </li>
          ))}
          {pendingAreas.map(a => (
            <li>
              <span class="mobile-sub-link mobile-sub-link--pending">{a.cityName} (Soon)</span>
            </li>
          ))}
          <li>
            <a href="/service-areas/" class="mobile-sub-link mobile-sub-link--all">All Areas &rarr;</a>
          </li>
        </ul>
      </li>

      {otherLinks.map(link => (
        <li>
          <a
            href={link.href}
            class={`nav-link ${currentPath.startsWith(link.href) ? 'nav-link--active' : ''}`}
          >
            {link.label}
          </a>
        </li>
      ))}

      <li>
        <a href="/quote/" class="nav-cta">Get a Quote</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const navToggle = document.getElementById('nav-toggle');
  const navLinks = document.getElementById('nav-links');

  // Hamburger: open/close full menu
  navToggle?.addEventListener('click', () => {
    const open = navLinks?.classList.toggle('nav-links--open');
    navToggle.setAttribute('aria-expanded', String(open));
  });

  // Generic dropdown handler — works for any [data-dropdown] item
  const dropdownItems = document.querySelectorAll<HTMLElement>('.nav-item--dropdown');

  function closeAll(except?: HTMLElement) {
    dropdownItems.forEach(item => {
      if (item === except) return;
      item.classList.remove('dropdown--open');
      const toggle = item.querySelector<HTMLElement>('[data-dropdown-toggle]');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.classList.remove('dropdown-trigger--open');
    });
  }

  dropdownItems.forEach(item => {
    const key = item.dataset.dropdown!;
    const toggle = item.querySelector<HTMLButtonElement>(`[data-dropdown-toggle="${key}"]`);
    const mobileSub = item.querySelector<HTMLElement>(`[data-mobile-sub="${key}"]`);

    let skipNextDocClick = false;

    toggle?.addEventListener('click', () => {
      const isMobile = window.innerWidth <= 768;
      if (isMobile) {
        const open = mobileSub?.classList.toggle('mobile-sub-links--open');
        toggle.setAttribute('aria-expanded', String(!!open));
        toggle.classList.toggle('dropdown-trigger--open', !!open);
      } else {
        closeAll(item);
        const open = item.classList.toggle('dropdown--open');
        toggle.setAttribute('aria-expanded', String(open));
        skipNextDocClick = true;
      }
    });

    document.addEventListener('click', (e) => {
      if (skipNextDocClick) { skipNextDocClick = false; return; }
      if (!item.contains(e.target as Node)) {
        item.classList.remove('dropdown--open');
        toggle?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeAll();
      document.querySelectorAll<HTMLElement>('[data-dropdown-toggle]').forEach(t => t.focus());
    }
  });
</script>

<style>
  .nav-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-dark);
    border-bottom: 2px solid #1C1C1C;
  }

  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-mark {
    height: 38px;
    width: auto;
    display: block;
    flex-shrink: 0;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-brand-red);
    letter-spacing: 0.15em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.5rem 0.75rem;
    color: var(--color-brand-white);
    opacity: 0.7;
    transition: opacity 0.15s;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .nav-link--dropdown-trigger {
    background: none;
    border: none;
    cursor: pointer;
    line-height: 1;
  }

  .nav-link:hover,
  .nav-link--active {
    opacity: 1;
  }

  .nav-link--active {
    border-bottom: 2px solid var(--color-brand-red);
  }

  .chevron {
    transition: transform 0.2s ease;
    opacity: 0.7;
    flex-shrink: 0;
  }
  .dropdown-trigger--open .chevron,
  .dropdown--open .nav-link--dropdown-trigger .chevron {
    transform: rotate(180deg);
    opacity: 1;
  }

  /* Dropdown panel — desktop */
  .dropdown-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    min-width: 320px;
    background-color: #111111;
    border: 2px solid #2a2a2a;
    border-top: 3px solid var(--color-brand-red);
    box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease, visibility 0.15s ease, transform 0.15s ease;
    pointer-events: none;
  }

  .dropdown-panel--areas {
    min-width: 420px;
    /* Shift left so it doesn't overflow the right edge */
    left: auto;
    right: -1rem;
    transform: translateY(-6px);
  }

  .nav-item--dropdown.dropdown--open .dropdown-panel {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }

  .nav-item--dropdown.dropdown--open .dropdown-panel--areas {
    transform: translateY(0);
  }

  /* Services dropdown body */
  .dropdown-services {
    padding: 0.5rem 0;
  }

  .dropdown-service-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem 1.25rem;
    transition: background-color 0.12s;
    border-left: 3px solid transparent;
  }
  .dropdown-service-link:hover,
  .dropdown-service-link--active {
    background-color: rgba(255,255,255,0.06);
    border-left-color: var(--color-brand-red);
  }
  .dropdown-service-label {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-white);
  }
  .dropdown-service-tagline {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.45);
    line-height: 1.3;
  }

  /* Service Areas dropdown body */
  .dropdown-areas-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 0.5rem 0;
  }

  .dropdown-area-link {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.65rem 1.25rem;
    transition: background-color 0.12s;
    border-left: 3px solid transparent;
    text-decoration: none;
  }
  .dropdown-area-link:hover,
  .dropdown-area-link--active {
    background-color: rgba(255,255,255,0.06);
    border-left-color: var(--color-brand-red);
  }
  .dropdown-area-link--pending {
    cursor: default;
    opacity: 0.4;
  }
  .dropdown-area-link--pending:hover {
    background-color: transparent;
    border-left-color: transparent;
  }
  .dropdown-area-city {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-white);
  }
  .dropdown-area-county {
    font-size: 0.68rem;
    color: rgba(255,255,255,0.45);
  }
  .dropdown-area-county--pending {
    color: rgba(255,255,255,0.3);
    font-style: italic;
  }

  .dropdown-popular {
    border-top: 1px solid var(--color-border);
    padding: 0.875rem 1rem 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .dropdown-popular-title {
    width: 100%;
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 0.5rem;
  }
  .dropdown-popular-link {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--color-border);
    white-space: nowrap;
    transition: border-color 0.15s, color 0.15s;
  }
  .dropdown-popular-link:hover,
  .dropdown-popular-link--active {
    border-color: var(--color-brand-red);
    color: var(--color-brand-red);
  }
  .mobile-sub-link--nested {
    padding-left: 2.25rem;
    opacity: 0.75;
  }

  .dropdown-footer {
    border-top: 1px solid #2a2a2a;
    padding: 0.75rem 1.25rem;
  }
  .dropdown-all-link {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    transition: opacity 0.15s;
  }
  .dropdown-all-link:hover {
    opacity: 0.7;
  }

  /* Mobile sub-links */
  .mobile-sub-links {
    display: none;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-cta {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.5rem 1.25rem;
    background-color: var(--color-brand-red);
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-red);
    box-shadow: 3px 3px 0 var(--color-brand-white);
    transition: box-shadow 0.1s, transform 0.1s;
    display: inline-block;
  }

  .nav-cta:hover {
    box-shadow: 1px 1px 0 var(--color-brand-white);
    transform: translate(2px, 2px);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-brand-white);
  }

  @media (max-width: 768px) {
    .nav-toggle {
      display: flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      background-color: var(--color-dark);
      border-bottom: 2px solid #1C1C1C;
      padding: 1rem 1.5rem 1.5rem;
    }

    .nav-links--open {
      display: flex;
    }

    .nav-item {
      width: 100%;
    }

    .nav-link {
      padding: 0.75rem 0;
      width: 100%;
      justify-content: space-between;
    }

    /* Hide desktop dropdown panels on mobile */
    .dropdown-panel {
      display: none !important;
    }

    /* Mobile sub-links shown via JS toggle */
    .mobile-sub-links--open {
      display: flex;
      flex-direction: column;
      padding-left: 1rem;
      border-left: 2px solid #2a2a2a;
      margin-bottom: 0.5rem;
    }

    .mobile-sub-link {
      font-family: var(--font-heading);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.6rem 0.5rem;
      color: rgba(255,255,255,0.65);
      border-bottom: 1px solid #1e1e1e;
      display: block;
      transition: color 0.12s;
    }
    .mobile-sub-link:last-child {
      border-bottom: none;
    }
    .mobile-sub-link:hover,
    .mobile-sub-link--active {
      color: var(--color-brand-white);
    }
    .mobile-sub-link--all {
      color: var(--color-brand-red);
    }
    .mobile-sub-link--pending {
      color: rgba(255,255,255,0.3);
      font-style: italic;
      cursor: default;
    }

    .nav-cta {
      margin-top: 0.75rem;
    }
  }
</style>
