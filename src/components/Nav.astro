---
import { services } from '../data/services';

const otherLinks = [
  { href: '/projects', label: 'Projects' },
  { href: '/design', label: 'Design' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const isServicesActive = currentPath.startsWith('/services');
---

<header class="nav-header">
  <nav class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Stronghold Home">
      <img src="/logo-white.png" alt="" class="logo-mark" aria-hidden="true" />
      <span class="logo-text">STRONGHOLD</span>
    </a>

    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <ul class="nav-links" id="nav-links">
      <!-- Services dropdown -->
      <li class="nav-item nav-item--dropdown" id="services-dropdown-item">
        <button
          class={`nav-link nav-link--dropdown-trigger ${isServicesActive ? 'nav-link--active' : ''}`}
          id="services-toggle"
          aria-haspopup="true"
          aria-expanded="false"
        >
          Services
          <svg class="chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="dropdown-panel" id="services-panel" role="menu">
          <div class="dropdown-services">
            {services.map(s => (
              <a
                href={`/services/${s.slug}`}
                class={`dropdown-service-link ${currentPath === `/services/${s.slug}` ? 'dropdown-service-link--active' : ''}`}
                role="menuitem"
              >
                <span class="dropdown-service-label">{s.label}</span>
                <span class="dropdown-service-tagline">{s.tagline}</span>
              </a>
            ))}
          </div>
          <div class="dropdown-footer">
            <a href="/services" class="dropdown-all-link" role="menuitem">
              View All Services &rarr;
            </a>
          </div>
        </div>

        <!-- Mobile sub-links (shown inline when expanded) -->
        <ul class="mobile-sub-links" id="mobile-sub-links" aria-label="Service pages">
          {services.map(s => (
            <li>
              <a
                href={`/services/${s.slug}`}
                class={`mobile-sub-link ${currentPath === `/services/${s.slug}` ? 'mobile-sub-link--active' : ''}`}
              >
                {s.label}
              </a>
            </li>
          ))}
          <li>
            <a href="/services" class="mobile-sub-link mobile-sub-link--all">All Services &rarr;</a>
          </li>
        </ul>
      </li>

      {otherLinks.map(link => (
        <li>
          <a
            href={link.href}
            class={`nav-link ${currentPath.startsWith(link.href) ? 'nav-link--active' : ''}`}
          >
            {link.label}
          </a>
        </li>
      ))}

      <li>
        <a href="/quote" class="nav-cta">Get a Quote</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const navToggle = document.getElementById('nav-toggle');
  const navLinks = document.getElementById('nav-links');
  const servicesToggle = document.getElementById('services-toggle');
  const servicesPanel = document.getElementById('services-panel');
  const mobileSubLinks = document.getElementById('mobile-sub-links');
  const dropdownItem = document.getElementById('services-dropdown-item');

  // Hamburger: open/close full menu
  navToggle?.addEventListener('click', () => {
    const open = navLinks?.classList.toggle('nav-links--open');
    navToggle.setAttribute('aria-expanded', String(open));
  });

  // Services button: on desktop toggle dropdown panel; on mobile toggle sub-links
  let skipNextDocClick = false;

  servicesToggle?.addEventListener('click', () => {
    const isMobile = window.innerWidth <= 768;
    if (isMobile) {
      const open = mobileSubLinks?.classList.toggle('mobile-sub-links--open');
      servicesToggle.setAttribute('aria-expanded', String(!!open));
      servicesToggle.classList.toggle('services-toggle--open', !!open);
    } else {
      const open = dropdownItem?.classList.toggle('dropdown--open');
      servicesToggle.setAttribute('aria-expanded', String(!!open));
      skipNextDocClick = true;
    }
  });

  // Close dropdown when clicking outside
  document.addEventListener('click', (e) => {
    if (skipNextDocClick) { skipNextDocClick = false; return; }
    if (!dropdownItem?.contains(e.target as Node)) {
      dropdownItem?.classList.remove('dropdown--open');
      servicesToggle?.setAttribute('aria-expanded', 'false');
    }
  });

  // Close dropdown on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      dropdownItem?.classList.remove('dropdown--open');
      servicesToggle?.setAttribute('aria-expanded', 'false');
      servicesToggle?.focus();
    }
  });
</script>

<style>
  .nav-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-dark);
    border-bottom: 2px solid #1C1C1C;
  }

  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-mark {
    height: 38px;
    width: auto;
    display: block;
    flex-shrink: 0;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-brand-red);
    letter-spacing: 0.15em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Nav item base */
  .nav-item {
    position: relative;
  }

  .nav-link {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.5rem 0.75rem;
    color: var(--color-brand-white);
    opacity: 0.7;
    transition: opacity 0.15s;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  /* Make the services trigger a button that looks like a link */
  .nav-link--dropdown-trigger {
    background: none;
    border: none;
    cursor: pointer;
    line-height: 1;
  }

  .nav-link:hover,
  .nav-link--active {
    opacity: 1;
  }

  .nav-link--active {
    border-bottom: 2px solid var(--color-brand-red);
  }

  /* Chevron */
  .chevron {
    transition: transform 0.2s ease;
    opacity: 0.7;
    flex-shrink: 0;
  }
  .services-toggle--open .chevron,
  .dropdown--open .nav-link--dropdown-trigger .chevron {
    transform: rotate(180deg);
    opacity: 1;
  }

  /* Dropdown panel — desktop */
  .dropdown-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 320px;
    background-color: #111111;
    border: 2px solid #2a2a2a;
    border-top: 3px solid var(--color-brand-red);
    box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    opacity: 0;
    visibility: hidden;
    transform: translateX(-50%) translateY(-6px);
    transition: opacity 0.15s ease, visibility 0.15s ease, transform 0.15s ease;
    pointer-events: none;
  }

  /* Show via JS toggle class (click / keyboard) */
  .nav-item--dropdown.dropdown--open .dropdown-panel {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }

  .dropdown-services {
    padding: 0.5rem 0;
  }

  .dropdown-service-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem 1.25rem;
    transition: background-color 0.12s;
    border-left: 3px solid transparent;
  }
  .dropdown-service-link:hover,
  .dropdown-service-link--active {
    background-color: rgba(255,255,255,0.06);
    border-left-color: var(--color-brand-red);
  }
  .dropdown-service-label {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-white);
  }
  .dropdown-service-tagline {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.45);
    line-height: 1.3;
  }

  .dropdown-footer {
    border-top: 1px solid #2a2a2a;
    padding: 0.75rem 1.25rem;
  }
  .dropdown-all-link {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    transition: opacity 0.15s;
  }
  .dropdown-all-link:hover {
    opacity: 0.7;
  }

  /* Mobile sub-links: hidden by default on mobile */
  .mobile-sub-links {
    display: none;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-cta {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.5rem 1.25rem;
    background-color: var(--color-brand-red);
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-red);
    box-shadow: 3px 3px 0 var(--color-brand-white);
    transition: box-shadow 0.1s, transform 0.1s;
    display: inline-block;
  }

  .nav-cta:hover {
    box-shadow: 1px 1px 0 var(--color-brand-white);
    transform: translate(2px, 2px);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-brand-white);
  }

  @media (max-width: 768px) {
    .nav-toggle {
      display: flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      background-color: var(--color-dark);
      border-bottom: 2px solid #1C1C1C;
      padding: 1rem 1.5rem 1.5rem;
    }

    .nav-links--open {
      display: flex;
    }

    .nav-item {
      width: 100%;
    }

    .nav-link {
      padding: 0.75rem 0;
      width: 100%;
      justify-content: space-between;
    }

    /* Hide desktop dropdown panel on mobile */
    .dropdown-panel {
      display: none !important;
    }

    /* Mobile sub-links shown via JS toggle */
    .mobile-sub-links--open {
      display: flex;
      flex-direction: column;
      padding-left: 1rem;
      border-left: 2px solid #2a2a2a;
      margin-bottom: 0.5rem;
    }

    .mobile-sub-link {
      font-family: var(--font-heading);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.6rem 0.5rem;
      color: rgba(255,255,255,0.65);
      border-bottom: 1px solid #1e1e1e;
      display: block;
      transition: color 0.12s;
    }
    .mobile-sub-link:last-child {
      border-bottom: none;
    }
    .mobile-sub-link:hover,
    .mobile-sub-link--active {
      color: var(--color-brand-white);
    }
    .mobile-sub-link--all {
      color: var(--color-brand-red);
    }

    .nav-cta {
      margin-top: 0.75rem;
    }
  }
</style>
