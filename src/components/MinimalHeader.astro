---
// Slim header for single-purpose campaign landing pages: logo + click-to-call only.
// No nav links, no dropdowns — nothing to exit through except the phone number.
import { Image } from 'astro:assets';
import logoMark from '../assets/logo-white.png';
---

<header class="min-header">
  <div class="min-header-inner">
    <a href="/" class="min-logo" aria-label="Stronghold Home">
      <Image
        src={logoMark}
        alt=""
        class="min-logo-mark"
        aria-hidden="true"
        width={45}
        densities={[1, 2]}
        loading="eager"
      />
      <span class="min-logo-text">STRONGHOLD</span>
    </a>
    <a href="tel:+19289627535" class="min-header-phone">
      <span class="min-header-phone-label">Call Now</span>
      <span class="min-header-phone-number">(928) 962-7535</span>
    </a>
  </div>
</header>

<style>
  .min-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-dark);
    border-bottom: 2px solid #1c1c1c;
  }

  .min-header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .min-logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .min-logo-mark {
    height: 34px;
    width: auto;
    display: block;
    flex-shrink: 0;
  }

  .min-logo-text {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-brand-red);
    letter-spacing: 0.15em;
  }

  .min-header-phone {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.2;
    text-decoration: none;
  }

  .min-header-phone-label {
    font-family: var(--font-heading);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .min-header-phone-number {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-brand-white);
  }

  @media (max-width: 480px) {
    .min-header-phone-number { font-size: 0.9rem; }
  }
</style>
