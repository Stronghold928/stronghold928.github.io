---
// Visible breadcrumb and BreadcrumbList schema for a specialty landing page,
// both built from the same trail so they cannot disagree. The trail runs
// through the parent service (Home / Services / Remodeling / Kitchen Remodel),
// which gives every specialty page a crawlable link up to its parent and lets
// Google show the hierarchy in results.
import { services, landingPages } from '../data/services';

interface Props {
  /** Slug of the landing page in `landingPages`. */
  slug: string;
}

const SITE = 'https://builtstronghold.com';
const page = landingPages.find(l => l.slug === Astro.props.slug);
if (!page) throw new Error(`ServiceBreadcrumb: no landing page with slug "${Astro.props.slug}"`);
const parent = services.find(s => s.slug === page.parentService);
if (!parent) throw new Error(`ServiceBreadcrumb: "${page.slug}" names unknown parent "${page.parentService}"`);

const trail = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: parent.label, href: `/services/${parent.slug}/` },
  { name: page.navLabel, href: `/services/${page.slug}/` },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.name,
    item: `${SITE}${t.href}`,
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<nav aria-label="Breadcrumb" class="breadcrumb">
  <div class="breadcrumb-inner">
    <ol class="breadcrumb-list">
      {trail.map((t, i) => i < trail.length - 1 ? (
        <>
          <li><a href={t.href}>{t.name}</a></li>
          <li aria-hidden="true">/</li>
        </>
      ) : (
        <li aria-current="page">{t.name}</li>
      ))}
    </ol>
  </div>
</nav>

<style>
  /* Matches the project page breadcrumb. */
  .breadcrumb {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .breadcrumb-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
  }
  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.8rem;
  }
  .breadcrumb-list a {
    color: var(--color-brand-red);
    opacity: 0.8;
    transition: opacity 0.15s;
  }
  .breadcrumb-list a:hover { opacity: 1; }
  .breadcrumb-list [aria-hidden] { opacity: 0.4; }
  .breadcrumb-list [aria-current] { opacity: 0.6; }
</style>
