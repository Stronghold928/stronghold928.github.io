---
import LogoMark from './LogoMark.astro';
import { services as serviceData, landingPages } from '../data/services';
import { commercialServices } from '../data/commercial';
import { serviceAreas } from '../data/service-areas';

const year = new Date().getFullYear();

const services = [
  ...serviceData.map(s => ({ href: `/services/${s.slug}/`, label: s.label })),
  ...landingPages.map(l => ({ href: `/services/${l.slug}/`, label: l.navLabel })),
];

const commercial = [
  ...commercialServices.map(c => ({ href: `/commercial/${c.slug}/`, label: c.navLabel })),
  { href: '/commercial/capabilities/', label: 'Capabilities' },
  { href: '/commercial/bid-request/', label: 'Request a Bid' },
];

const company = [
  { href: '/about/', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: '/design/', label: 'Design' },
  { href: '/contact/', label: 'Contact' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/news/', label: 'News' },
  { href: '/service-areas/', label: 'Service Areas' },
];
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="Stronghold Construction — home">
        <LogoMark height={44} />
        <span class="logo-wordmark">
          <span class="logo-name">Stronghold</span>
          <span class="logo-suffix">Construction</span>
        </span>
      </a>
      <p class="footer-tagline">
        Building better homes and stronger communities across northern Arizona.
      </p>
      <address class="footer-address">
        <span class="footer-address-name">Stronghold Construction</span>
        <span>1155 W Kaibab Lane</span>
        <span>Flagstaff, AZ 86001</span>
        <a href="tel:+19289627535">(928) 962-7535</a>
      </address>
      <p class="footer-location">Serving Flagstaff &amp; Northern Arizona</p>
      <p class="footer-license">AZ ROC License: 354046</p>
    </div>

    <div class="footer-nav">
      <div class="footer-col">
        <h2 class="footer-col-title">Residential</h2>
        <ul>
          {services.map(link => (
            <li><a href={link.href} class="footer-link">{link.label}</a></li>
          ))}
        </ul>
        <h2 class="footer-col-title footer-col-title--second">Commercial</h2>
        <ul>
          {commercial.map(link => (
            <li><a href={link.href} class="footer-link">{link.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <h2 class="footer-col-title">Company</h2>
        <ul>
          {company.map(link => (
            <li><a href={link.href} class="footer-link">{link.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <h2 class="footer-col-title">Service Areas</h2>
        <ul>
          {serviceAreas.map(a => (
            <li><a href={`/service-areas/${a.slug}/`} class="footer-link">{a.cityName}, {a.stateAbbr}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <h2 class="footer-col-title">Contact</h2>
        <ul>
          <li><a href="tel:+19289627535" class="footer-link">(928) 962-7535</a></li>
          <li><a href="mailto:hello@builtstronghold.com" class="footer-link">hello@builtstronghold.com</a></li>
        </ul>
        <a href="/quote/" class="footer-cta">Get a Quote &rarr;</a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <p>&copy; {year} Stronghold. All rights reserved.</p>
      <nav class="footer-legal-links" aria-label="Legal">
        <a href="/privacy/" class="footer-legal-link">Privacy Policy</a>
        <span aria-hidden="true">&middot;</span>
        <a href="/terms/" class="footer-legal-link">Terms of Use</a>
        <span aria-hidden="true">&middot;</span>
        <a href="/accessibility/" class="footer-legal-link">Accessibility</a>
      </nav>
      <p class="footer-values">Integrity &bull; Honesty &bull; Community</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-dark);
    border-top: 3px solid var(--color-brand-red);
    margin-top: 6rem;
    color: #F5F5F5;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
  }

  .footer-address {
    font-style: normal;
    font-size: 0.85rem;
    line-height: 1.7;
    opacity: 0.75;
    margin-bottom: 0.75rem;
    display: flex;
    flex-direction: column;
  }
  .footer-address-name {
    font-family: var(--font-heading);
    font-weight: 700;
    opacity: 1;
  }
  .footer-address a:hover {
    color: var(--color-brand-red);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    text-decoration: none;
    /* Astro scoped styles don't reach a child component's root node, so the
       mark reads its mountain colour off `currentColor` set here. */
    color: var(--color-brand-white);
  }

  .logo-wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .logo-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.35rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-brand-white);
  }

  .logo-suffix {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.33em;
    color: var(--color-brand-red);
    margin-top: 0.25rem;
  }

  .footer-tagline {
    color: var(--color-brand-white);
    opacity: 0.7;
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 0.75rem;
    max-width: 280px;
  }

  .footer-location,
  .footer-license {
    font-size: 0.8rem;
    opacity: 0.5;
    margin-bottom: 0.25rem;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .footer-col-title--second {
    margin-top: 1.75rem;
  }

  .footer-col-title {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-brand-red);
    margin-bottom: 1rem;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-link {
    font-size: 0.875rem;
    color: var(--color-brand-white);
    opacity: 0.7;
    transition: opacity 0.15s;
  }

  .footer-link:hover {
    opacity: 1;
  }

  .footer-cta {
    display: inline-block;
    margin-top: 1.25rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.5rem 1rem;
    background-color: var(--color-brand-red);
    color: var(--color-brand-white);
    border: 2px solid var(--color-brand-red);
    box-shadow: 3px 3px 0 var(--color-brand-white);
    transition: box-shadow 0.1s, transform 0.1s;
  }

  .footer-cta:hover {
    box-shadow: 1px 1px 0 var(--color-brand-white);
    transform: translate(2px, 2px);
  }

  .footer-bottom {
    border-top: 1px solid #2A2A2A;
  }

  .footer-bottom-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    opacity: 0.5;
  }

  .footer-values {
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.7rem;
  }

  .footer-legal-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-legal-link {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .footer-legal-link:hover {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer-nav {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-bottom-inner {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .footer-nav {
      grid-template-columns: 1fr;
    }
  }
</style>
