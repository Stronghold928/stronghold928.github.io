---
// Stronghold mark from the 2026 logo kit: the roofline range with the sun above it.
// The mountain inherits `currentColor` so the parent link controls it; the sun stays
// brand red on every surface unless `--logo-sun` overrides it.
interface Props {
  /** Rendered height in px. Width follows the 355:136.2 aspect of the mark. */
  height?: number;
  class?: string;
}

const { height = 32, class: className } = Astro.props;
const width = Math.round((height * 355) / 136.2);
---

