  // ── Filler elements ───────────────────────────────────────────
  function northArrow(cx,cy,p){
    if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);
    const r=20;g.beginPath();g.arc(cx,cy,r,0,Math.PI*2);g.lineWidth=.75;g.strokeStyle=INK;g.stroke();
    g.beginPath();g.moveTo(cx,cy-r+3);g.lineTo(cx-7,cy+r-5);g.lineTo(cx,cy-4);g.closePath();g.fillStyle=INK;g.fill();
    g.beginPath();g.moveTo(cx,cy-r+3);g.lineTo(cx+7,cy+r-5);g.lineTo(cx,cy-4);g.closePath();g.strokeStyle=INK;g.lineWidth=.75;g.stroke();
    Tx('N',cx,cy-r-11,9,INK);g.restore();
  }
  function scaleBar(x,y,p){
    if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);Tx("SCALE: 1/4\" = 1'-0\"",x+56,y-13,7,DIM);
    const segs=4,sw=28;for(let i=0;i<segs;i++){g.fillStyle=i%2===0?INK:BG;g.fillRect(x+i*sw,y,sw,7);Rs(x+i*sw,y,sw,7,.75);}
    for(let i=0;i<=segs;i++)Tx(String(i*4)+"'",x+i*sw,y+14,6.5,DIM);
    g.restore();
  }
  function elecLegend(x,y,p){
    if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);Tx('ELECTRICAL LEGEND',x+68,y,7.5,INK);
    [['light','CEILING FIXTURE'],['outlet','DUPLEX OUTLET'],['smoke','SMOKE DETECTOR'],['sw','SINGLE-POLE SW']].forEach(([t,lbl],i)=>{
      const ix=x+10,iy=y+18+i*22;g.strokeStyle=INK;g.lineWidth=.75;
      if(t==='light'){g.beginPath();g.arc(ix,iy,6,0,Math.PI*2);g.stroke();g.beginPath();g.moveTo(ix-6,iy);g.lineTo(ix+6,iy);g.moveTo(ix,iy-6);g.lineTo(ix,iy+6);g.stroke();}
      else if(t==='outlet'){g.beginPath();g.arc(ix,iy,4.5,0,Math.PI*2);g.stroke();g.beginPath();g.moveTo(ix-1.5,iy-3);g.lineTo(ix-1.5,iy-.5);g.moveTo(ix+1.5,iy-3);g.lineTo(ix+1.5,iy-.5);g.stroke();}
      else if(t==='smoke'){g.beginPath();g.arc(ix,iy,5,0,Math.PI*2);g.stroke();g.beginPath();g.arc(ix,iy,2.5,0,Math.PI*2);g.stroke();}
      else{g.beginPath();g.arc(ix,iy,4,0,Math.PI*2);g.stroke();L(ix+4,iy-5,ix+4,iy+5,1.2,INK);Tx('S',ix,iy,6,INK);}
      Tx(lbl,x+23,iy,6.5,DIM,'left');
    });
    g.restore();
  }
