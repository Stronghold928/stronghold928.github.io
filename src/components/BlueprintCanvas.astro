---
// Scrolling architectural blueprint animation — purely decorative.
---

<div class="blueprint-wrap" aria-hidden="true">
  <canvas id="blueprint-canvas"></canvas>
</div>

<style>
  .blueprint-wrap {
    position: absolute;
    /* Spans the full hero width; the hero-inner box (higher in DOM order,
       opaque background) sits on top of it via z-index, so the blueprint
       reads as continuing underneath the box all the way to the left edge. */
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: visible;
    z-index: 1;
    pointer-events: none;
  }
  #blueprint-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  @media (max-width: 900px) {
    .blueprint-wrap { display: none; }
  }
</style>

<script is:inline>
(function () {
  const cv = document.getElementById('blueprint-canvas');
  if (!cv) return;
  const g = cv.getContext('2d');
  let W = 0, H = 0, DPR = 1, animStarted = false;

  const ro = new ResizeObserver(() => {
    DPR = Math.min(window.devicePixelRatio || 1, 2);
    W = cv.clientWidth; H = cv.clientHeight;
    cv.width = Math.round(W * DPR); cv.height = Math.round(H * DPR);
    if (!animStarted && W > 0 && H > 0) {
      animStarted = true;
      requestAnimationFrame(drawFrame);
    }
  });
  ro.observe(cv);

  const CONFIG = { speed: 38, lineW: 1 };
  let INK = '#1a1a1a', GRAY = '#585858', DIM = '#686868';
  const RED = '#be231a', REDF = 'rgba(190,35,26,0.07)', BG = '#fff';
  const SW = 2900;
  let sx = 0, lt = null;

  // ── Primitives ────────────────────────────────────────────────
  function L(x1,y1,x2,y2,lw,c){g.save();g.beginPath();g.moveTo(x1,y1);g.lineTo(x2,y2);g.lineWidth=lw||1;g.strokeStyle=c||INK;g.stroke();g.restore();}
  function Rf(x,y,w,h,c){g.fillStyle=c||BG;g.fillRect(x,y,w,h);}
  function Rs(x,y,w,h,lw,c){g.save();g.strokeStyle=c||INK;g.lineWidth=lw||1;g.strokeRect(x,y,w,h);g.restore();}
  function Tx(s,x,y,sz,c,al){g.save();g.font=`${sz}px "Courier New",monospace`;g.fillStyle=c||DIM;g.textAlign=al||'center';g.textBaseline='middle';g.fillText(s,x,y);g.restore();}
  function Ar(cx,cy,r,a1,a2,ccw,lw,c,dash){g.save();g.beginPath();g.arc(cx,cy,r,a1,a2,ccw);g.lineWidth=lw;g.strokeStyle=c;if(dash)g.setLineDash(dash);g.stroke();g.setLineDash([]);g.restore();}

  // ── Windows ───────────────────────────────────────────────────
  function winH(x,y,len){Rf(x,y-5,len,10);g.save();g.strokeStyle=INK;g.lineWidth=0.8;g.beginPath();g.moveTo(x,y-2.5);g.lineTo(x+len,y-2.5);g.moveTo(x,y);g.lineTo(x+len,y);g.moveTo(x,y+2.5);g.lineTo(x+len,y+2.5);g.stroke();g.restore();}
  function winV(x,y,len){Rf(x-5,y,10,len);g.save();g.strokeStyle=INK;g.lineWidth=0.8;g.beginPath();g.moveTo(x-2.5,y);g.lineTo(x-2.5,y+len);g.moveTo(x,y);g.lineTo(x,y+len);g.moveTo(x+2.5,y);g.lineTo(x+2.5,y+len);g.stroke();g.restore();}

  // ── Doors ─────────────────────────────────────────────────────
  function doorH(hx,hy,len,north,hingeLeft){
    Rf(hingeLeft?hx:hx-len,hy-5,len,10);
    const sy=north?-1:1; L(hx,hy,hx,hy+sy*len,1.5,INK);
    const a0=sy*Math.PI/2,a1=hingeLeft?0:Math.PI,ccw=north!==hingeLeft;
    Ar(hx,hy,len,a0,a1,ccw,0.75,GRAY,[3,3]);
  }
  function doorV(hx,hy,len,east,hingeTop){
    Rf(hx-5,hy,10,len);
    const sx2=east?1:-1; L(hx,hy,hx+sx2*len,hy,1.5,INK);
    const a0=east?0:Math.PI,a1=hingeTop?Math.PI/2:-Math.PI/2,ccw=!east!==!hingeTop;
    Ar(hx,hy,len,a0,a1,ccw,0.75,GRAY,[3,3]);
  }

  // ── Fixtures ──────────────────────────────────────────────────
  function light(x,y,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);g.beginPath();g.arc(x,y,7,0,Math.PI*2);g.lineWidth=0.75;g.strokeStyle=INK;g.stroke();g.beginPath();g.moveTo(x-7,y);g.lineTo(x+7,y);g.moveTo(x,y-7);g.lineTo(x,y+7);g.lineWidth=0.5;g.stroke();g.restore();}
  function outlet(x,y,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);g.beginPath();g.arc(x,y,4.5,0,Math.PI*2);g.lineWidth=0.75;g.strokeStyle=INK;g.stroke();g.beginPath();g.moveTo(x-1.5,y-3);g.lineTo(x-1.5,y-0.5);g.moveTo(x+1.5,y-3);g.lineTo(x+1.5,y-0.5);g.lineWidth=0.75;g.stroke();g.restore();}
  function swsym(x,y,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);g.beginPath();g.arc(x,y,4,0,Math.PI*2);g.lineWidth=0.75;g.strokeStyle=INK;g.stroke();L(x+4,y-6,x+4,y+6,1.2,INK);Tx('S',x,y,6,INK);g.restore();}
  function smoke(x,y,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);g.beginPath();g.arc(x,y,5,0,Math.PI*2);g.lineWidth=0.75;g.strokeStyle=INK;g.stroke();g.beginPath();g.arc(x,y,2.5,0,Math.PI*2);g.stroke();g.restore();}
  function toilet(x,y,rot,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);g.translate(x,y);g.rotate(rot);Rs(-9,-19,18,10,1);g.beginPath();g.ellipse(0,5,8.5,12,0,0,Math.PI*2);g.lineWidth=1;g.strokeStyle=INK;g.stroke();g.restore();}
  function lav(x,y,w,h,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);Rs(x,y,w,h,1);g.beginPath();g.ellipse(x+w/2,y+h/2,w/2-3,h/2-3,0,0,Math.PI*2);g.lineWidth=0.75;g.strokeStyle=INK;g.stroke();g.restore();}
  function tub(x,y,w,h,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);Rs(x,y,w,h,1);g.beginPath();g.ellipse(x+w/2,y+h*.57,w/2-5,h*.3,0,0,Math.PI*2);g.lineWidth=0.75;g.strokeStyle=INK;g.stroke();L(x+w*.25,y+6,x+w*.75,y+6,1,INK);g.restore();}
  function stove(x,y,w,h,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);Rs(x,y,w,h,1);const r=Math.min(w,h)*.16;[[.28,.28],[.72,.28],[.28,.72],[.72,.72]].forEach(([fx,fy])=>{g.beginPath();g.arc(x+w*fx,y+h*fy,r,0,Math.PI*2);g.strokeStyle=INK;g.lineWidth=0.75;g.stroke();g.beginPath();g.arc(x+w*fx,y+h*fy,r*.4,0,Math.PI*2);g.stroke();});g.restore();}
  function fridge(x,y,w,h,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);Rs(x,y,w,h,1);L(x,y+h*.32,x+w,y+h*.32,.7,DIM);g.restore();}
  function stair(x,y,w,h,n,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);Rs(x,y,w,h,.75,DIM);const s=h/n;for(let i=1;i<n;i++)L(x,y+i*s,x+w,y+i*s,.45,DIM);const ax=x+w/2;L(ax,y+h*.82,ax,y+h*.18,1,DIM);L(ax-5,y+h*.28,ax,y+h*.18,1,DIM);L(ax+5,y+h*.28,ax,y+h*.18,1,DIM);Tx('UP',ax,y+h*.6,7,DIM);g.restore();}
  function showerStall(x,y,w,h,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);Rs(x,y,w,h,1);const step=8;for(let xi=x+step;xi<x+w;xi+=step)L(xi,y,xi-(h),y+h,.35,DIM);g.restore();}
  function closetRod(x,y,len,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);L(x,y,x+len,y,.85,DIM);for(let xi=x+6;xi<x+len;xi+=10)L(xi,y,xi,y+8,.5,DIM);g.restore();}
  function fireplace(x,y,w,h,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);Rs(x,y,w,h,1.2);const m=6;Rf(x+m,y+m,w-m*2,h-m*2,'#e8e8e8');Rs(x+m,y+m,w-m*2,h-m*2,.65);L(x,y,x+w,y+h,.65,DIM);L(x+w,y,x,y+h,.65,DIM);g.restore();}

  // ── Furniture ─────────────────────────────────────────────────
  function sofa(x,y,w,h,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*.9);Rs(x,y,w,h,.5,DIM);Rs(x,y,w,h*.28,.4,DIM);L(x+w/2,y+h*.28,x+w/2,y+h,.4,DIM);g.restore();}
  function diningSet(x,y,w,h,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*.8);Rs(x,y,w,h,.5,DIM);[[x-11,y+h*.15],[x-11,y+h*.6],[x+w,y+h*.15],[x+w,y+h*.6]].forEach(([cx,cy])=>Rs(cx,cy,11,h*.22,.4,DIM));g.restore();}
  function bed(x,y,w,h,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*.85);Rs(x,y,w,h,.5,DIM);Rs(x,y,w,h*.2,.4,DIM);g.beginPath();g.ellipse(x+w/2,y+h*.6,w*.3,h*.24,0,0,Math.PI*2);g.lineWidth=.4;g.strokeStyle=DIM;g.stroke();g.restore();}

  // ── Dimensions ────────────────────────────────────────────────
  function dimH(x1,x2,y,lbl,p,off){off=off||14;if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*1.5);g.strokeStyle=DIM;g.lineWidth=.75;g.beginPath();g.moveTo(x1,y+3);g.lineTo(x1,y-off-3);g.moveTo(x2,y+3);g.lineTo(x2,y-off-3);g.stroke();const xe=x1+(x2-x1)*Math.min(1,p*1.1);L(x1,y-off,xe,y-off,.75,DIM);if(p>.84){L(x1,y-off-2,x1+7,y-off+2,.75,DIM);L(x2-7,y-off-2,x2,y-off+2,.75,DIM);}if(p>.92){g.save();g.globalAlpha=(p-.92)*13;Tx(lbl,(x1+x2)/2,y-off-9,7.5,DIM);g.restore();}g.restore();}
  function dimV(x,y1,y2,lbl,p,off){off=off||14;if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*1.5);g.strokeStyle=DIM;g.lineWidth=.75;g.beginPath();g.moveTo(x+3,y1);g.lineTo(x-off-3,y1);g.moveTo(x+3,y2);g.lineTo(x-off-3,y2);g.stroke();const ye=y1+(y2-y1)*Math.min(1,p*1.1);L(x-off,y1,x-off,ye,.75,DIM);if(p>.84){L(x-off-2,y1,x-off+2,y1+7,.75,DIM);L(x-off+2,y2-7,x-off-2,y2,.75,DIM);}if(p>.92){g.save();g.globalAlpha=(p-.92)*13;g.translate(x-off-9,(y1+y2)/2);g.rotate(-Math.PI/2);Tx(lbl,0,0,7.5,DIM);g.restore();}g.restore();}
  function rlabel(lines,x,y,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*3.5);lines.forEach((s,i)=>Tx(s,x,y+i*10,8,GRAY));g.restore();}
  function dimSub(x1,x2,y,lbl,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*1.2);g.strokeStyle=DIM;g.lineWidth=.5;const off=8;g.beginPath();g.moveTo(x1,y-2);g.lineTo(x1,y-off-2);g.moveTo(x2,y-2);g.lineTo(x2,y-off-2);g.stroke();L(x1,y-off,x2,y-off,.5,DIM);Tx(lbl,(x1+x2)/2,y-off-7,6,DIM);g.restore();}

  // ── Progress ──────────────────────────────────────────────────
  function getProg(screenX){const st=W*.9,en=W*.08;if(screenX>st)return 0;if(screenX<en)return 1;return(st-screenX)/(st-en);}
  // Red markup draws in as element scrolls into view — starts at right edge, fully drawn by mid-screen
  function getRedProg(screenX){const s=W*.85,e=W*.35;if(screenX>s)return 0;if(screenX<e)return 1;return(s-screenX)/(s-e);}

  // ── Structural column grid ────────────────────────────────────
  function colGrid(ox,oy,planH,xs,labels){
    g.save();g.globalAlpha=.65;
    xs.forEach((cx,i)=>{
      g.setLineDash([5,3,1,3]);g.strokeStyle='#b4c0cc';g.lineWidth=.5;
      g.beginPath();g.moveTo(ox+cx,oy-34);g.lineTo(ox+cx,oy+planH+20);g.stroke();g.setLineDash([]);
      g.beginPath();g.arc(ox+cx,oy-22,10,0,Math.PI*2);g.strokeStyle='#8a9cb0';g.lineWidth=.65;g.stroke();
      Tx(labels[i],ox+cx,oy-22,7.5,'#607080');
    });
    g.restore();
  }
  function sectionLine(x1,y1,x2,y2,label,p){
    if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*1.5);
    g.setLineDash([6,3]);L(x1,y1,x2,y2,.7,DIM);g.setLineDash([]);
    [[x1,y1],[x2,y2]].forEach(([cx,cy])=>{g.beginPath();g.arc(cx,cy,10,0,Math.PI*2);g.strokeStyle=DIM;g.lineWidth=.65;g.stroke();Tx(label,cx,cy,7,DIM);});
    g.restore();
  }

  // ── Dynamic red markup ────────────────────────────────────────
  // revCloudDyn: draws arcs progressively as rp goes 0→1
  function revCloudDyn(x,y,w,h,rp,tag){
    if(rp<=0)return;
    g.save();g.globalAlpha=Math.min(1,rp*1.4);
    const r=7;
    const nh=Math.max(3,Math.round(w/19)),nv=Math.max(2,Math.round(h/19));
    const totalSegs=nh*2+nv*2;
    const drawSegs=Math.floor(rp*totalSegs);

    // collect all arc midpoints and endpoints for each segment of the cloud
    function buildArcs(x1,y1,x2,y2,n,out){
      const dx=x2-x1,dy=y2-y1,len=Math.sqrt(dx*dx+dy*dy),nx=dy/len*r,ny=-dx/len*r;
      for(let i=0;i<n;i++){
        const tm=(2*i+1)/(2*n);
        out.push({cpx:x1+dx*tm+nx,cpy:y1+dy*tm+ny,ex:x1+dx*(i+1)/n,ey:y1+dy*(i+1)/n});
      }
    }
    const arcs=[];
    buildArcs(x,y,x+w,y,nh,arcs);
    buildArcs(x+w,y,x+w,y+h,nv,arcs);
    buildArcs(x+w,y+h,x,y+h,nh,arcs);
    buildArcs(x,y+h,x,y,nv,arcs);

    const drawCount=Math.min(drawSegs,arcs.length);
    if(drawCount<=0){g.restore();return;}

    // fill: only draw fill when cloud is mostly complete
    if(rp>.7){g.save();g.globalAlpha=Math.min(1,(rp-.7)*3.3)*0.65;g.fillStyle=REDF;g.beginPath();g.moveTo(x,y);arcs.forEach(a=>g.quadraticCurveTo(a.cpx,a.cpy,a.ex,a.ey));g.closePath();g.fill();g.restore();}

    g.beginPath();g.moveTo(x,y);
    for(let i=0;i<drawCount;i++) g.quadraticCurveTo(arcs[i].cpx,arcs[i].cpy,arcs[i].ex,arcs[i].ey);
    g.strokeStyle=RED;g.lineWidth=1.5;g.stroke();

    if(rp>.85&&tag){g.save();g.globalAlpha=(rp-.85)*6.5;Tx(tag,x+w/2,y-9,6.5,RED);g.restore();}
    g.restore();
  }

  // handNoteDyn: text reveals left-to-right via clipping rect
  function handNoteDyn(lines,x,y,rp,angle){
    if(rp<=0)return;
    const maxW=180;
    g.save();g.globalAlpha=Math.min(1,rp*1.8);
    g.translate(x,y);if(angle)g.rotate(angle);
    g.beginPath();g.rect(0,-2,maxW*Math.min(1,rp*1.3),lines.length*15+4);g.clip();
    g.font="600 12px 'Caveat',cursive";g.fillStyle=RED;g.textAlign='left';g.textBaseline='top';
    lines.forEach((line,i)=>g.fillText(line,0,i*15));
    g.restore();
  }

  // redArrDyn: grows arrow from tail to head
  function redArrDyn(x1,y1,x2,y2,rp){
    if(rp<=0)return;
    g.save();g.globalAlpha=Math.min(1,rp*2);
    const xe=x1+(x2-x1)*Math.min(1,rp),ye=y1+(y2-y1)*Math.min(1,rp);
    L(x1,y1,xe,ye,1,RED);
    if(rp>.85){
      const a=Math.atan2(y2-y1,x2-x1),fa=(rp-.85)*6.5;
      g.globalAlpha=Math.min(1,fa);
      g.beginPath();g.moveTo(x2,y2);g.lineTo(x2-8*Math.cos(a-.38),y2-8*Math.sin(a-.38));g.moveTo(x2,y2);g.lineTo(x2-8*Math.cos(a+.38),y2-8*Math.sin(a+.38));
      g.strokeStyle=RED;g.lineWidth=1;g.stroke();
    }
    g.restore();
  }

  // revDeltaDyn: scales in from center
  function revDeltaDyn(cx,cy,num,rp){
    if(rp<=0)return;
    const sc=Math.min(1,rp*1.5);
    g.save();g.globalAlpha=Math.min(1,rp*2);g.translate(cx,cy);g.scale(sc,sc);
    g.beginPath();g.moveTo(0,-9);g.lineTo(-7.5,4);g.lineTo(7.5,4);g.closePath();
    g.fillStyle=RED;g.fill();
    g.font='bold 7px "Courier New",monospace';g.fillStyle='#fff';g.textAlign='center';g.textBaseline='middle';g.fillText(String(num),0,1);
    g.restore();
  }

  // ═════════════════════════════════════════════════════════════
  // PLAN 1 — Craftsman Ranch  564 × 330
  // ═════════════════════════════════════════════════════════════
  const P1W=564,P1H=330;
  function plan1(ox,oy,p){
    // outer shell
    Rf(ox,oy,P1W,P1H,INK);
    // Garage (left block) 162 × 240
    Rf(ox+6,oy+6,156,234);
    // Storage/Mech below garage
    Rf(ox+6,oy+246,156,78);
    // Covered porch strip across top
    Rf(ox+168,oy,390,36,'#f0f0ec');
    Rs(ox+168,oy,390,36,.5,DIM);
    // Entry/Foyer
    Rf(ox+168,oy+42,66,84);
    // Powder bath
    Rf(ox+168,oy+132,66,54);
    // Laundry/Mud
    Rf(ox+168,oy+192,66,72);
    // Rear hall
    Rf(ox+168,oy+270,66,54);
    // Great Room (LR+DR combined)
    Rf(ox+240,oy+42,162,180);
    // Kitchen
    Rf(ox+240,oy+228,162,96);
    // Master Bedroom
    Rf(ox+408,oy+42,150,132);
    // WIC
    Rf(ox+408,oy+180,66,78);
    // Master Bath
    Rf(ox+480,oy+180,78,78);
    // Hall corridor
    Rf(ox+408,oy+264,150,12);
    // Bed 2
    Rf(ox+408,oy+282,96,42);
    // Bath 2
    Rf(ox+510,oy+282,48,42);

    // column grid
    colGrid(ox,oy,P1H,[0,168,240,402,480,564],['A','B','C','D','E','F']);
    sectionLine(ox-12,oy+135,ox+P1W+12,oy+135,'1',p);

    // sub-dimension ticks across top
    dimSub(ox+6,ox+162,oy-18,"26'-0\"",p);
    dimSub(ox+168,ox+402,oy-18,"39'-0\"",p);
    dimSub(ox+402,ox+558,oy-18,"26'-0\"",p);

    // interior walls / structural accents
    L(ox+402,oy+42,ox+402,oy+P1H-6,1.8,INK);   // main bedroom wall
    L(ox+240,oy+222,ox+402,oy+222,1.8,INK);    // kitchen separation

    // porch hatch marks
    g.save();g.globalAlpha=.35;g.strokeStyle=DIM;g.lineWidth=.4;
    for(let xi=ox+178;xi<ox+558;xi+=14)L(xi,oy+2,xi-28,oy+34,.35,DIM);
    g.restore();

    // garage door gap + label
    Rf(ox+24,oy,112,6,BG);
    L(ox+24,oy,ox+24,oy-6,.75,INK);L(ox+136,oy,ox+136,oy-6,.75,INK);
    Tx("18'-0\" O.H. DOOR",ox+80,oy-14,6.5,DIM);

    // fixtures — kitchen
    stove(ox+276,oy+280,40,38,p);
    fridge(ox+354,oy+230,26,44,p);
    lav(ox+244,oy+300,40,14,p);
    g.save();g.globalAlpha=Math.min(1,p*2);Rs(ox+292,oy+300,56,14,.75);Tx('DW',ox+320,oy+307,6,DIM);g.restore();
    // island
    Rs(ox+266,oy+238,100,42,1.5);Tx("ISLAND",ox+316,oy+259,6.5,DIM);

    // fixtures — master bath
    tub(ox+482,oy+182,72,40,p);
    showerStall(ox+484,oy+228,44,28,p);
    toilet(ox+536,oy+258,0,p);
    lav(ox+484,oy+258,30,18,p);

    // fixtures — powder
    toilet(ox+184,oy+154,0,p);
    lav(ox+170,oy+134,28,16,p);

    // fixtures — bath 2
    lav(ox+512,oy+284,28,16,p);
    toilet(ox+545,oy+310,-Math.PI/2,p);

    // WIC rods
    closetRod(ox+412,oy+192,58,p);
    closetRod(ox+412,oy+208,58,p);

