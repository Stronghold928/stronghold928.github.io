  // ── Draw loop ─────────────────────────────────────────────────
  function drawFrame(ts){
    if(lt!==null) sx+=(ts-lt)/1000*CONFIG.speed;
    lt=ts;
    [INK,GRAY,DIM]=CONFIG.palette;

    g.save();g.scale(DPR,DPR);
    Rf(0,0,W,H);

    const off=-((sx%SW+SW)%SW);
    for(let tile=0;tile<2;tile++){
      const tox=off+tile*SW;
      if(tox>W+400||tox+SW<-400) continue;

      const oy1=Math.round((H-P1H)/2);
      const oy2=Math.round((H-P2H)/2);
      const oy3=Math.round((H-P3H)/2);

      const p1x=tox+80;
      if(p1x+P1W>-200&&p1x<W+200) plan1(p1x,oy1,getProg(p1x));

      const fa=getProg(tox+710);
      northArrow(tox+720,H/2,fa);
      scaleBar(tox+748,H/2+14,fa);

      const p2x=tox+890;
      if(p2x+P2W>-200&&p2x<W+200) plan2(p2x,oy2,getProg(p2x));

      elecLegend(tox+1568,H/2-46,getProg(tox+1548));

      const p3x=tox+1730;
      if(p3x+P3W>-200&&p3x<W+200) plan3(p3x,oy3,getProg(p3x));

      wallSection(tox+2268,H/2,getProg(tox+2248));
      titleBlock(tox+2410,H/2-31,getProg(tox+2388));
    }

    g.restore();
    requestAnimationFrame(drawFrame);
  }
})();
