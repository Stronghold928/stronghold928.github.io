---
// Scrolling architectural blueprint animation — purely decorative.
// Ported from the Claude Design handoff (Stronghold Blueprint Hero.html).
// Tweaks/React panel stripped; CONFIG defaults are hardcoded for production.
---

<div class="blueprint-wrap" aria-hidden="true">
  <canvas id="blueprint-canvas"></canvas>
</div>

<style>
  .blueprint-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background-color: #fff;
    z-index: 0;
  }
  #blueprint-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script is:inline>
(function () {
  const cv = document.getElementById('blueprint-canvas');
  if (!cv) return;
  const g = cv.getContext('2d');
  let W = 0, H = 0, DPR = 1;

  function resize() {
    DPR = Math.min(window.devicePixelRatio || 1, 2);
    W = cv.clientWidth; H = cv.clientHeight;
    cv.width = Math.round(W * DPR); cv.height = Math.round(H * DPR);
  }
  window.addEventListener('resize', resize);
  function startLoop() { resize(); if (W > 0 && H > 0) { requestAnimationFrame(drawFrame); } else { requestAnimationFrame(startLoop); } }
  requestAnimationFrame(startLoop);

  const CONFIG = { speed: 38, lineW: 1, showClouds: true, showAnnotations: true, palette: ['#1a1a1a', '#585858', '#686868'] };
  let INK = '#1a1a1a', GRAY = '#585858', DIM = '#686868';
  const RED = '#be231a', REDF = 'rgba(190,35,26,0.07)', BG = '#fff';
  const SW = 2900;
  let sx = 0, lt = null;

  // ── Primitives ────────────────────────────────────────────────
  function L(x1,y1,x2,y2,lw=1,c=INK){g.save();g.beginPath();g.moveTo(x1,y1);g.lineTo(x2,y2);g.lineWidth=lw;g.strokeStyle=c;g.stroke();g.restore();}
  function Rf(x,y,w,h,c=BG){g.fillStyle=c;g.fillRect(x,y,w,h);}
  function Rs(x,y,w,h,lw,c=INK){g.save();g.strokeStyle=c;g.lineWidth=lw;g.strokeRect(x,y,w,h);g.restore();}
  function Tx(s,x,y,sz,c=DIM,al='center'){g.save();g.font=`${sz}px "Courier New",monospace`;g.fillStyle=c;g.textAlign=al;g.textBaseline='middle';g.fillText(s,x,y);g.restore();}
  function Ar(cx,cy,r,a1,a2,ccw,lw,c,dash){g.save();g.beginPath();g.arc(cx,cy,r,a1,a2,ccw);g.lineWidth=lw;g.strokeStyle=c;if(dash)g.setLineDash(dash);g.stroke();g.setLineDash([]);g.restore();}

  // ── Windows ───────────────────────────────────────────────────
  function winH(x,y,len){Rf(x,y-5,len,10);g.save();g.strokeStyle=INK;g.lineWidth=0.8;g.beginPath();g.moveTo(x,y-2.5);g.lineTo(x+len,y-2.5);g.moveTo(x,y);g.lineTo(x+len,y);g.moveTo(x,y+2.5);g.lineTo(x+len,y+2.5);g.stroke();g.restore();}
  function winV(x,y,len){Rf(x-5,y,10,len);g.save();g.strokeStyle=INK;g.lineWidth=0.8;g.beginPath();g.moveTo(x-2.5,y);g.lineTo(x-2.5,y+len);g.moveTo(x,y);g.lineTo(x,y+len);g.moveTo(x+2.5,y);g.lineTo(x+2.5,y+len);g.stroke();g.restore();}

  // ── Doors ─────────────────────────────────────────────────────
  function doorH(hx,hy,len,north,hingeLeft){
    Rf(hingeLeft?hx:hx-len,hy-5,len,10);
    const sy=north?-1:1; L(hx,hy,hx,hy+sy*len,1.5,INK);
    const a0=sy*Math.PI/2,a1=hingeLeft?0:Math.PI,ccw=north!==hingeLeft;
    Ar(hx,hy,len,a0,a1,ccw,0.75,GRAY,[3,3]);
  }
  function doorV(hx,hy,len,east,hingeTop){
    Rf(hx-5,hy,10,len);
    const sx2=east?1:-1; L(hx,hy,hx+sx2*len,hy,1.5,INK);
    const a0=east?0:Math.PI,a1=hingeTop?Math.PI/2:-Math.PI/2,ccw=!east!==!hingeTop;
    Ar(hx,hy,len,a0,a1,ccw,0.75,GRAY,[3,3]);
  }

  // ── Fixtures ──────────────────────────────────────────────────
  function light(x,y,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);g.beginPath();g.arc(x,y,7,0,Math.PI*2);g.lineWidth=0.75;g.strokeStyle=INK;g.stroke();g.beginPath();g.moveTo(x-7,y);g.lineTo(x+7,y);g.moveTo(x,y-7);g.lineTo(x,y+7);g.lineWidth=0.5;g.stroke();g.restore();}
  function outlet(x,y,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);g.beginPath();g.arc(x,y,4.5,0,Math.PI*2);g.lineWidth=0.75;g.strokeStyle=INK;g.stroke();g.beginPath();g.moveTo(x-1.5,y-3);g.lineTo(x-1.5,y-0.5);g.moveTo(x+1.5,y-3);g.lineTo(x+1.5,y-0.5);g.lineWidth=0.75;g.stroke();g.restore();}
  function swsym(x,y,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);g.beginPath();g.arc(x,y,4,0,Math.PI*2);g.lineWidth=0.75;g.strokeStyle=INK;g.stroke();L(x+4,y-6,x+4,y+6,1.2,INK);Tx('S',x,y,6,INK);g.restore();}
  function smoke(x,y,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);g.beginPath();g.arc(x,y,5,0,Math.PI*2);g.lineWidth=0.75;g.strokeStyle=INK;g.stroke();g.beginPath();g.arc(x,y,2.5,0,Math.PI*2);g.stroke();g.restore();}
  function toilet(x,y,rot,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);g.translate(x,y);g.rotate(rot);Rs(-9,-19,18,10,1);g.beginPath();g.ellipse(0,5,8.5,12,0,0,Math.PI*2);g.lineWidth=1;g.strokeStyle=INK;g.stroke();g.restore();}
  function lav(x,y,w,h,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);Rs(x,y,w,h,1);g.beginPath();g.ellipse(x+w/2,y+h/2,w/2-3,h/2-3,0,0,Math.PI*2);g.lineWidth=0.75;g.strokeStyle=INK;g.stroke();g.restore();}
  function tub(x,y,w,h,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);Rs(x,y,w,h,1);g.beginPath();g.ellipse(x+w/2,y+h*.57,w/2-5,h*.3,0,0,Math.PI*2);g.lineWidth=0.75;g.strokeStyle=INK;g.stroke();L(x+w*.25,y+6,x+w*.75,y+6,1,INK);g.restore();}
  function stove(x,y,w,h,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);Rs(x,y,w,h,1);const r=Math.min(w,h)*.16;[[.28,.28],[.72,.28],[.28,.72],[.72,.72]].forEach(([fx,fy])=>{g.beginPath();g.arc(x+w*fx,y+h*fy,r,0,Math.PI*2);g.strokeStyle=INK;g.lineWidth=0.75;g.stroke();g.beginPath();g.arc(x+w*fx,y+h*fy,r*.4,0,Math.PI*2);g.stroke();});g.restore();}
  function fridge(x,y,w,h,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);Rs(x,y,w,h,1);L(x,y+h*.32,x+w,y+h*.32,.7,DIM);g.restore();}
  function stair(x,y,w,h,n,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);Rs(x,y,w,h,.75,DIM);const s=h/n;for(let i=1;i<n;i++)L(x,y+i*s,x+w,y+i*s,.45,DIM);const ax=x+w/2;L(ax,y+h*.82,ax,y+h*.18,1,DIM);L(ax-5,y+h*.28,ax,y+h*.18,1,DIM);L(ax+5,y+h*.28,ax,y+h*.18,1,DIM);Tx('UP',ax,y+h*.6,7,DIM);g.restore();}

  // ── Furniture ─────────────────────────────────────────────────
  function sofa(x,y,w,h,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*.9);Rs(x,y,w,h,.5,DIM);Rs(x,y,w,h*.28,.4,DIM);L(x+w/2,y+h*.28,x+w/2,y+h,.4,DIM);g.restore();}
  function diningSet(x,y,w,h,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*.8);Rs(x,y,w,h,.5,DIM);[[x-11,y+h*.15],[x-11,y+h*.6],[x+w,y+h*.15],[x+w,y+h*.6]].forEach(([cx,cy])=>Rs(cx,cy,11,h*.22,.4,DIM));g.restore();}
  function bed(x,y,w,h,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*.85);Rs(x,y,w,h,.5,DIM);Rs(x,y,w,h*.2,.4,DIM);g.beginPath();g.ellipse(x+w/2,y+h*.6,w*.3,h*.24,0,0,Math.PI*2);g.lineWidth=.4;g.strokeStyle=DIM;g.stroke();g.restore();}

  // ── Dimensions ────────────────────────────────────────────────
  function dimH(x1,x2,y,lbl,p,off=14){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*1.5);g.strokeStyle=DIM;g.lineWidth=.75;g.beginPath();g.moveTo(x1,y+3);g.lineTo(x1,y-off-3);g.moveTo(x2,y+3);g.lineTo(x2,y-off-3);g.stroke();const xe=x1+(x2-x1)*Math.min(1,p*1.1);L(x1,y-off,xe,y-off,.75,DIM);if(p>.84){L(x1,y-off-2,x1+7,y-off+2,.75,DIM);L(x2-7,y-off-2,x2,y-off+2,.75,DIM);}if(p>.92){g.save();g.globalAlpha=(p-.92)*13;Tx(lbl,(x1+x2)/2,y-off-9,7.5,DIM);g.restore();}g.restore();}
  function dimV(x,y1,y2,lbl,p,off=14){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*1.5);g.strokeStyle=DIM;g.lineWidth=.75;g.beginPath();g.moveTo(x+3,y1);g.lineTo(x-off-3,y1);g.moveTo(x+3,y2);g.lineTo(x-off-3,y2);g.stroke();const ye=y1+(y2-y1)*Math.min(1,p*1.1);L(x-off,y1,x-off,ye,.75,DIM);if(p>.84){L(x-off-2,y1,x-off+2,y1+7,.75,DIM);L(x-off+2,y2-7,x-off-2,y2,.75,DIM);}if(p>.92){g.save();g.globalAlpha=(p-.92)*13;g.translate(x-off-9,(y1+y2)/2);g.rotate(-Math.PI/2);Tx(lbl,0,0,7.5,DIM);g.restore();}g.restore();}
  function rlabel(lines,x,y,p){if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*3.5);lines.forEach((s,i)=>Tx(s,x,y+i*10,8,GRAY));g.restore();}

  // ── Revision cloud ────────────────────────────────────────────
  function revCloud(x,y,w,h,p,tag){
    if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p);
    const r=7;
    function seg(x1,y1,x2,y2,n){const dx=x2-x1,dy=y2-y1,len=Math.sqrt(dx*dx+dy*dy),nx=dy/len*r,ny=-dx/len*r;for(let i=0;i<n;i++){const tm=(2*i+1)/(2*n);g.quadraticCurveTo(x1+dx*tm+nx,y1+dy*tm+ny,x1+dx*(i+1)/n,y1+dy*(i+1)/n);}}
    const nh=Math.max(3,Math.round(w/19)),nv=Math.max(2,Math.round(h/19));
    g.beginPath();g.moveTo(x,y);seg(x,y,x+w,y,nh);seg(x+w,y,x+w,y+h,nv);seg(x+w,y+h,x,y+h,nh);seg(x,y+h,x,y,nv);g.closePath();
    g.fillStyle=REDF;g.fill();g.strokeStyle=RED;g.lineWidth=1.5;g.stroke();
    if(p>.8&&tag){g.save();g.globalAlpha=(p-.8)*5;Tx(tag,x+w/2,y-9,6.5,RED);g.restore();}
    g.restore();
  }

  // ── Red handwriting + markup ──────────────────────────────────
  function handNote(lines,x,y,p,angle=0){
    if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);
    g.translate(x,y);if(angle)g.rotate(angle);
    g.font="600 12px 'Caveat',cursive";g.fillStyle=RED;g.textAlign='left';g.textBaseline='top';
    lines.forEach((line,i)=>g.fillText(line,0,i*15));
    g.restore();
  }
  function redArrow(x1,y1,x2,y2,p){
    if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);
    L(x1,y1,x2,y2,1,RED);
    const a=Math.atan2(y2-y1,x2-x1);
    g.beginPath();g.moveTo(x2,y2);g.lineTo(x2-8*Math.cos(a-.38),y2-8*Math.sin(a-.38));g.moveTo(x2,y2);g.lineTo(x2-8*Math.cos(a+.38),y2-8*Math.sin(a+.38));
    g.strokeStyle=RED;g.lineWidth=1;g.stroke();g.restore();
  }
  function revDelta(cx,cy,num,p){
    if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*2);
    g.beginPath();g.moveTo(cx,cy-9);g.lineTo(cx-7.5,cy+4);g.lineTo(cx+7.5,cy+4);g.closePath();
    g.fillStyle=RED;g.fill();
    g.font='bold 7px "Courier New",monospace';g.fillStyle='#fff';g.textAlign='center';g.textBaseline='middle';g.fillText(String(num),cx,cy+1);
    g.restore();
  }
  function sectionLine(x1,y1,x2,y2,label,p){
    if(p<=0)return;g.save();g.globalAlpha=Math.min(1,p*1.5);
    g.setLineDash([6,3]);L(x1,y1,x2,y2,.7,DIM);g.setLineDash([]);
    [[x1,y1],[x2,y2]].forEach(([cx,cy])=>{g.beginPath();g.arc(cx,cy,10,0,Math.PI*2);g.strokeStyle=DIM;g.lineWidth=.65;g.stroke();Tx(label,cx,cy,7,DIM);});
    g.restore();
  }

  // ── Structural column grid ────────────────────────────────────
  function colGrid(ox,oy,planH,xs,labels){
    g.save();g.globalAlpha=.65;
    xs.forEach((cx,i)=>{
      g.setLineDash([5,3,1,3]);g.strokeStyle='#b4c0cc';g.lineWidth=.5;
      g.beginPath();g.moveTo(ox+cx,oy-34);g.lineTo(ox+cx,oy+planH+20);g.stroke();g.setLineDash([]);
      g.beginPath();g.arc(ox+cx,oy-22,10,0,Math.PI*2);g.strokeStyle='#8a9cb0';g.lineWidth=.65;g.stroke();
      Tx(labels[i],ox+cx,oy-22,7.5,'#607080');
    });
    g.restore();
  }

  // ── Progress ──────────────────────────────────────────────────
  function getProg(screenX){const st=W*.9,en=W*.08;if(screenX>st)return 0;if(screenX<en)return 1;return(st-screenX)/(st-en);}

  // ═════════════════════════════════════════════════════════════
  // PLAN 1 — Colonial First Floor  560 × 270
  // ═════════════════════════════════════════════════════════════
  const P1W=560,P1H=270;
  function plan1(ox,oy,p){
    const ap=CONFIG.showAnnotations?p:0,cp=CONFIG.showClouds?p:0;
    Rf(ox,oy,P1W,P1H,INK);
    Rf(ox+5,oy+5,145,260);
    Rf(ox+154,oy+5,68,127);
    Rf(ox+226,oy+5,120,127);
    Rf(ox+350,oy+5,120,127);
    Rf(ox+474,oy+5,81,127);
    Rf(ox+154,oy+136,68,129);
    Rf(ox+226,oy+136,240,129);
    Rf(ox+470,oy+136,85,129);
    colGrid(ox,oy,P1H,[0,150,226,350,474,560],['A','B','C','D','E','F']);
    sectionLine(ox-12,oy+95,ox+P1W+12,oy+95,'1',ap);
    L(ox+228,oy+248,ox+464,oy+248,1.8,INK);
    L(ox+462,oy+138,ox+462,oy+265,1.8,INK);
    stove(ox+418,oy+208,40,42,ap);
    fridge(ox+420,oy+155,28,42,ap);
    lav(ox+272,oy+249,46,15,ap);
    g.save();g.globalAlpha=Math.min(1,ap*2);Rs(ox+320,oy+249,30,15,.75);Tx('DW',ox+335,oy+256.5,6,DIM);g.restore();
    Rs(ox+282,oy+185,96,40,1.5);
    Tx("ISLAND",ox+330,oy+205,6.5,DIM);
    stair(ox+473,oy+140,76,52,9,ap);
    Rf(ox+470,oy+206,4,59,INK);
    Rf(ox+474,oy+206,80,59);
    toilet(ox+538,oy+225,0,ap);
    lav(ox+480,oy+248,28,16,ap);
    sofa(ox+234,oy+145,100,40,ap);
    diningSet(ox+362,oy+25,84,62,ap);
    sofa(ox+232,oy+10,104,40,ap);
    winH(ox+246,oy+5,60);winH(ox+368,oy+5,58);winH(ox+488,oy+5,48);
    winV(ox+P1W-5,oy+22,50);winV(ox+P1W-5,oy+148,44);
    winH(ox+258,oy+P1H-5,80);winH(ox+412,oy+P1H-5,48);
    winV(ox+5,oy+48,58);
    Rf(ox+22,oy+P1H-5,114,5);
    L(ox+22,oy+P1H,ox+22,oy+P1H-8,.75,INK);L(ox+136,oy+P1H,ox+136,oy+P1H-8,.75,INK);
    doorH(ox+168,oy+P1H,34,true,true);
    doorV(ox+226,oy+60,30,true,true);
    Rf(ox+346,oy+35,4,65);
    doorV(ox+470,oy+52,30,true,true);
    doorH(ox+160,oy+136,30,false,true);
    doorV(ox+150,oy+178,28,false,false);
    doorH(ox+474,oy+206,30,false,true);
    rlabel(['GARAGE'],ox+78,oy+130,ap);
    rlabel(['ENTRY /','FOYER'],ox+188,oy+65,ap);
    rlabel(['LIVING ROOM'],ox+286,oy+68,ap);
    rlabel(['DINING ROOM'],ox+410,oy+68,ap);
    rlabel(['STUDY /','OFFICE'],ox+514,oy+68,ap);
    rlabel(['MUD /','LAUNDRY'],ox+188,oy+200,ap);
    rlabel(['FAMILY ROOM'],ox+274,oy+195,ap);
    rlabel(['KITCHEN'],ox+388,oy+195,ap);
    rlabel(['BACK HALL /','POWDER'],ox+513,oy+185,ap);
    light(ox+78,oy+128,ap);light(ox+188,oy+65,ap);light(ox+286,oy+65,ap);
    light(ox+410,oy+65,ap);light(ox+514,oy+65,ap);light(ox+274,oy+195,ap);light(ox+388,oy+195,ap);
    outlet(ox+238,oy+127,ap);outlet(ox+362,oy+127,ap);outlet(ox+478,oy+127,ap);
    outlet(ox+233,oy+140,ap);outlet(ox+463,oy+260,ap);
    swsym(ox+214,oy+123,ap);swsym(ox+340,oy+123,ap);
    smoke(ox+286,oy+18,ap);smoke(ox+340,oy+150,ap);
    dimH(ox,ox+P1W,oy,"56'-0\"",ap);
    dimV(ox,oy,oy+P1H,"54'-0\"",ap);
    g.save();g.globalAlpha=Math.min(1,ap*1.2);g.strokeStyle=DIM;g.lineWidth=.65;
    g.beginPath();g.moveTo(ox,oy-28);g.lineTo(ox+150,oy-28);g.stroke();
    Tx("30'-0\"",ox+75,oy-35,6.5,DIM);
    g.restore();
    revCloud(ox+350,oy+5,124,127,cp);
    revDelta(ox+440,oy+13,1,cp);
    handNote(["VERIFY WINDOW TYPE w/ owner","confirm casement vs. fixed glass","→ see submittal log 18"],ox+354,oy+16,cp);
    revCloud(ox+226,oy+136,240,129,cp);
    revDelta(ox+332,oy+140,2,cp);
    handNote(["ADD ISLAND per SK-03","hood vent above range—see mech.","owner wants pot-filler too"],ox+230,oy+143,cp);
    redArrow(ox+82,oy+P1H+12,ox+68,oy+P1H-3,cp);
    handNote(["2-car door = 16'-0\" RO"],ox+86,oy+P1H+8,cp);
  }

  // ═════════════════════════════════════════════════════════════
  // PLAN 2 — Ranch / Craftsman  610 × 192
  // ═════════════════════════════════════════════════════════════
  const P2W=610,P2H=192;
  function plan2(ox,oy,p){
    const ap=CONFIG.showAnnotations?p:0,cp=CONFIG.showClouds?p:0;
    Rf(ox,oy,P2W,P2H,INK);
    Rf(ox+5,oy+5,168,182);
    Rf(ox+177,oy+5,162,182);
    Rf(ox+343,oy+5,138,100);
    Rf(ox+343,oy+109,138,78);
    Rf(ox+485,oy+5,120,100);
    Rf(ox+485,oy+109,120,78);
    colGrid(ox,oy,P2H,[0,177,343,485,610],['A','B','C','D','E']);
    sectionLine(ox-12,oy+96,ox+P2W+12,oy+96,'2',ap);
    L(ox+179,oy+170,ox+320,oy+170,1.8,INK);
    L(ox+318,oy+109,ox+318,oy+187,1.8,INK);
    stove(ox+258,oy+167,38,18,ap);
    fridge(ox+298,oy+158,24,30,ap);
    lav(ox+188,oy+171,36,15,ap);
    Rs(ox+210,oy+100,100,38,1.5);
    Tx("ISLAND",ox+260,oy+119,7,DIM);
    tub(ox+347,oy+112,60,44,ap);
    toilet(ox+415,oy+155,0,ap);
    lav(ox+350,oy+165,28,18,ap);
    lav(ox+488,oy+115,24,18,ap);
    toilet(ox+527,oy+115,Math.PI/2,ap);
    bed(ox+350,oy+18,110,75,ap);
    bed(ox+492,oy+18,100,70,ap);
    sofa(ox+184,oy+18,130,42,ap);
    winH(ox+202,oy+5,70);winH(ox+358,oy+5,65);winH(ox+498,oy+5,60);
    winV(ox+5,oy+25,60);winV(ox+P2W-5,oy+20,60);
